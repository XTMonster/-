{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "blockdirector://blockout/report/v1",
  "title": "Blockout Report v1",
  "description": "粗排自检报告：数值结论（比例/构图/遮挡/出入画/空墙/diff）与视觉证据索引。",
  "type": "object",
  "required": [
    "schema_version", "manifest_fingerprint", "verdict", "findings",
    "checks", "notes"
  ],
  "properties": {
    "schema_version": { "const": "blockout-report/v1" },
    "manifest_fingerprint": { "type": "string" },
    "verdict": { "enum": ["pass", "fail", "review"] },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["check_id", "severity", "message"],
        "properties": {
          "check_id": { "type": "string" },
          "severity": { "enum": ["info", "warning", "error"] },
          "message": { "type": "string" },
          "shot_id": { "type": ["string", "null"] },
          "frame": { "type": ["integer", "null"] }
        },
        "additionalProperties": true
      }
    },
    "checks": { "type": "array" },
    "notes": { "type": "array", "items": { "type": "string" } }
  },
  "additionalProperties": true
}
