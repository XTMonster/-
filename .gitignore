# Python
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
*.egg-info/

# Blender / BlockDirector runtime artifacts
*.blend1
*.blend2
*.blend@
# NOTE: leading slashes are required. A bare ``export/`` matches at ANY depth
# and silently swallows ``docs/evidence/<run-id>/export/`` (v1.4 S13/§4.4).
/export/

# Per-run output (regenerated on every headless/export run)
# Per-run output (regenerated on every headless/export run). Leading slashes
# again: ``runs/`` would ignore ``<out>/runs/audit_log.jsonl`` used as evidence.
/runs/
/exports/

# Acceptance evidence must be committable (v1.4 S13). Place this AFTER the
# ignores above so it re-includes nested directories such as
# docs/evidence/<run-id>/runs/audit_log.jsonl.
!docs/evidence/**
!docs/evidence/**/

# ...but the *regenerable media* inside an evidence run stays out of git (same
# policy as tools/_probe_out above): a 64-shot acceptance run is >10 MB of mp4
# plus 64 PNGs, and re-running the command reproduces them byte-for-byte.
docs/evidence/**/*.mp4
docs/evidence/**/first_frames/

# Probe / audit output.
# The JSON reports are committed (they are evidence referenced by the docs);
# the regenerable media is not.
tools/_probe_out/**/*.png
tools/_probe_out/**/*.jpg
tools/_probe_out/**/*.mp4
tools/_probe_out/seq/

# OS
Thumbs.db
.DS_Store

# P14-1 语料采集的中间产物与原文快照（执行文档 v1.4 §2.3c/§2.3d 的体积门）：
# 入库的是「知识 ＋ 短引用 ＋ 出处」，不是原文长段落，因此原文缓存一律不入库，
# 只保留 `source_ref.sha256` 供校验。管线可用 `python -m tools.kb_fetch.fetch`
# 从 `knowledge/sources.yaml` 原样重建。
/work/
