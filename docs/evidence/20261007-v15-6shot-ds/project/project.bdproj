          "rule_justifications": [
            {
              "rule": "INTENT_PACK: intent:揭示 shot_size:CU movement:dolly_in",
              "action": "follow",
              "reason": "本镜意图为建立米迦尔性格并引出战斗，用 CU 近景加 dolly_in 推近，把注意力锁在角色的自信神态上，与'揭示'型意图一致。"
            },
            {
              "rule": "SHOT_PATTERN: shot_size:MS lens:50mm movement:zoom_in headroom_policy:cinematic 禁={shot_size:CU}",
              "action": "break",
              "reason": "该模式禁止 CU，但本镜叙事核心是米迦尔说出台词瞬间的面部自信与眼神，中景无法承载这一情绪强度；计划本身已定 CU，故按更具体的意图包执行，保留 cinematic 头部留白策略作为补偿。",
              "precedent": "case_rules-of-shot-composition-in-film_044"
            },
            {
              "rule": "SHOT_PATTERN: shot_size:MS lens:35mm movement:固定 headroom_policy:cinematic 禁={movement:dolly_in}",
              "action": "break",
              "reason": "该模式要求固定机位并禁 dolly_in，但本镜需要随台词推进逐步收紧景别、把观众带入角色的决心，静止机位会削弱由静到动的战斗前奏。",
              "precedent": "case_what-is-an-eyeline-match_025"
            }
          ],
          "prompt": "午后码头市场的近景。米迦尔位于画面左侧，面向画面右方，暖侧光从右后方擦过他的侧脸，草垛与帆布篷摊位在他身后虚化成一片暖黄。伊恩以过肩背影留在画面右侧边缘，只见肩线与后脑，不越过二人连线。镜头从米迦尔一侧切入，缓慢推近，米迦尔的视线越过伊恩的肩头投向画外，语气自信，说完后微微扬起下巴，眼神里带着跃跃欲试的兴奋。远处码头海面泛着细碎的反光，风吹草影轻晃，为静态的对话注入呼吸感。"
        },
