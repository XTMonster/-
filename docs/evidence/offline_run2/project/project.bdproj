          "actions": [],
          "dialogues": [
            {
              "character_id": "",
              "speaker_raw": "米迦尔",
              "speaker_status": "unresolved",
              "text": "我先上船。",
              "start_frame": 0,
              "end_frame": 0
            },
            {
              "character_id": "",
              "speaker_raw": "伊恩",
              "speaker_status": "unresolved",
              "text": "等等我。",
              "start_frame": 0,
              "end_frame": 0
            },
            {
              "character_id": "",
              "speaker_raw": "米迦尔",
              "speaker_status": "unresolved",
              "text": "别拖了。",
              "start_frame": 0,
              "end_frame": 0
            },
            {
              "character_id": "",
              "speaker_raw": "伊恩",
              "speaker_status": "unresolved",
              "text": "这一次我听你的。",
              "start_frame": 0,
              "end_frame": 0
            },
            {
              "character_id": "",
              "speaker_raw": "米迦尔",
              "speaker_status": "unresolved",
              "text": "走吧。",
              "start_frame": 0,
              "end_frame": 0
            },
            {
              "character_id": "",
              "speaker_raw": "伊恩",
              "speaker_status": "unresolved",
              "text": "照顾好自己。",
              "start_frame": 0,
              "end_frame": 0
            },
            {
              "character_id": "",
              "speaker_raw": "米迦尔",
              "speaker_status": "unresolved",
              "text": "你也是。",
              "start_frame": 0,
              "end_frame": 0
            },
            {
              "character_id": "",
              "speaker_raw": "伊恩",
              "speaker_status": "unresolved",
              "text": "再见。",
              "start_frame": 0,
              "end_frame": 0
            },
            {
              "character_id": "",
              "speaker_raw": "米迦尔",
              "speaker_status": "unresolved",
              "text": "再见。",
              "start_frame": 0,
              "end_frame": 0
            },
            {
              "character_id": "",
              "speaker_raw": "伊恩",
              "speaker_status": "unresolved",
              "text": "船要开了。",
              "start_frame": 0,
              "end_frame": 0
            }
