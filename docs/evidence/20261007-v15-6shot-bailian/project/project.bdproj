              "precedent": "AXIS_RULE pair=any_two axis_side=neutral axis_topic=越轴"
            },
            {
              "rule": "cine_static_contrast",
              "action": "follow",
              "reason": "把固定镜头留给铺垫：本镜完全静止，紧接的镜5（跟拍+魔法生效）才第一次出现明显运动，观众会把它读成「事情开始了」。",
              "precedent": "cine_static_contrast"
            },
            {
              "rule": "SHOT_PATTERN",
              "action": "follow",
              "reason": "该 pattern 禁的是「MS + 50mm + zoom_in」组合里出现 CU；本镜是 CU + 85mm + 固定（无 zoom_in），不落入被禁组合，长焦只用于压缩手部特写的背景散景。",
              "precedent": "SHOT_PATTERN shot_size=MS lens=50mm movement=zoom_in"
            },
            {
              "rule": "gen_perf_0351",
              "action": "follow",
              "reason": "用「指尖相抵→覆手背→骤然握拳」这组递进的手部微动作做性格与情节铺垫：自信、爱炫、带点顽皮的施法前仪式，比直接出魔法更能立住米迦尔。",
              "precedent": "gen_perf_0351"
            }
          ],
          "prompt": "手部特写（CU，144 帧，固定机位）。机位保持在米迦尔轴线同侧的前右方（front_right），镜头以约 35° 俯角压向他胸前的双手，85mm 长焦压缩空间、浅景深，背景的帆布篷与市集摊位、堆叠的木箱与货袋、随风摆动的草丛与散落干全部虚化成午后暖色散景块。米迦尔身体朝向画右（银幕方向与镜3一致，不越轴），画面里只有他的双手与小段前臂为主体：双手自体侧缓缓抬到胸前、指尖相抵（掌心朝上），接着右手覆上左手背、指节一节节收紧，随后五指骤然收拢成拳，拳心透出一小团微光——魔法尚未释放，只做「即将出现」的暗示；期间他的视线自手背抬起扫向画右远处的偷盗者逃跑路线，上身微微前倾把重心压向画右，台词收尾时轻轻点头。双手始终落在画左三分位，画右留出负空间（lead room）指向逃跑路线，形成「手在此处、目标在彼处」的张力。午后暖侧光自画右上方打来，手背有明确高光、掌心有柔和投影。全程无任何摄影机运动：这一镜是铺垫，把第一次运动留给下一镜魔法生效的转折。台词逐字：「放心吧。」（第1–24帧）、「看我怎么惩罚他，让他砰的一声，嘻嘻。」（第36–131帧）。"
        },
