ve": "static", "intent_type": "压迫", "dialogue_pins": [], "beats": [{"t": 0.1, "subject": "伊恩", "verb": "look_at", "target": "米迦尔与伊恩的站位", "face_to": "screen_left", "pace": "slow"}, {"t": 0.35, "subject": "伊恩", "verb": "body_tilt", "target": "米迦尔与伊恩的站位", "face_to": "screen_left", "pace": "slow", "react": "被'别拖了'顶住，肩线微微后撤"}, {"t": 0.6, "subject": "伊恩", "verb": "shake_head", "target": "米迦尔与伊恩的站位", "face_to": "screen_left", "pace": "slow"}, {"t": 0.85, "subject": "伊恩", "verb": "look_at", "target": "米迦尔与伊恩的站位", "face_to": "screen_left", "pace": "slow", "react": "眼神重新钉住对方，冲突升到顶点"}], "composition": {"rule": "lead_room", "subject_position": "right_third"}, "rule_justifications": [{"rule": "SHOT_PATTERN", "action": "break", "reason": "计划明确要求景别由 MS 跳至 CU，用特写把冲突压到伊恩脸上；若仍守 MS 则本镜的叙事意图（冲突升级落在脸上）无法成立。", "precedent": "case_what-is-an-eyeline-match_022"}, {"rule": "INTENT_PACK", "action": "follow", "reason": "本镜意图为冲突升级的压迫感，采用 CU + 缓慢 zoom_in，符合'压迫'类镜头通常做法。"}, {"rule": "AXIS_RULE", "action": "follow", "reason": "机位保持在 A 侧，伊恩视线朝画面左侧，与前一镜 MS 的轴线一致，固定机位不越轴。"}]}, {"shot_id": "shot_039", "order": 15, "intent": "米迦尔的反应，短促定格", "shot_type": "CU", "duration_frames": 48, "characters": ["米迦尔"], "dialogue_ids": [], "actions": [], "dialogues": [], "prompt": "米迦尔头部特写，位于画面左侧，微微别开视线，表情绷紧", "camera": {}, "axis_note": "反向机位在 A 侧，米迦尔视线朝画面右侧", "continuity_in": "与上一镜成对切，机位角度变化大于 30°", "gaze": [{"from": "米迦尔", "to": "伊恩"}, {"from": "伊恩", "to": "米迦尔"}], "vfx": [], "declared_duration_frames": 0, "declared_shot_number": 39, "declared_camera_move": "static", "intent_type": "停顿", "dialogue_pins": [], "beats": [], "composition": {}, "rule_justifications": []}, {"shot_id": "shot_040", "order": 16, "intent": "段落收束，两人重新落入环境", "shot_type": "MLS", "duration_frames": 72, "characters": ["米迦尔", "伊恩"], "dialogue_ids": [], "actions": [], "dialogues": [], "prompt": "中远景双人，两人站在码头边不再言语，海面在身后铺开", "camera": {}, "axis_note": "机位退回主轴 A 侧，保持左右关系", "continuity_in": "景别放宽两档，段落松手", "gaze": [{"from": "米迦尔", "to": "伊恩"}, {"from": "伊恩", "to": "米迦尔"}], "vfx": [], "declared_duration_frames": 0, "declared_shot_number": 40, "declared_camera_move": "static", "intent_type": "收束", "dialogue_pins": [], "beats": [], "composition": {}, "rule_justifications": []}, {"shot_id": "shot_041", "order": 17, "intent": "建立氛围，转入夜谈前的空间", "shot_type": "LS", "duration_frames": 72, "characters": ["米迦尔"], "dialogue_ids": [], "actions": [], "dialogues": [], "prompt": "全景，夜。第十四街区码头市场通道，摊位长桌与货箱的剪影沿通道排开，远处港口水面与桅杆在夜色中隐约可见。米迦尔独自站在画面左侧三分之一处，侧身朝向画面右侧的港口水面，随后缓缓转头望向码头市场通道深处。固定机位，50mm，机位在主轴 A 侧、米迦尔右前方，不越轴。光线由午后余温转为夜色的冷调，安静、留白，为夜谈铺垫空间。", "camera": {"side": "front_right", "lens": 50}, "axis_note": "机位仍在主轴 A 侧，米迦尔位于画面左侧", "continuity_in": "由双人中远景切至全景，时间由午后转夜", "gaze": [{"from": "米迦尔", "to": "伊恩"}, {"from": "伊恩", "to": "米迦尔"}], "vfx": [], "declared_duration_frames": 0, "declared_shot_number": 41, "declared_camera_move": "static", "intent_type": "铺垫", "dialogue_pins": [], "beats": [{"t": 0.0, "subject": "米迦尔", "verb": "look_at", "target": "港口水面与桅杆", "face_to": "screen_right", "pace": "slow"}, {"t": 0.6, "subject": "米迦尔", "verb": "turn_head", "target": "第十四街区码头市场通道", "face_to": "away", "pace": "slow"}], "composition": {"rule": "thirds", "subject_position": "left_third"}, "rule_justifications": [{"rule": "AXIS_RULE", "action": "follow", "reason": "机位保持在主轴 A 侧（front_right），米迦尔位于画面左侧，与前后镜不越轴。"}, {"rule": "INTENT_PACK", "action": "follow", "reason": "intent:铺垫 + LS + 固定机位，本镜用固定全景铺垫夜谈前的空间。"}, {"rule": "cine_static_contrast", "action": "follow", "reason": "按卡片建议，把固定镜头留给铺垫，运动留给转折；本镜是夜谈前的静止参照系。"}]}, {"shot_id": "shot_042", "order": 18, "intent": "推进对话，两人并坐", "shot_type": "MS", "duration_frames": 96, "characters": ["米迦尔", "伊恩"], "dialogue_ids": [], "actions": [{"character_id": "米迦尔", "action_type": "stand", "start_frame": 1, "end_frame": 12, "params": {"drop": 0}}, {"character_id": "伊恩", "action_type": "stand", "start_frame": 1, "end_frame": 12, "params": {"drop": 0}}, {"character_id": "米迦尔", "action_type": "turn_body", "start_frame": 13, "end_frame": 30, "params": {"angle_deg": 90}}, {"character_id": "伊恩", "action_type": "turn_body", "start_frame": 13, "end_frame": 30, "params": {"angle_deg": -90}}, {"character_id": "米迦尔", "action_type": "walk_to", "start_frame": 31, "end_frame": 60, "target_position": [-1.5, 2.0, 0], "params": {"speed": "walk"}}, {"character_id": "伊恩", "action_type": "walk_to", "start_frame": 31, "end_frame": 60, "target_position": [1.5, 2.0, 0], "params": {"speed": "walk"}}], "dialogues": [{"character_id": "米迦尔", "text": "我先上船。", "start_frame": 1, "end_frame": 39}, {"character_id": "伊恩", "text": "等等我。", "start_frame": 51, "end_frame": 81}], "prompt": "中景，35mm，固定机位，机位在主轴 A 侧，米迦尔居画面左、伊恩居画面右，两人并坐在第十四街区码头市场通道的摊位长桌与货箱旁，背景是港口水面与桅杆。米迦尔先转头看向伊恩说话，伊恩点头回应，随后米迦尔起身离开画面，伊恩留在原处望向船的方向。午后硬光，浅景深。", "camera": {"side": "front_left", "lens": 50}, "axis_note": "机位在主轴 A 侧，两人分居画面左右", "continuity_in": "由全景切入中景，景别变化一档以上", "gaze": [{"from": "米迦尔", "to": "伊恩"}, {"from": "伊恩", "to": "米迦尔"}], "vfx": [], "declared_duration_frames": 0, "declared_shot_number": 42, "declared_camera_move": "static", "intent_type": "推进", "dialogue_pins": [], "beats": [{"t": 0.05, "subject": "米迦尔", "verb": "turn_head", "target": "伊恩", "face_to": "screen_right", "pace": "slow"}, {"t": 0.2, "subject": "米迦尔", "verb": "look_at", "target": "伊恩", "face_to": "screen_right", "pace": "normal"}, {"t": 0.45, "subject": "伊恩", "verb": "nod", "target": "米迦尔", "face_to": "screen_left", "pace": "slow"}, {"t": 0.7, "subject": "米迦尔", "verb": "stand", "target": "米迦尔与伊恩的站位", "pace": "normal"}, {"t": 0.85, "subject": "伊恩", "verb": "look_at", "target": "港口水面与桅杆", "face_to": "screen_left", "pace": "slow"}], "composition": {"rule": "thirds", "subject_position": "left_third"}, "rule_justifications": [{"rule": "shot_size=shot_size:MS lens=lens:35mm movement=movement:push_through headroom_policy=cinematic 禁={movement:orbit_cw}", "action": "follow"}, {"rule": "intent=intent:推进 shot_size=shot_size:MS movement=push_through", "action": "follow"}, {"rule": "pair=any_two axis_side=neutral axis_topic=越轴 禁={movement:固定}", "action": "break", "reason": "本镜两人并坐、机位在主轴 A 侧且台词是并肩告别的低声对话，固定机位让两人同框关系保持稳定，任何横向越轴移动都会破坏并坐的空间关系；此处有意保持固定，仅做极缓的推近以推进情绪。", "precedent": "case_two-shot-camera-angle-movement_032"}]}, {"shot_id": "shot_043", "order": 19, "intent": "伊恩说起往事，推进对话", "shot_type": "MCU", "duration_frames": 72, "characters": ["伊恩"], "dialogue_ids": [], "actions": [], "dialogues": [], "prompt": "伊恩胸上景，位于画面右侧，侧光勾勒面部，视线朝画面左下", "camera": {}, "axis_note": "过肩机位在 A 侧，伊恩视线朝画面左侧", "continuity_in": "景别由 MS 收紧至 MCU", "gaze": [{"from": "米迦尔", "to": "伊恩"}, {"from": "伊恩", "to": "米迦尔"}], "vfx": [], "declared_duration_frames": 0, "declared_shot_number": 43, "declared_camera_move": "static", "intent_type": "推进", "dialogue_pins": [], "beats": [], "composition": {}, "rule_justifications": []}, {"shot_id": "shot_044", "order": 20, "intent": "米迦尔听着，给出反应", "shot_type": "MCU", "duration_frames": 72, "characters": ["米迦尔"], "dialogue_ids": [], "actions": [], "dialogues": [], "prompt": "米迦尔胸上景，位于画面左侧，安静聆听，视线朝画面右侧", "camera": {}, "axis_note": "反向过肩机位在 A 侧，米迦尔视线朝画面右侧", "continuity_in": "与上一镜成对切，机位角度变化大于 30°", "gaze": [{"from": "米迦尔", "to": "伊恩"}, {"from": "伊恩", "to": "米迦尔"}], "vfx": [], "declared_duration_frames": 0, "declared_shot_number": 44, "declared_camera_move": "static", "intent_type": "停顿", "dialogue_pins": [], "beats": [], "composition": {}, "rule_justifications": []}, {"shot_id": "shot_045", "order": 21, "intent": "留白，两人沉默", "shot_type": "MS", "duration_frames": 72, "characters": ["米迦尔", "伊恩"], "dialogue_ids": [], "actions": [], "dialogues": [], "prompt": "中景双人固定机位，主轴 A 侧、平视，米迦尔在画面左三分之一、伊恩在右，左右关系与前序镜头一致。第十四街区码头市场通道，摊位长桌与货箱在两人身后形成前景层次，远处港口水面与桅杆作为纵深留白。午后侧光。两人沉默，只做极缓慢的转头：米迦尔先看向伊恩，伊恩回望，随后两人先后把视线移向远处水面。镜头几乎静止，仅保留极轻微手持呼吸感，节奏放缓，情绪落在沉默与留白上。", "camera": {"side": "front_left", "lens": 50}, "axis_note": "回到主轴 A 侧双人机位，左右关系不变", "continuity_in": "景别放宽一档，节奏放缓", "gaze": [{"from": "米迦尔", "to": "伊恩"}, {"from": "伊恩", "to": "米迦尔"}, {"from": "米迦尔", "to": "港口水面与桅杆"}, {"from": "伊恩", "to": "港口水面与桅杆"}], "vfx": [], "declared_duration_frames": 0, "declared_shot_number": 45, "declared_camera_move": "static", "intent_type": "留白", "dialogue_pins": [], "beats": [{"t": 0.1, "subject": "米迦尔", "verb": "turn_head", "target": "伊恩", "face_to": "screen_right", "pace": "slow"}, {"t": 0.35, "subject": "伊恩", "verb": "turn_head", "target": "米迦尔", "face_to": "screen_left", "pace": "slow"}, {"t": 0.6, "subject": "米迦尔", "verb": "turn_head", "target": "港口水面与桅杆", "face_to": "away", "pace": "slow"}, {"t": 0.85, "subject": "伊恩", "verb": "turn_head", "target": "港口水面与桅杆", "face_to": "away", "pace": "slow"}], "composition": {"rule": "lead_room", "subject_position": "left_third"}, "rule_justifications": [{"rule": "AXIS_RULE", "action": "follow", "reason": "回到主轴 A 侧双人机位，两人左右关系与前序镜头保持一致，视线交叉不越轴。"}, {"rule": "INTENT_PACK", "action": "follow", "reason": "留白意图要求 MS 固定机位，本镜以极轻微手持呼吸感保持画面静止，让沉默本身成为内容。"}, {"rule": "STAGING_PACK", "action": "follow", "reason": "MS 景别采用 lead_room 构图、平视机位，把右侧留白交给码头通道的纵深。"}]}, {"shot_id": "shot_046", "order": 22, "intent": "留白，伊恩抬头看星", "shot_type": "CU", "duration_frames": 72, "characters": ["伊恩"], "dialogue_ids": [], "actions": [], "dialogues": [], "prompt": "特写（CU），50mm，平视，固定机位，机位在 A 侧（轴线同侧），伊恩位于画面右三分处，头顶留白约 5%，视线朝画面上方偏左——他微微仰头，望向夜空中的星与港口桅杆之上的天光。镜头全程不动，只有呼吸与一次缓慢的抬头；背景是第十四街区码头市场通道尽头的夜色与港口水面反光，浅景深把远处桅杆虚化成几点微光。留白：画面大部分交给夜空，人物沉默，情绪收在静止里。", "camera": {"side": "front_left", "lens": 50}, "axis_note": "机位在 A 侧，伊恩视线朝画面上方偏左", "continuity_in": "景别由 MS 跳至 CU", "gaze": [{"from": "米迦尔", "to": "伊恩"}, {"from": "伊恩", "to": "米迦尔"}], "vfx": [], "declared_duration_frames": 0, "declared_shot_number": 46, "declared_camera_move": "static", "intent_type": "留白", "dialogue_pins": [], "beats": [{"t": 0.15, "subject": "伊恩", "verb": "turn_head", "target": "港口水面与桅杆", "face_to": "screen_left", "pace": "slow"}, {"t": 0.4, "subject": "伊恩", "verb": "look_at", "target": "港口水面与桅杆", "face_to": "screen_left", "pace": "slow"}, {"t": 0.85, "subject": "伊恩", "verb": "body_tilt", "target": "港口水面与桅杆", "face_to": "screen_left", "pace": "slow"}], "composition": {"rule": "thirds", "subject_position": "right_third"}, "rule_justifications": [{"rule": "STAGING_PACK:shot_size=shot_size:CU composition_rule=headroom camera_angle=平视", "action": "follow", "reason": "特写采用头顶留白与平视机位，符合卡片 comp_headroom 的 3%~12% 区间（本镜约 5%）。"}, {"rule": "INTENT_PACK:intent=intent:留白 shot_size=shot_size:MS movement=固定", "action": "break", "reason": "本镜意图是留白式收束，但情绪落点在伊恩的面部，必须用 CU 才能读出他抬头看星的眼神；景别冲突按“更具体者优先”裁决为 CU，运动仍保持固定以维持留白的静。", "precedent": "case_what-is-an-eyeline-match_022"}, {"rule": "SHOT_PATTERN:shot_size=shot_size:MS lens=lens:50mm movement=movement:zoom_in headroom_policy=cinematic 禁={shot_size:CU}", "action": "break", "reason": "该模式要求 MS 且 zoom_in，但本镜是轴线同侧的静态特写，任何推镜都会把留白读成“事情开始了”，与告别后的沉默相悖；故保留 50mm 与电影化留白，放弃 MS 与 zoom_in。", "precedent": "cine_static_contrast"}]}, {"shot_id": "shot_047", "order": 23, "intent": "米迦尔微笑的反应", "shot_type": "CU", "duration_frames": 48, "characters": ["米迦尔"], "dialogue_ids": [], "actions": [], "dialogues": [], "prompt": "米迦尔头部特写，位于画面左侧，嘴角微微上扬，视线朝画面右侧", "camera": {}, "axis_note": "反向机位在 A 侧，米迦尔视线朝画面右侧", "continuity_in": "与上一镜成对切，机位角度变化大于 30°", "gaze": [{"from": "米迦尔", "to": "伊恩"}, {"from": "伊恩", "to": "米迦尔"}], "vfx": [], "declared_duration_frames": 0, "declared_shot_number": 47, "declared_camera_move": "static", "intent_type": "释放", "dialogue_pins": [], "beats": [], "composition": {}, "rule_justifications": []}, {"shot_id": "shot_048", "order": 24, "intent": "段落收束，两人在夜色中并肩", "shot_type": "MLS", "duration_frames": 72, "characters": ["米迦尔", "伊恩"], "dialogue_ids": [], "actions": [], "dialogues": [], "prompt": "中远景双人，两人并肩坐在夜色石阶上，灯塔与海面占据背景", "camera": {}, "axis_note": "机位退回主轴 A 侧，保持左右关系", "continuity_in": "景别放宽两档，段落松手", "gaze": [{"from": "米迦尔", "to": "伊恩"}, {"from": "伊恩", "to": "米迦尔"}], "vfx": [], "declared_duration_frames": 0, "declared_shot_number": 48, "declared_camera_move": "static", "intent_type": "收束", "dialogue_pins": [], "beats": [], "composition": {}, "rule_justifications": []}, {"shot_id": "shot_049", "order": 1, "intent": "建立清晨码头全景，交代两人与船的空间关系", "shot_type": "LS", "duration_frames": 72, "characters": ["米迦尔"], "dialogue_ids": [], "actions": [], "dialogues": [], "prompt": "清晨码头大全景，薄雾未散，木质栈桥自左前延伸向右后，系泊的船在右后方，栈桥上立着米迦尔的小小身影", "camera": {}, "axis_note": "机位在轴线外侧水面侧，确立左（米迦尔）右（伊恩）银幕关系", "continuity_in": "承接前段并肩位置，米迦尔在栈桥中段偏左", "gaze": [{"from": "米迦尔", "to": "伊恩"}, {"from": "伊恩", "to": "米迦尔"}], "vfx": [], "declared_duration_frames": 0, "declared_shot_number": 49, "declared_camera_move": "static", "intent_type": "铺垫", "dialogue_pins": [], "beats": [], "composition": {}, "rule_justifications": []}, {"shot_id": "shot_050", "order": 2, "intent": "两人隔半步距离对话，推进告别主线", "shot_type": "MS", "duration_frames": 96, "characters": ["米迦尔", "伊恩"], "dialogue_ids": ["line_01"], "actions": [], "dialogues": [{"character_id": "米迦尔", "text": "我先上船。", "start_frame": 8, "end_frame": 44}, {"character_id": "伊恩", "text": "等等我。", "start_frame": 60, "end_frame": 84}], "prompt": "第十四街区码头市场通道，午后。中景，35mm，机位与轴线同侧、略偏正面（front_left），两人隔半步距离相向而立：米迦尔在画面左三分之一，伊恩在右三分之一，中间留出半步空隙与码头通道的纵深。米迦尔说\"我先上船\"，说完目光从伊恩脸上移开、转向画面右侧（船的方向）；伊恩先微顿，随后轻轻点头回应\"等等我\"，身体重心前倾半步又停住。镜头以极缓的 push_through 向两人之间的空隙推进，把告别主线压实在这半步距离上。背景是摊位长桌与货箱、港口水面与桅杆，自然光。", "camera": {"side": "front_left", "lens": 35}, "axis_note": "机位在轴线同侧，景别由 LS 跳至 MS，满足 30° 规则", "continuity_in": "由全景切入中景，两人位置不变", "gaze": [{"from": "米迦尔", "to": "伊恩"}, {"from": "伊恩", "to": "米迦尔"}], "vfx": [], "declared_duration_frames": 0, "declared_shot_number": 50, "declared_camera_move": "static", "intent_type": "推进", "dialogue_pins": [], "beats": [{"t": 0.05, "subject": "米迦尔", "verb": "look_at", "target": "伊恩", "face_to": "screen_right"}, {"t": 0.3, "subject": "米迦尔", "verb": "turn_head", "target": "港口水面与桅杆", "face_to": "screen_right"}, {"t": 0.45, "subject": "伊恩", "verb": "nod", "target": "米迦尔", "face_to": "screen_left"}, {"t": 0.6, "subject": "伊恩", "verb": "body_tilt", "target": "米迦尔", "face_to": "screen_left"}], "composition": {"rule": "thirds", "subject_position": "left_third"}, "rule_justifications": [{"rule": "SHOT_PATTERN", "action": "follow", "reason": "本镜为 MS 中景、35mm 镜头、headroom 按 cinematic 处理，符合该镜头模式；movement 取 push_through 而非固定，由更具体的推进意图包裁决。"}, {"rule": "INTENT_PACK", "action": "follow", "reason": "intent 为推进，景别 MS，movement 取 push_through，与'推进 + MS + push_through'条目一致，两处冲突按更具体者优先裁决。"}, {"rule": "AXIS_RULE", "action": "follow", "reason": "两人对话轴线保持同侧，机位不越轴；本镜使用 push_through 而非固定，不触发该规则对固定机位的禁用。"}]}, {"shot_id": "shot_051", "order": 3, "intent": "伊恩回应，镜头逼近其面部情绪", "shot_type": "MCU", "duration_frames": 72, "characters": ["伊恩"], "dialogue_ids": ["line_02"], "actions": [], "dialogues": [{"character_id": "伊恩", "text": "等等我。", "start_frame": 8, "end_frame": 48}], "prompt": "第十四街区码头市场通道，午后。伊恩单人中近景，位于画面右三分之一处，视线朝画面左（朝向米迦尔的方向，越肩机位同侧）。85mm 固定镜头，平视，头留白 cinematic。背景是摊位长桌与货箱、远处港口水面与桅杆。伊恩开口回应，说到一半时下颌微收、目光微微下移，情绪在压抑中松动；镜头轻微推进逼近其面部，把这句话的重量压在他的脸上。收尾留出静止余量。", "camera": {"side": "over_shoulder", "lens": 85}, "axis_note": "同侧机位，景别 MS→MCU 跳档，伊恩保持画面右方位置", "continuity_in": "切至伊恩单人，视线仍朝画面左", "gaze": [{"from": "伊恩", "to": "米迦尔与伊恩的站位"}], "vfx": [], "declared_duration_frames": 0, "declared_shot_number": 51, "declared_camera_move": "static", "intent_type": "推进", "dialogue_pins": [], "beats": [{"t": 0.05, "subject": "伊恩", "verb": "turn_head", "target": "米迦尔与伊恩的站位", "face_to": "screen_left", "pace": "slow"}, {"t": 0.3, "subject": "伊恩", "verb": "nod", "target": "米迦尔与伊恩的站位", "face_to": "screen_left"}, {"t": 0.6, "subject": "伊恩", "verb": "look_at", "target": "米迦尔与伊恩的站位", "face_to": "screen_left", "pace": "slow"}, {"t": 0.85, "subject": "伊恩", "verb": "body_tilt", "target": "米迦尔与伊恩的站位", "face_to": "screen_left"}], "composition": {"rule": "thirds", "subject_position": "right_third"}, "rule_justifications": [{"rule": "SHOT_PATTERN", "action": "follow"}, {"rule": "STAGING_PACK", "action": "follow"}, {"rule": "INTENT_PACK", "action": "follow"}, {"rule": "AXIS_RULE", "action": "follow"}]}, {"shot_id": "shot_052", "order": 4, "intent": "米迦尔催促，情绪收紧", "shot_type": "MCU", "duration_frames": 72, "characters": ["米迦尔"], "dialogue_ids": ["line_03"], "actions": [], "dialogues": [], "prompt": "中近景，米迦尔面向画面右，下巴微抬，身后栈桥栏杆与水面虚化", "camera": {}, "axis_note": "同侧机位反打，机位角度变化远超 30°，视线朝画面右", "continuity_in": "反打至米迦尔，与上一镜构成正反打", "gaze": [{"from": "米迦尔", "to": "伊恩"}, {"from": "伊恩", "to": "米迦尔"}], "vfx": [], "declared_duration_frames": 0, "declared_shot_number": 52, "declared_camera_move": "static", "intent_type": "推进", "dialogue_pins": [], "beats": [], "composition": {}, "rule_justifications": []}, {"shot_id": "shot_053", "order": 5, "intent": "两人握手，情绪顶点", "shot_type": "MS", "duration_frames": 72, "characters": ["米迦尔", "伊恩"], "dialogue_ids": ["line_04"], "actions": [], "dialogues": [], "prompt": "中景，两人面对面握手，手臂在画面中央交握，清晨侧光勾出两人轮廓，身后船影静默", "camera": {}, "axis_note": "机位回到轴线中段偏外，景别 MCU→MS 跳档，握手位于画面中心不越轴", "continuity_in": "由单人反打回到双人中景，位置关系不变", "gaze": [{"from": "米迦尔", "to": "伊恩"}, {"from": "伊恩", "to": "米迦尔"}], "vfx": [], "declared_duration_frames": 0, "declared_shot_number": 53, "declared_camera_move": "static", "intent_type": "转折", "dialogue_pins": [], "beats": [], "composition": {}, "rule_justifications": []}, {"shot_id": "shot_054", "order": 6, "intent": "伊恩转身走向船，告别开始", "shot_type": "MS", "duration_frames": 72, "characters": ["伊恩"], "dialogue_ids": ["line_05"], "actions": [{"character_id": "伊恩", "action_type": "turn_body", "start_frame": 1, "end_frame": 18, "params": {"angle_deg": 115}}, {"character_id": "伊恩", "action_type": "walk_to", "start_frame": 19, "end_frame": 60, "target_position": [7.6, -5.2, 4.5], "params": {"speed": "walk", "from": [6.71, -6.31, 4.51], "to": [7.6, -5.2, 4.5], "bob": 0.03}}, {"character_id": "伊恩", "action_type": "turn_head", "start_frame": 46, "end_frame": 60, "params": {"angle_deg": 25}}], "dialogues": [], "prompt": "MS，50mm，机位略退在伊恩右前方同侧，固定微稳。午后码头市场通道，伊恩松手后由画面右前转身，朝画面右后方纵深走向船，脚步不快，行至中途略偏头回望米迦尔方向，随即继续前行。背景为摊位长桌与货箱、港口水面与桅杆，纵深透视线引导视线向右后；伊恩置于画面左三分之一，右后方留出行进空间。无台词，仅环境声与脚步。", "camera": {"side": "front_right", "lens": 50}, "axis_note": "机位略退，保持轴线同侧，运动方向朝画面右后不越轴", "continuity_in": "握手后松手，伊恩由画面右向画面深处移动", "gaze": [{"from": "米迦尔", "to": "伊恩"}, {"from": "伊恩", "to": "米迦尔"}], "vfx": [], "declared_duration_frames": 0, "declared_shot_number": 54, "declared_camera_move": "static", "intent_type": "收束", "dialogue_pins": [], "beats": [{"t": 0.0, "subject": "伊恩", "verb": "turn_body", "target": "米迦尔与伊恩的站位", "face_to": "screen_right", "pace": "slow"}, {"t": 0.25, "subject": "伊恩", "verb": "walk_to", "target": "第十四街区码头市场通道", "face_to": "away", "pace": "normal"}, {"t": 0.65, "subject": "伊恩", "verb": "turn_head", "target": "米迦尔与伊恩的站位", "face_to": "screen_left", "pace": "slow"}], "composition": {"rule": "lead_room", "subject_position": "left_third"}, "rule_justifications": [{"rule": "SHOT_PATTERN", "action": "follow", "reason": "MS 景别、固定机位、cinematic 头顶留白，符合镜头模板要求。"}, {"rule": "AXIS_RULE", "action": "follow", "reason": "机位略退保持在轴线同侧，伊恩朝画面右后方纵深移动，不越轴。"}, {"rule": "INTENT_PACK", "action": "follow", "reason": "告别起势属铺垫/收束，MS 固定机位保留空间余量，符合 intent 包。"}]}, {"shot_id": "shot_055", "order": 7, "intent": "米迦尔目送，情绪贴近", "shot_type": "CU", "duration_frames": 48, "characters": ["米迦尔"], "dialogue_ids": ["line_06"], "actions": [], "dialogues": [], "prompt": "特写，米迦尔面部，平视，50mm。他站在第十四街区码头市场通道的摊位长桌旁，视线朝画面右方，承接上一镜伊恩离去的方向。午后港口光线从右侧打来，背景是虚化的货箱与远处港口水面与桅杆。表演克制：目光追随、极轻的一次点头，随后头微微转向水面方向，眼底压着不舍。相机同侧固定，仅以极缓的推近贴近情绪。头顶留白约 5%，主体位于左三分位，前方留出视线空间。", "camera": {"side": "front_right", "lens": 50}, "axis_note": "同侧机位，景别 MS→CU 跳档，视线朝画面右方", "continuity_in": "切至米迦尔面部，视线方向承接上一镜的伊恩去向", "gaze": [{"from": "米迦尔", "to": "港口水面与桅杆"}], "vfx": [], "declared_duration_frames": 0, "declared_shot_number": 55, "declared_camera_move": "static", "intent_type": "留白", "dialogue_pins": [], "beats": [{"t": 0.0, "subject": "米迦尔", "verb": "look_at", "target": "米迦尔与伊恩的站位", "face_to": "screen_right", "pace": "slow", "react": "视线承接上一镜伊恩离去的方向，目光停在画面右侧"}, {"t": 0.58, "subject": "米迦尔", "verb": "nod", "target": "米迦尔与伊恩的站位", "face_to": "screen_right", "pace": "slow"}, {"t": 0.82, "subject": "米迦尔", "verb": "turn_head", "target": "港口水面与桅杆", "face_to": "screen_right", "pace": "slow"}], "composition": {"rule": "lead_room", "subject_position": "left_third"}, "rule_justifications": [{"rule": "STAGING_PACK", "action": "follow", "reason": "CU 平视机位，头顶留白控制在画面高度 3%~12%，主体落在左三分位，为视线朝画面右方留出前方空间。"}, {"rule": "AXIS_RULE", "action": "follow", "reason": "与上一镜同侧机位，米迦尔视线保持朝画面右方，不越轴，承接伊恩的去向。"}, {"rule": "SHOT_PATTERN", "action": "break", "reason": "该条要求 MS+50mm+zoom_in 且禁 CU，与本镜意图（目送、情绪贴近）冲突：此处需要跳档到特写把情绪压到脸上，故以 CU 与固定机位执行，由更具体的 INTENT_PACK（揭示/CU/固定）优先。", "precedent": "case_what-is-an-establishing-shot-definition-examples_007"}]}, {"shot_id": "shot_056", "order": 8, "intent": "船离岸，段末收束，人物重新放回环境", "shot_type": "MLS", "duration_frames": 72, "characters": ["米迦尔"], "dialogue_ids": ["line_07"], "actions": [], "dialogues": [], "prompt": "中远景，米迦尔立于栈桥右端目送，右后方船缓缓离岸，水面被划开一道白痕", "camera": {}, "axis_note": "机位后撤至轴线外侧，景别 CU→MLS 跳档，船向画面右外移动", "continuity_in": "由特写拉回中远景，米迦尔仍在栈桥右端", "gaze": [{"from": "米迦尔", "to": "伊恩"}, {"from": "伊恩", "to": "米迦尔"}], "vfx": [], "declared_duration_frames": 0, "declared_shot_number": 56, "declared_camera_move": "static", "intent_type": "收束", "dialogue_pins": [], "beats": [], "composition": {}, "rule_justifications": []}, {"shot_id": "shot_057", "order": 9, "intent": "码头恢复平静的大全景，时空过渡", "shot_type": "LS", "duration_frames": 72, "characters": ["米迦尔"], "dialogue_ids": [], "actions": [{"character_id": "米迦尔", "action_type": "look_at", "start_frame": 1, "end_frame": 12, "params": {"yaw_deg": -20, "pitch_deg": 3}}, {"character_id": "米迦尔", "action_type": "walk_to", "start_frame": 14, "end_frame": 52, "target_position": [6.4, -6.6, 4.4], "params": {"speed": "walk", "from": [6.9, -6.2, 4.5], "to": [6.4, -6.6, 4.4], "bob": 0.03}}], "dialogues": [], "prompt": "大全景（LS），第十四街区码头市场通道。午后光线渐柔，摊位长桌与货箱静置一侧，港口水面与桅杆在远处铺开。米迦尔独自站在画面右三分处，身形很小，先缓缓转头望向画面左侧的水面与桅杆，随后沿码头通道向左侧缓步移动几步后停下。相机在人物前左侧、平视高度，35mm 广角，从镜头开始到第 60 帧缓慢后拉 1.6 米，把码头与水面一点点交还给画面，人物逐渐变小。固定同侧远景，银幕方向不变，无对白，只有水声与远处桅杆轻响，时空在此过渡、归于平静。", "camera": {"side": "front_left", "lens": 35}, "axis_note": "同侧远景，景别 MLS→LS 跳档，银幕方向不变", "continuity_in": "同一时空延续，机位拉至更远", "gaze": [{"from": "米迦尔", "to": "伊恩"}, {"from": "伊恩", "to": "米迦尔"}], "vfx": [], "declared_duration_frames": 0, "declared_shot_number": 57, "declared_camera_move": "static", "intent_type": "留白", "dialogue_pins": [], "beats": [{"t": 0.0, "subject": "米迦尔", "verb": "look_at", "target": "港口水面与桅杆", "face_to": "screen_left", "pace": "slow"}, {"t": 0.15, "subject": "米迦尔", "verb": "walk_to", "target": "米迦尔与伊恩的站位", "face_to": "screen_left", "pace": "slow"}, {"t": 0.75, "subject": "米迦尔", "verb": "stand", "target": "米迦尔与伊恩的站位", "face_to": "screen_left"}], "composition": {"rule": "lead_room", "subject_position": "right_third"}, "rule_justifications": [{"rule": "AXIS_RULE", "action": "follow", "reason": "本镜为固定同侧远景，米迦尔始终在轴线同一侧（画面左侧朝向港口水面），银幕方向不变，与前一镜的越轴禁忌一致。"}, {"rule": "INTENT_PACK:intent:留白 shot_size=shot_size:LS movement=固定", "action": "follow", "reason": "码头恢复平静的大全景，以固定机位留白收束，只保留缓慢拉开的空间余韵。"}, {"rule": "STAGING_PACK:shot_size=shot_size:LS composition_rule=lead_room camera_angle=平视", "action": "follow", "reason": "大全景采用平视机位与 lead_room 构图，米迦尔置于右三分，视线与行进方向留出港口水面的空白。"}]}, {"shot_id": "shot_058", "order": 10, "intent": "两人的影子还留在栈桥上，收束意象", "shot_type": "MS", "duration_frames": 96, "characters": ["米迦尔", "伊恩"], "dialogue_ids": ["line_08"], "actions": [], "dialogues": [], "prompt": "清晨码头市场栈桥中景，低机位平视，米迦尔与伊恩并肩立于栈桥左三分之一处，右侧留出栈桥向水面延伸的空白。同一清晨侧逆光，两人身形拉出长影横在木板栈桥上。固定机位，无运动。米迦尔微微侧头看向伊恩，伊恩缓缓转头回应，随后米迦尔转身面向码头市场通道深处，两人影子仍留在栈桥上，画面安静收束。", "camera": {"side": "front_left", "lens": 50}, "axis_note": "低机位仍置于轴线同侧，景别 LS→MS 跳档", "continuity_in": "由全景切至栈桥局部，同一清晨光线", "gaze": [{"from": "米迦尔", "to": "伊恩"}, {"from": "伊恩", "to": "米迦尔"}], "vfx": [], "declared_duration_frames": 0, "declared_shot_number": 58, "declared_camera_move": "static", "intent_type": "留白", "dialogue_pins": [], "beats": [{"t": 0.0, "subject": "米迦尔", "verb": "look_at", "target": "伊恩", "face_to": "screen_right", "pace": "slow"}, {"t": 0.35, "subject": "伊恩", "verb": "turn_head", "target": "米迦尔", "face_to": "screen_left", "pace": "slow"}, {"t": 0.7, "subject": "米迦尔", "verb": "turn_body", "target": "第十四街区码头市场通道", "face_to": "away", "pace": "slow"}], "composition": {"rule": "lead_room", "subject_position": "left_third"}, "rule_justifications": [{"rule": "AXIS_RULE", "action": "follow", "reason": "低机位仍留在轴线同侧，由全景跳档至中景不越轴，两人左右关系与上一镜一致。"}, {"rule": "STAGING_PACK", "action": "follow", "reason": "中景平视、主体偏左三分之一，右侧留出栈桥延伸与水面空间作为留白。"}, {"rule": "INTENT_PACK", "action": "follow", "reason": "固定机位承载收束意象，不引入新运动，让影子留在栈桥上成为画面最后的落点。"}]}, {"shot_id": "shot_059", "order": 11, "intent": "伊恩在船头回望，收束", "shot_type": "MCU", "duration_frames": 72, "characters": ["伊恩"], "dialogue_ids": ["line_09"], "actions": [], "dialogues": [], "prompt": "午后码头市场，伊恩立于船头，中近景（MCU）85mm 平视，机位在船体前右方、与米迦尔—伊恩轴线同侧，不越轴。伊恩位于画面右三分处，面朝画面左侧回望岸上的米迦尔，留出左侧视线空间。镜头以极缓的推近（dolly_in 0.6m）从 MS 过渡到 MCU，收束在伊恩回望的侧脸上。背景可见港口水面与桅杆、码头市场通道的摊位长桌与货箱虚化层次。表演：先缓慢转头回望，随后视线停在岸上，最后轻轻点头，情绪克制。固定机位为主，无大幅运镜，收尾留白。", "camera": {"side": "front_right", "lens": 85}, "axis_note": "机位在船一侧但保持轴线同侧，景别 MS→MCU 跳档，回望方向朝画面左", "continuity_in": "切至船上伊恩，视线回望岸上米迦尔", "gaze": [{"from": "伊恩", "to": "米迦尔与伊恩的站位"}], "vfx": [], "declared_duration_frames": 0, "declared_shot_number": 59, "declared_camera_move": "static", "intent_type": "回望", "dialogue_pins": [], "beats": [{"t": 0.0, "subject": "伊恩", "verb": "turn_head", "target": "米迦尔与伊恩的站位", "face_to": "screen_left", "pace": "slow"}, {"t": 0.35, "subject": "伊恩", "verb": "look_at", "target": "米迦尔与伊恩的站位", "face_to": "screen_left", "pace": "slow"}, {"t": 0.8, "subject": "伊恩", "verb": "nod", "face_to": "screen_left", "pace": "slow"}], "composition": {"rule": "lead_room", "subject_position": "right_third"}, "rule_justifications": [{"rule": "SHOT_PATTERN", "action": "follow", "reason": "本镜为 MCU、85mm、固定机位，符合镜头模式硬约束，且未使用 ECU。"}, {"rule": "STAGING_PACK", "action": "follow", "reason": "MCU 采用 balance 构图、平视机位，未使用 framing 破例。"}, {"rule": "AXIS_RULE", "action": "follow", "reason": "机位保持在与米迦尔—伊恩轴线同侧的前右方，不越轴，回望方向统一朝画面左，与上一镜视线方向一致。"}, {"rule": "INTENT_PACK", "action": "follow", "reason": "回望收束属于留白式收尾，采用 MCU 固定机位，让伊恩的回望成为情绪落点。"}]}, {"shot_id": "shot_060", "order": 12, "intent": "米迦尔在岸上回应目送，收束", "shot_type": "MCU", "duration_frames": 72, "characters": ["米迦尔"], "dialogue_ids": ["line_10"], "actions": [{"character_id": "米迦尔", "action_type": "look_at", "start_frame": 1, "end_frame": 20, "params": {"yaw_deg": -18, "pitch_deg": -2}}, {"character_id": "米迦尔", "action_type": "nod", "start_frame": 24, "end_frame": 40, "params": {"cycles": 1}}, {"character_id": "米迦尔", "action_type": "turn_head", "start_frame": 44, "end_frame": 60, "params": {"angle_deg": 22}}], "dialogues": [], "prompt": "第十四街区码头市场通道，午后硬光。米迦尔独自站在岸上，摊位长桌与货箱在他身后堆叠，远处港口水面与桅杆在景深外发亮。中近景，平视，85mm 固定机位，同侧反打机位保持轴线不越——他身体略偏，视线越过镜头朝画面右（伊恩回望的方向）送出，与上一镜隔水对望形成交叉视线。头顶留白克制，画面右侧留出视线前方空间（lead room）。表演极简：先一次极轻的点头，再缓缓把目光从伊恩的方向收回，垂落至画面下方，肩膀几乎不动，只有呼吸的起伏。固定镜头不做任何运动，把运动的参照系留给下一镜；结尾余量里他静止不动，让告别在静止中收束。", "camera": {"side": "front_right", "lens": 85}, "axis_note": "同侧机位反打，视线朝画面右与伊恩回望方向交叉不越轴", "continuity_in": "反打至岸上米迦尔，与上一镜构成隔水对望", "gaze": [{"from": "米迦尔", "to": "伊恩"}], "vfx": [], "declared_duration_frames": 0, "declared_shot_number": 60, "declared_camera_move": "static", "intent_type": "留白", "dialogue_pins": [], "beats": [{"t": 0.05, "subject": "米迦尔", "verb": "look_at", "target": "米迦尔与伊恩的站位", "face_to": "screen_right", "pace": "slow"}, {"t": 0.35, "subject": "米迦尔", "verb": "nod", "target": "米迦尔与伊恩的站位", "react": "无声地应下目送"}, {"t": 0.6, "subject": "米迦尔", "verb": "turn_head", "target": "港口水面与桅杆", "face_to": "away", "pace": "slow"}], "composition": {"rule": "lead_room", "subject_position": "left_third"}, "rule_justifications": [{"rule": "SHOT_PATTERN", "action": "follow", "reason": "计划指定 MCU／固定机位，与镜头模式约束一致"}, {"rule": "STAGING_PACK", "action": "follow", "reason": "MCU 平视 + lead_room，视线方向留白给画面右"}, {"rule": "AXIS_RULE", "action": "follow", "reason": "同侧反打，视线朝画面右与伊恩回望交叉，机位不越过水面轴线"}]}, {"shot_id": "shot_061", "order": 13, "intent": "市场重新热闹起来，两人身影已分离", "shot_type": "MS", "duration_frames": 72, "characters": ["米迦尔", "伊恩"], "dialogue_ids": [], "actions": [], "dialogues": [], "prompt": "中景，前景摊位人影走动渐多，米迦尔在画面左转身朝岸上走，远处船上的伊恩只是画面右缘一个小身影", "camera": {}, "axis_note": "机位略退至轴线外侧，景别 MCU→MS 跳档，米迦尔朝画面左离场", "continuity_in": "承接隔水对望，人群开始进入画面", "gaze": [{"from": "米迦尔", "to": "伊恩"}, {"from": "伊恩", "to": "米迦尔"}], "vfx": [], "declared_duration_frames": 0, "declared_shot_number": 61, "declared_camera_move": "static", "intent_type": "收束", "dialogue_pins": [], "beats": [], "composition": {}, "rule_justifications": []}, {"shot_id": "shot_062", "order": 14, "intent": "米迦尔转身离开的近特写，收束", "shot_type": "CU", "duration_frames": 48, "characters": ["米迦尔"], "dialogue_ids": [], "actions": [{"character_id": "米迦尔", "action_type": "turn_body", "start_frame": 1, "end_frame": 20, "params": {"angle_deg": 70}}, {"character_id": "米迦尔", "action_type": "walk_to", "start_frame": 21, "end_frame": 40, "target_position": [6.2, -5.9, 4.5], "params": {"speed": "walk", "from": [6.71, -6.31, 4.51], "to": [6.2, -5.9, 4.5], "bob": 0.03}}, {"character_id": "米迦尔", "action_type": "turn_head", "start_frame": 8, "end_frame": 18, "params": {"angle_deg": 25}}], "dialogues": [], "prompt": "近特写，50mm，同侧机位（front_left），米迦尔位于画面右三分之一，留出左侧通道空间（lead_room）。米迦尔背对伊恩方向，身体由右向左转开约 70°，随后迈步走向第十四街区码头市场通道并走出画面；转身前视线由画面右侧收回，短暂回瞥伊恩站位后移开。相机固定并缓缓前推 0.8 米，景别由中近收紧为近特写。背景为码头市场通道的摊位长桌与货箱、远处港口水面与桅杆，午后侧光。收束感：最后 12 帧留出静止余量，人物已离开画面。", "camera": {"side": "front_left", "lens": 50}, "axis_note": "同侧机位，景别 MS→CU 跳档，视线方向保持画面右→左收束", "continuity_in": "紧接上一镜的转身动作，视线由右收回", "gaze": [{"from": "米迦尔", "to": "米迦尔与伊恩的站位"}], "vfx": [], "declared_duration_frames": 0, "declared_shot_number": 62, "declared_camera_move": "static", "intent_type": "收束", "dialogue_pins": [], "beats": [{"t": 0.0, "subject": "米迦尔", "verb": "turn_body", "target": "第十四街区码头市场通道", "face_to": "screen_left", "pace": "slow"}, {"t": 0.15, "subject": "米迦尔", "verb": "turn_head", "target": "米迦尔与伊恩的站位", "face_to": "screen_right", "pace": "slow", "react": "视线由右收回，最后一瞥"}, {"t": 0.42, "subject": "米迦尔", "verb": "walk_to", "target": "第十四街区码头市场通道", "face_to": "screen_left", "pace": "normal"}, {"t": 0.85, "subject": "米迦尔", "verb": "exit_frame", "target": "第十四街区码头市场通道", "face_to": "away", "pace": "normal"}], "composition": {"rule": "lead_room", "subject_position": "right_third"}, "rule_justifications": [{"rule": "AXIS_RULE", "action": "follow", "reason": "同侧机位保持画面右→左的视线方向，不越轴，转身离开的朝向与上一镜一致"}, {"rule": "INTENT_PACK", "action": "follow", "reason": "收束意图用近特写+固定机位完成，收紧到面部收束情绪"}, {"rule": "SHOT_PATTERN", "action": "break", "reason": "SHOT_PATTERN 要求 MS 且禁 CU，但本镜是收束近特写，需要把景别跳到 CU 才能完成「转身离开」的收束；若退回 MS，转身的细微表情与视线收回将无法被读到。景别跳档正是分镜计划中 MS→CU 的意图。", "precedent": "case_types-of-camera-shots-sizes-in-film_035"}]}, {"shot_id": "shot_063", "order": 15, "intent": "伊恩在船上的中远景，收束", "shot_type": "MLS", "duration_frames": 48, "characters": ["伊恩"], "dialogue_ids": [], "actions": [], "dialogues": [], "prompt": "中远景（MLS），50mm 镜头，平视机位，画面轻微呼吸式晃动。伊恩独自站在行进中的船上，位于画面左三分，身体朝向画面右侧，右侧留出行进方向的空白（lead room）。船朝画面右外行进。伊恩先望向右侧米迦尔离去的方向，随后缓缓转头望向港口水面与桅杆，肩背轻微倾斜，情绪收束。背景为第十四街区码头市场通道与港口水面、桅杆，午后光线。同侧机位，不越轴；与米迦尔离场形成分离关系。", "camera": {"side": "front_right", "lens": 50}, "axis_note": "同侧机位，景别 CU→MLS 跳档，船行进方向朝画面右外", "continuity_in": "切至船上伊恩，与米迦尔离场形成分离关系", "gaze": [{"from": "米迦尔", "to": "伊恩"}, {"from": "伊恩", "to": "米迦尔"}], "vfx": [], "declared_duration_frames": 0, "declared_shot_number": 63, "declared_camera_move": "static", "intent_type": "回望", "dialogue_pins": [], "beats": [{"t": 0.0, "subject": "伊恩", "verb": "look_at", "target": "米迦尔与伊恩的站位", "face_to": "screen_right"}, {"t": 0.3, "subject": "伊恩", "verb": "turn_head", "target": "米迦尔与伊恩的站位", "face_to": "screen_right"}, {"t": 0.55, "subject": "伊恩", "verb": "look_at", "target": "港口水面与桅杆", "face_to": "screen_right"}, {"t": 0.8, "subject": "伊恩", "verb": "body_tilt", "target": "港口水面与桅杆", "face_to": "screen_right", "pace": "slow"}], "composition": {"rule": "lead_room", "subject_position": "left_third"}, "rule_justifications": [{"rule": "AXIS_RULE", "action": "follow", "reason": "同侧机位保持中性轴，伊恩视线朝向画面右外，与米迦尔离场方向一致，不越轴。"}, {"rule": "SHOT_PATTERN", "action": "follow", "reason": "MLS 配 50mm、电影化头顶留白，符合景别与焦距约束。"}, {"rule": "STAGING_PACK", "action": "follow", "reason": "MLS 采用平衡构图、平视机位（低机位与平视冲突时取更具体的平视），收束情绪克制。"}, {"rule": "cine_static_contrast", "action": "break", "reason": "本镜为收束镜，仅用极轻微的 steadicam 呼吸感跟随船体行进，制造与前一镜离场运动的动静对比，避免画面完全死板。", "precedent": "cine_static_contrast"}]}, {"shot_id": "shot_064", "order": 16, "intent": "码头空镜收尾，余韵淡出", "shot_type": "LS", "duration_frames": 72, "characters": ["米迦尔", "伊恩"], "dialogue_ids": [], "actions": [{"character_id": "米迦尔", "action_type": "walk_to", "start_frame": 1, "end_frame": 58, "target_position": [4.2, -6.31, 4.51], "params": {"speed": "walk", "from": [6.71, -6.31, 4.51], "to": [4.2, -6.31, 4.51], "bob": 0.03}}, {"character_id": "伊恩", "action_type": "walk_to", "start_frame": 8, "end_frame": 62, "target_position": [4.6, -6.6, 4.51], "params": {"speed": "walk", "from": [7.1, -6.6, 4.51], "to": [4.6, -6.6, 4.51], "bob": 0.03}}, {"character_id": "伊恩", "action_type": "turn_head", "start_frame": 38, "end_frame": 44, "params": {"angle_deg": 20}}, {"character_id": "米迦尔", "action_type": "exit_frame", "start_frame": 58, "end_frame": 66, "params": {"speed": "walk", "from": [4.2, -6.31, 4.51], "to": [3.0, -6.31, 4.51], "bob": 0.02}}, {"character_id": "伊恩", "action_type": "exit_frame", "start_frame": 62, "end_frame": 70, "params": {"speed": "walk", "from": [4.6, -6.6, 4.51], "to": [3.2, -6.6, 4.51], "bob": 0.02}}], "dialogues": [{"character_id": "米迦尔", "speaker_raw": "米迦尔", "speaker_status": "resolved", "text": "我先上船。", "start_frame": 1, "end_frame": 39}, {"character_id": "伊恩", "speaker_raw": "伊恩", "speaker_status": "resolved", "text": "等等我。", "start_frame": 51, "end_frame": 82}, {"character_id": "米迦尔", "speaker_raw": "米迦尔", "speaker_status": "resolved", "text": "别拖了。", "star