eadroom_policy", "cinematic"], ["movement", "固定"]]}}, "error": "", "mode": "sidecar", "success": true, "audit_log": "C:\\Users\\小皮\\Documents\\BlockDirector Projects\\runs\\audit_log.jsonl", "llm_trace": "C:\\Users\\小皮\\Documents\\BlockDirector Projects\\runs\\llm_trace.jsonl", "plan": {"scene_heading": "第十四街区码头市场 - 午后（白模预演分镜计划）", "continuity_notes": ["轴线：以米迦尔—伊恩的连线为主轴线（A轴）。镜号2 米迦尔在画左、伊恩在其身后偏画右；镜号3 反打伊恩仍保持伊恩在画右、视线朝画左，不越轴。", "30°规则：镜号2（CU, dolly_in）→ 镜号3（MCU, static）景别变化一档且机位反打 >30°；镜号3（MCU）→ 镜号4（CU）景别变化一档；镜号4（CU）→ 镜号5（MS）景别变化一档并换主体；镜号5（MS）→ 镜号6（MCU）景别变化一档。", "运动节奏：镜号1、3、4、6 为固定镜头作为参照系；镜号2 的 dolly_in 与镜号5 的 follow_subject 作为两次「事情开始了」的运动转折，符合固定/运动对比原则。", "银幕方向：镜号5 偷盗者自画右向画左奔跑（与市场纵深方向一致），镜号6 保持同一方向感，偷盗者仍在画左区域，避免方向反转。", "注视关系：镜号2 米迦尔 → 伊恩（画左视线朝画右后方）；镜号3 伊恩 → 米迦尔（画右视线朝画左）；镜号6 偷盗者低头注视自己掌心（自视），视线不指向镜头外角色。", "待确认项（不写入镜头内容，仅提示下一阶段核实）：镜号4 第二句台词中「他」的先行词；镜号4 米迦尔是否面向伊恩；偷盗者两句台词的听话人；镜号5/6 偷盗者与米迦尔、伊恩是否同处一个可见空间；米迦尔与伊恩的前后站位关系；镜号1 背景约 30 名路人未纳入角色表；钱袋归属是否为赃物。", "时长：各镜时长沿用分镜表硬约束声明（120/144/96/144/120/168 帧），均已容纳该镜全部对白并含 12 帧收尾余量。", "白模阶段不写动作与对白细节，仅标注 dialogue_ids，供单镜结构化生成阶段展开。"], "shots": [{"shot_id": "shot_001", "order": 1, "intent": "建立场景，用微风打破宁静，铺垫即将发生的冲突", "shot_type": "MCU", "duration_frames": 120, "characters": [], "dialogue_ids": [], "actions": [], "dialogues": [], "prompt": "第十四街区码头市场，午后。固定中近景（MCU 取景层次），50mm 定焦，机位架在市场纵深一侧，视线沿摊位纵深方向斜切，为后续米迦尔—伊恩的对话轴线定下基准侧位，本镜无角色入画，不涉及越轴。\n\n画面内容：午后暖侧光从画面左侧斜射进来，穿过木棚与布篷的缝隙，在潮湿的石板地面与摊位上拉出长而柔和的斜影；近处木箱与藤筐堆叠，粗麻布口袋半敞，露出谷物与干鱼；中景处一排摊位纵深排开，铁钩上悬着渔获，铜秤与陶罐在暖光里泛出温润反光；远景码头方向有模糊的桅杆与水面高光，虚化处理，层次透气。\n\n空气中有细微的尘埃与飞絮在光柱里缓慢浮动，五秒左右一阵微风自画面左侧掠过：布篷边缘轻轻掀起又落下，悬挂的麻绳与风铃细碎摇动，摊上轻薄的纸片与草叶被吹得微微翻卷，水面高光随之抖动——这一下微小的扰动打破静态，为即将发生的冲突埋下伏笔。\n\n景别与焦距按中近景层次推导距离与高度，构图保持电影化留白，主体区域（无人的摊位中景带）略偏画面右三分，左侧留出暖光与纵深通道；固定镜头，不做任何推拉摇移，把\"事情开始\"的运动留给后续镜头。", "camera": {"side": "机位置于市场纵深一侧、与后续米迦尔—伊恩轴线垂直的基准侧位，中景景别（MCU 取景高度：约人物胸线以上，本镜无人物，取摊位与货架的中近层次），50mm 定焦，固定机位，无运动", "lens": 50}, "axis_note": "建立镜，机位置于市场纵深一侧，为后续米迦尔—伊恩轴线定下基准；本镜无角色，不涉及越轴。", "continuity_in": "开场；确立午后暖光基调与市场空间方位。", "gaze": [], "vfx": [], "declared_duration_frames": 0, "declared_shot_number": 1, "declared_camera_move": "static", "dialogue_pins": []}, {"shot_id": "shot_002", "order": 2, "intent": "建立米迦尔的角色性格，引出战斗", "shot_type": "CU", "duration_frames": 144, "characters": ["米迦尔", "伊恩"], "dialogue_ids": ["scene_002_dlg_001"], "actions": [], "dialogues": [{"character_id": "米迦尔", "speaker_raw": "米迦尔", "speaker_status": "resolved", "text": "伊恩，这里就交给我吧！", "start_frame": 0, "end_frame": 0}], "prompt": "米迦尔近景，机位缓慢推近，他侧头对身后偏画右的伊恩说话，神情自信，背景是虚化的码头市场暖光。", "camera": {"movements": [{"type": "dolly_in"}]}, "axis_note": "确立米迦尔在画左、伊恩在画右后方的轴线关系；视线由画左指向画右，为镜号3 反打留出对应方向。", "continuity_in": "承接镜号1 的市场空间，切入米迦尔；运动由静转推，标示事情开始。", "gaze": [{"from": "米迦尔", "to": "伊恩"}], "vfx": [], "declared_duration_frames": 0, "declared_shot_number": 2, "declared_camera_move": "dolly_in", "dialogue_pins": [{"shot_number": 2, "speaker_raw": "米迦尔", "speaker_status": "resolved", "declared_s": 3.0, "model_text": "", "applied_s": null}]}, {"shot_id": "shot_003", "order": 3, "intent": "表现两人的搭档关系", "shot_type": "MCU", "duration_frames": 96, "characters": ["伊恩"], "dialogue_ids": ["scene_002_dlg_002"], "actions": [], "dialogues": [{"character_id": "伊恩", "speaker_raw": "伊恩", "speaker_status": "resolved", "text": "好的，那你多小心一些。", "start_frame": 0, "end_frame": 0}], "prompt": "伊恩中近景固定画面，正面朝画左的米迦尔方向平静点头应答，午后侧光落在面部，背景市场帆布篷虚化。", "camera": {}, "axis_note": "反打镜头，机位越过轴线另一侧，伊恩位于画右、视线朝画左，与镜号2 视线方向相对，符合 180° 轴线规则；机位角度变化大于 30°。", "continuity_in": "承接镜号2 米迦尔发话，切至听话人伊恩的应答反应。", "gaze": [{"from": "伊恩", "to": "米迦尔"}], "vfx": [], "declared_duration_frames": 0, "declared_shot_number": 3, "declared_camera_move": "static", "dialogue_pins": [{"shot_number": 3, "speaker_raw": "伊恩", "speaker_status": "resolved", "declared_s": 3.0, "model_text": "", "applied_s": null}]}, {"shot_id": "shot_004", "order": 4, "intent": "铺垫米迦尔即将施法，暗示魔法即将出现", "shot_type": "CU", "duration_frames": 144, "characters": ["米迦尔"], "dialogue_ids": ["scene_003_dlg_001", "scene_003_dlg_002"], "actions": [], "dialogues": [{"character_id": "米迦尔", "speaker_raw": "米迦尔", "speaker_status": "resolved", "text": "放心吧。", "start_frame": 0, "end_frame": 0}, {"character_id": "米迦尔", "speaker_raw": "米迦尔", "speaker_status": "resolved", "text": "看我怎么惩罚他，让他砰的一声，嘻嘻。", "start_frame": 0, "end_frame": 0}], "prompt": "米迦尔手部与胸前近景，固定机位，握拳又松开的准备姿态，掌侧有极淡的暖色微光暗示，背景市场景深虚化。", "camera": {}, "axis_note": "回到米迦尔一侧，机位相对镜号3 反打回原侧，保持米迦尔在画左；景别由 MCU 收紧为 CU，满足 30° 规则。", "continuity_in": "承接镜号3 伊恩的应允，回到米迦尔施法前的准备。", "gaze": [], "vfx": [], "declared_duration_frames": 0, "declared_shot_number": 4, "declared_camera_move": "static", "dialogue_pins": [{"shot_number": 4, "speaker_raw": "米迦尔", "speaker_status": "resolved", "declared_s": 1.0, "model_text": "", "applied_s": null}, {"shot_number": 4, "speaker_raw": "米迦尔", "speaker_status": "resolved", "declared_s": 4.0, "model_text": "", "applied_s": null}]}, {"shot_id": "shot_005", "order": 5, "intent": "展示米迦尔的魔法第一次生效，制造悬念", "shot_type": "MS", "duration_frames": 120, "characters": ["偷盗者"], "dialogue_ids": [], "actions": [], "dialogues": [], "prompt": "跟拍偷盗者中景，他攥着钱袋自画右向画左穿过码头市场奔跑，掌心银币燃起黑红火焰并转为金黄，暖光与火光交错。", "camera": {"movements": [{"type": "follow_subject"}]}, "axis_note": "新主体与新的运动轴线，跟拍方向统一为画右→画左；与镜号4 主体不同，景别变化一档，不构成越轴。", "continuity_in": "由米迦尔施法准备切至魔法生效的偷盗者，运动镜头承接转折。", "gaze": [], "vfx": [], "declared_duration_frames": 0, "declared_shot_number": 5, "declared_camera_move": "follow_subject", "dialogue_pins": []}, {"shot_id": "shot_006", "order": 6, "intent": "制造喜剧反转", "shot_type": "MCU", "duration_frames": 168, "characters": ["偷盗者"], "dialogue_ids": ["scene_004_dlg_001", "scene_004_dlg_002"], "actions": [], "dialogues": [{"character_id": "偷盗者", "speaker_raw": "偷盗者", "speaker_status": "resolved", "text": "怎么回事，不应该只是普通的银币么？", "start_frame": 0, "end_frame": 0}, {"character_id": "偷盗者", "speaker_raw": "偷盗者", "speaker_status": "resolved", "text": "哈哈，一定是命运眷顾，我发财了！", "start_frame": 0, "end_frame": 0}], "prompt": "偷盗者中近景固定画面，他停下脚步低头注视掌心已变为金黄的硬币，脸上由错愕转为狂喜大笑，背景市场暖光虚化。", "camera": {}, "ax