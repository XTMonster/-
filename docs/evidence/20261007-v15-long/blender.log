adroom_policy", "cinematic"]], "lesson": [["composition_rule", "balance"], ["shot_size", "MCU"], ["camera_angle", "平视"]]}, "shot_061": {"theory": [["intent", "收束"], ["shot_size", "MS"], ["movement", "固定"], ["intent", "铺垫"], ["intent", "揭示"], ["intent", "留白"], ["pair", "any_two"], ["axis_side", "neutral"], ["axis_topic", "越轴"], ["lens", "35mm"], ["headroom_policy", "cinematic"]]}, "shot_062": {"theory": [["intent", "揭示"], ["shot_size", "CU"], ["movement", "固定"], ["intent", "收束"], ["shot_size", "MS"], ["lens", "50mm"], ["headroom_policy", "cinematic"], ["movement", "zoom_in"], ["pair", "any_two"], ["axis_side", "neutral"], ["axis_topic", "越轴"]], "experience": [["intent", "回望"], ["shot_size", "CU"], ["movement", "固定"]]}, "shot_063": {"experience": [["intent", "回望"], ["shot_size", "CU"], ["movement", "固定"]], "theory": [["shot_size", "MLS"], ["lens", "50mm"], ["headroom_policy", "cinematic"], ["composition_rule", "balance"], ["camera_angle", "低机位"], ["camera_angle", "平视"], ["pair", "any_two"], ["axis_side", "neutral"], ["axis_topic", "越轴"], ["movement", "固定"], ["axis_topic", "中性机位"]]}, "shot_064": {"theory": [["intent", "留白"], ["shot_size", "LS"], ["movement", "固定"], ["composition_rule", "lead_room"], ["camera_angle", "平视"], ["camera_angle", "低机位"], ["camera_angle", "高机位"], ["pair", "any_two"], ["axis_side", "neutral"], ["axis_topic", "越轴"]]}}, "error": "", "mode": "sidecar", "success": true, "audit_log": "docs\\evidence\\20261007-v15-long\\runs\\audit_log.jsonl", "llm_trace": "docs\\evidence\\20261007-v15-long\\runs\\llm_trace.jsonl", "plan": {"scene_heading": "第十四街区码头市场 - 午后", "continuity_notes": ["以米迦尔（画面左）与伊恩（画面右）的连线为180°轴线，本段所有镜头机位均在轴线同侧，正反打时两人视线分别朝画面右与画面左。", "相邻镜头机位角度变化均超过30°或景别至少变化一档，避免跳切。", "本段（镜号1–24）无对白，dialogue_ids 全部留空；对白集中在后续段落。", "市场环境锚点（摊位长桌、棚架货筐、海面船桅、往来人群）在整场共用，单镜不再重复声明。", "米迦尔与伊恩的银幕左右关系自 shot_002 确立后，本段内保持不变。", "全场共用轴线：米迦尔在画面左、伊恩在画面右，两人相对而立；所有双人镜头机位保持在轴线同一侧，单人反打镜头不得越轴。", "相邻镜头遵循30°规则：MCU反打与MS双人镜之间机位角度变化均大于30°，CU与MCU之间景别变化一档，满足跳切依据。", "镜号25/33/41为单人LS环境建立镜，米迦尔位于场地中部偏左，作为段落呼吸点，不改变人物银幕方向。", "镜号29/37/45为双人MS，作为节拍支点；镜号32/40/48为MLS段末收束镜，人物位置与前一镜一致，仅机位后撤放宽。", "本段无对白（对白集中在节点7–8），所有镜头时长按分镜表声明值执行，末尾保留12帧收尾余量。", "道具：账本在镜号34–40间由伊恩递至米迦尔手中，镜号40时已合上；包裹未在本段出现，保持场外待用状态。", "本段只提交镜号49–64，镜号、镜别、时长、出场角色与台词文本均沿用分镜表声明，未作改动。", "轴线：以米迦尔—伊恩连线为关系轴，A侧机位覆盖米迦尔（面朝画面右），B侧机位覆盖伊恩（面朝画面左）；全段机位不越轴，握手与告别同侧拍摄。", "相邻镜头满足30°规则：49(L.S.)→50(M.S.)→51(MCU,换机位至伊恩侧)→52(MCU,换机位至米迦尔侧)→53(M.S.)→54(M.S.,换机位)→55(CU)→56(MLS)→57(LS)→58(MS)→59(MCU)→60(MCU)→61(MS)→62(CU)→63(MLS)→64(LS)，景别或角度至少变化一档。", "对白按分镜表声明归属：镜号50–55为节点7告别的6句，镜号58–64为节点8尾声的4句；每句对白的时长预算已含12帧收尾余量。", "道具连续性：包裹自镜号50起在伊恩手中，镜号54交接至米迦尔，镜号56–57随米迦尔离场；账本为仓库段遗留道具，本段不出现。", "待确认项（保留原剧本标注）：镜号58「两人的影子还在」与镜号60、63的时空连续性；「我先上船」与镜号54「伊恩转身走向船」的主体归属；前六节点是否全为无对白段落。", "角色位置连续性：米迦尔始终位于画面右区、伊恩位于左区；镜号57后米迦尔向画面右后景走远，镜号63伊恩在船头回望画面右。"], "shots": [{"shot_id": "shot_001", "order": 1, "intent": "建立场景，交代市场全貌", "shot_type": "LS", "duration_frames": 72, "characters": ["米迦尔"], "dialogue_ids": [], "actions": [], "dialogues": [], "prompt": "远景建立镜头：第十四街区码头市场午后全貌。阳光斜照，市场棚架与货筐沿摊位长桌一路排开，往来人群在摊间穿行；画面深处是码头海面与远处船桅。米迦尔背对镜头立于画面左侧前景，面向摊位长桌，身形在人群中略作停顿，目光扫过摊位与码头方向；画面右侧通道留出伊恩即将入画的空位，确立他位于画面右侧的轴线起点。50mm 广角，轻微手持呼吸感，日光为主光，色调偏暖，空气中带海港尘雾。", "camera": {"side": "back", "lens": 50}, "axis_note": "建立镜头，确立米迦尔面向摊位、伊恩在画面右侧的轴线起点", "continuity_in": "开场，无前置镜头", "gaze": [{"from": "米迦尔", "to": "伊恩"}, {"from": "伊恩", "to": "米迦尔"}], "vfx": [], "declared_duration_frames": 0, "declared_shot_number": 1, "declared_camera_move": "static", "intent_type": "揭示", "dialogue_pins": [], "beats": [{"t": 0.05, "subject": "米迦尔", "verb": "walk_to", "target": "摊位长桌", "face_to": "away", "pace": "slow"}, {"t": 0.45, "subject": "米迦尔", "verb": "turn_head", "target": "码头海面与远处船桅", "face_to": "screen_right", "pace": "slow"}, {"t": 0.8, "subject": "米迦尔", "verb": "look_at", "target": "码头海面与远处船桅", "face_to": "screen_right"}], "composition": {"rule": "thirds", "subject_position": "left_third"}, "rule_justifications": [{"rule": "AXIS_RULE", "action": "follow", "reason": "本镜为建立镜头，米迦尔面向摊位长桌、伊恩预留画面右侧，轴线起点明确，机位固定不越轴。"}, {"rule": "INTENT_PACK", "action": "follow", "reason": "计划指定 shot_size=LS 的建立镜头，固定机位、无推拉摇移，符合揭示类意图的稳定呈现。"}]}, {"shot_id": "shot_002", "order": 2, "intent": "交代两位主角的位置关系", "shot_type": "MS", "duration_frames": 96, "characters": ["米迦尔", "伊恩"], "dialogue_ids": [], "actions": [], "dialogues": [], "prompt": "中景双人同框：米迦尔位于画面左侧三分线，伊恩位于画面右侧三分线，两人相对而立、视线交汇；米迦尔面朝画面右方，伊恩面朝画面左方，形成正反打；米迦尔视线前方（画面右）留出空间。", "camera": {"side": "front_left", "lens": 35}, "axis_note": "机位落在两人连线一侧，米迦尔居左、伊恩居右，确立180°轴线", "continuity_in": "承接全貌，切至两人关系的中景", "gaze": [{"from": "米迦尔", "to": "伊恩"}, {"from": "伊恩", "to": "米迦尔"}], "vfx": [], "declared_duration_frames": 0, "declared_shot_number": 2, "declared_camera_move": "static", "intent_type": "铺垫", "dialogue_pins": [], "beats": [{"t": 0.1, "subject": "米迦尔", "verb": "turn_body", "target": "码头海面与远处船桅", "face_to": "screen_left", "pace": "slow"}, {"t": 0.2, "subject": "伊恩", "verb": "turn_head", "target": "米迦尔", "face_to": "screen_left"}, {"t": 0.45, "subject": "伊恩", "verb": "turn_body", "target": "米迦尔", "face_to": "screen_left", "pace": "slow"}, {"t": 0.7, "subject": "米迦尔", "verb": "look_at", "target": "伊恩", "face_to": "screen_right"}], "composition": {"rule": "thirds", "subject_position": "left_third"}, "rule_justifications": [{"rule": "R012 正反打", "action": "follow", "reason": "两人相对而立，屏幕朝向相反，形成正反打关系"}, {"rule": "R019 银幕方向", "action": "follow", "reason": "米迦尔保持与 shot_001 相同的银幕侧（画面左），不翻转方向"}]}, {"shot_id": "shot_003", "order": 3, "intent": "推进对话", "shot_type": "MS", "duration_frames": 72, "characters": ["米迦尔"], "dialogue_ids": [], "actions": [], "dialogues": [], "prompt": "中景，米迦尔侧身站在摊位前，视线偏向摊位方向，背景摊架虚化。", "camera": {}, "axis_note": "仍在轴线同侧，景别收一档，米迦尔保持画面左侧位置", "continuity_in": "由双人中景切至米迦尔单人中景", "gaze": [{"from": "米迦尔", "to": "伊恩"}, {"from": "伊恩", "to": "米迦尔"}], "vfx": [], "declared_duration_frames": 0, "declared_shot_number": 3, "declared_camera_move": "static", "intent_type": "推进", "dialogue_pins": [], "beats": [], "composition": {}, "rule_justifications": []}, {"shot_id": "shot_004", "order": 4, "intent": "推进对话", "shot_type": "MCU", "duration_frames": 72, "characters": ["米迦尔"], "dialogue_ids": [], "actions": [], "dialogues": [], "prompt": "中近景，米迦尔位于画面偏右三分之一处，机位从米迦尔侧前方约三十度外切入，平视，85mm 长焦压缩码头市场背景：摊位长桌与货筐在后景虚化，远处船桅与海面成一条淡淡的地平线，往来人群只留模糊轮廓。米迦尔面向画面右方（越轴另一侧的方向），视线越过画框右缘，像在看着码头方向的同伴。镜头以极缓的推近（dolly_in）收紧到他的面部，他先侧头略微转向画面右，随后短暂点头，下颌收住，神情克制。午后硬光从棚架缝隙落下，在他脸侧形成一道亮边。整体运动与静止对比：背景人群流动，主体几乎不动，只有呼吸与一次点头。", "camera": {"side": "front_right", "lens": 85}, "axis_note": "机位略偏至米迦尔侧前方，角度变化超过30°，视线方向仍指向画面右", "continuity_in": "同侧小幅变机位，景别收紧至中近景", "gaze": [{"from": "米迦尔", "to": "码头海面与远处船桅"}], "vfx": [], "declared_duration_frames": 0, "declared_shot_number": 4, "declared_camera_move": "static", "intent_type": "推进", "dialogue_pins": [], "beats": [{"t": 0.0, "subject": "米迦尔", "verb": "turn_head", "target": "码头海面与远处船桅", "face_to": "screen_right", "pace": "slow"}, {"t": 0.35, "subject": "米迦尔", "verb": "look_at", "target": "码头海面与远处船桅", "face_to": "screen_right", "pace": "slow"}, {"t": 0.7, "subject": "米迦尔", "verb": "nod", "target": "码头海面与远处船桅", "face_to": "screen_right", "pace": "slow"}], "composition": {"rule": "thirds", "subject_position": "right_third"}, "rule_justifications": [{"rule": "SHOT_PATTERN", "action": "follow", "reason": "本镜按计划为中近景 MCU，采用 85mm 长焦，固定为主仅加极缓推近；未使用 ECU。"}, {"rule": "STAGING_PACK", "action": "follow", "reason": "平视角度，米迦尔置于右三分之一，画面左侧留出码头方向的负空间以平衡。"}, {"rule": "INTENT_PACK", "action": "follow", "reason": "本镜意图为推进对话，MCU 配 dolly_in，用缓慢推近把压力压到米迦尔脸上，比 MS 固定更贴切。"}, {"rule": "AXIS_RULE", "action": "follow", "reason": "机位仍在米迦尔侧前方同侧，未跨越关系轴，视线方向保持指向画面右，与前后镜的视线匹配。"}]}, {"shot_id": "shot_005", "order": 5, "intent": "给出反应", "shot_type": "MCU", "duration_frames": 96, "characters": ["伊恩"], "dialogue_ids": [], "actions": [], "dialogues": [], "prompt": "中近景，镜头缓缓推近伊恩，他面向画外左侧的米迦尔，沉默地听着。", "camera": {"movements": [{"type": "dolly_in"}]}, "axis_note": "反打机位越过轴线另一侧，伊恩视线朝画面左，与米迦尔视线相对", "continuity_in": "反打，伊恩由画面右转为主体", "gaze": [{"from": "米迦尔", "to": "伊恩"}, {"from": "伊恩", "to": "米迦尔"}], "vfx": [], "declared_duration_frames": 0, "declared_shot_number": 5, "declared_camera_move": "dolly_in", "intent_type": "推进", "dialogue_pins": [], "beats": [], "composition": {}, "rule_justifications": []}, {"shot_id": "shot_006", "order": 6, "intent": "铺垫冲突", "shot_type": "MS", "duration_frames": 72, "characters": ["米迦尔", "伊恩"], "dialogue_ids": [], "actions": [{"character_id": "米迦尔", "action_type": "turn_body", "start_frame": 1, "end_frame": 20, "params": {"angle_deg": 55}}, {"character_id": "伊恩", "action_type": "turn_body", "start_frame": 1, "end_frame": 20, "params": {"angle_deg": -55}}, {"character_id": "米迦尔", "action_type": "look_at", "start_frame": 20, "end_frame": 60, "params": {"yaw_deg": -20, "pitch_deg": 0}}], "dialogues": [{"character_id": "米迦尔", "text": "我先上船。", "start_frame": 1, "end_frame": 40}], "prompt": "第十四街区码头市场，午后。双人中景，米迦尔在画面左侧、伊恩在画面右侧，两人隔着摊位长桌相对而立，维持上一镜反打建立的关系机位。米迦尔身体微微前倾、下颌绷紧，抢先开口；伊恩侧身半步，目光追着米迦尔，欲言又止。背景是市场棚架与货筐、往来人群的虚影，远处码头海面与船桅在景深末端。镜头固定不动，35mm 广角中景，自然午后硬光带轻微头顶余量，人物之间留出可被打破的静止张力——为下一拍冲突蓄势。", "camera": {"side": "front", "lens": 50}, "axis_note": "回到两人关系机位，维持米迦尔左、伊恩右的银幕方向", "continuity_in": "由伊恩反打切回双人中景", "gaze": [{"from": "米迦尔", "to": "伊恩"}], "vfx": [], "declared_duration_frames": 0, "declared_shot_number": 6, "declared_camera_move": "static", "intent_type": "铺垫", "dialogue_pins": [], "beats": [{"t": 0.0, "subject": "米迦尔", "verb": "body_tilt", "target": "摊位长桌", "face_to": "screen_right", "pace": "normal"}, {"t": 0.15, "subject": "米迦尔", "verb": "turn_head", "target": "伊恩", "face_to": "screen_right", "pace": "normal"}, {"t": 0.4, "subject": "伊恩", "verb": "turn_head", "target": "米迦尔", "face_to": "screen_left", "pace": "slow"}, {"t": 0.55, "subject": "伊恩", "verb": "nod", "target": "米迦尔", "face_to": "screen_left", "pace": "slow"}], "composition": {"rule": "thirds", "subject_position": "right_third"}, "rule_justifications": [{"rule": "SHOT_PATTERN", "action": "follow", "reason": "计划指定 MS 中景、35mm 焦距与固定机位，仅以极轻微手持呼吸感维持画面活性，未使用被禁的 dolly_in。"}, {"rule": "AXIS_RULE", "action": "follow", "reason": "由伊恩反打切回双人关系机位，米迦尔保持在画面左侧、伊恩在画面右侧，轴线侧向维持 neutral，不越轴。"}, {"rule": "INTENT_PACK", "action": "follow", "reason": "本镜 intent 为铺垫，采用 MS 景别与固定机位，以静止构图累积两人之间的冲突压力。"}]}, {"shot_id": "shot_007", "order": 7, "intent": "留白", "shot_type": "CU", "duration_frames": 48, "characters": ["伊恩"], "dialogue_ids": [], "actions": [], "dialogues": [], "prompt": "近景（CU），50mm 定焦，平视，机位在轴线同侧前左方，固定不动。画面主体是伊恩：他占据画面右三分位置，视线朝画面左侧，望向码头海面与远处船桅；左侧留出大片空景作为留白，只有午后市场的光与空气。头顶留白约画面高度 5%。他沉默不动，只有眼神里的一点迟疑——不说话，不动作，让沉默停在画面里。背景是码头市场：摊位长桌、市场棚架与货筐、往来人群的虚焦轮廓，海面与船桅在远处泛白。整体是静帧式的克制，与前后镜头的运动形成对照。", "camera": {"side": "front_left", "lens": 50}, "axis_note": "轴线同侧收紧至近景，伊恩视线方向保持朝画面左", "continuity_in": "由双人中景跳紧至伊恩近景，强调沉默", "gaze": [{"from": "伊恩", "to": "码头海面与远处船桅"}], "vfx": [], "declared_duration_frames": 0, "declared_shot_number": 7, "declared_camera_move": "static", "intent_type": "留白", "dialogue_pins": [], "beats": [{"t": 0.0, "subject": "伊恩", "verb": "look_at", "target": "码头海面与远处船桅", "face_to": "screen_left", "pace": "slow"}, {"t": 0.5, "subject": "伊恩", "verb": "turn_head", "target": "码头海面与远处船桅", "face_to": "screen_left", "pace": "slow"}], "composition": {"rule": "lead_room", "subject_position": "right_third"}, "rule_justifications": [{"rule": "comp_headroom", "action": "follow", "reason": "伊恩近景头顶留白收在约5%，符合特写3%~12%区间，不憋闷也不下坠。"}, {"rule": "AXIS_RULE", "action": "follow", "reason": "机位保持在轴线同侧（front_left），伊恩视线方向仍朝画面左，越轴禁令下选择固定机位收紧。"}, {"rule": "INTENT_PACK", "action": "follow", "reason": "本镜 intent=留白，采用固定机位、不做运动，把沉默留给观众。"}, {"rule": "SHOT_PATTERN", "action": "break", "reason": "计划明确要求由双人中景跳紧至伊恩近景（CU）以强调沉默，因此有意违反该模式对 CU 的禁用，用景别跳切制造停顿感。", "precedent": "case_what-is-an-establishing-shot-definition-examples_007"}, {"rule": "cine_static_contrast", "action": "follow", "reason": "前序镜头为运动铺垫，此处用完全静止的特写作为参照系，让沉默本身成为节奏重音。"}]}, {"shot_id": "shot_008", "order": 8, "intent": "段末收束", "shot_type": "MS", "duration_frames": 48, "characters": ["米迦尔"], "dialogue_ids": [], "actions": [], "dialogues": [], "prompt": "中景，米迦尔独自站在摊位前，缓缓转身背向摊位，画面留出大片空白。", "camera": {}, "axis_note": "机位回到米迦尔一侧，景别放宽一档，米迦尔转身方向朝画面右后", "continuity_in": "由伊恩近景切回米迦尔中景，完成段落收束", "gaze": [{"from": "米迦尔", "to": "伊恩"}, {"from": "伊恩", "to": "米迦尔"}], "vfx": [], "declared_duration_frames": 0, "declared_shot_number": 8, "declared_camera_move": "static", "intent_type": "收束", "dialogue_pins": [], "beats": [], "composition": {}, "rule_justifications": []}, {"shot_id": "shot_009", "order": 9, "intent": "推进主线", "shot_type": "MS", "duration_frames": 96, "characters": ["米迦尔", "伊恩"], "dialogue_ids": [], "actions": [{"character_id": "米迦尔", "action_type": "turn_body", "start_frame": 1, "end_frame": 24, "params": {"angle_deg": 35}}, {"character_id": "米迦尔", "action_type": "look_at", "start_frame": 25, "end_frame": 48, "params": {"yaw_deg": 20, "pitch_deg": -5}}, {"character_id": "伊恩", "action_type": "turn_head", "start_frame": 30, "end_frame": 50, "params": {"angle_deg": 25}}, {"character_id": "伊恩", "action_type": "walk_to", "start_frame": 52, "end_frame": 78, "target_position": [6.5, -6.2, 4.5], "params": {"speed": "walk", "from": [6.9, -6.6, 4.5], "to": [6.5, -6.2, 4.5], "bob": 0.03}}, {"character_id": "米迦尔", "action_type": "nod", "start_frame": 70, "end_frame": 82, "params": {"cycles": 1}}, {"character_id": "伊恩", "action_type": "nod", "start_frame": 84, "end_frame": 94, "params": {"cycles": 1}}], "dialogues": [], "prompt": "中景双人镜头，码头市场午后。米迦尔在画面左侧、伊恩在画面右侧，两人隔着摊位长桌同框，轴线保持不越。米迦尔转身后重新站定，侧身倾向码头海面方向，目光越过伊恩投向远处船桅；伊恩微微转向他，视线跟上。背景是市场棚架与货筐、往来人群，远处海面与船桅在景深后段。相机从双人关系机位以 push_through 缓慢前推，35mm，电影感头顶留白，把两人从环境里逐渐剥离出来，推进主线。", "camera": {"side": "front_left", "lens": 35}, "axis_note": "双人关系机位，米迦尔左、伊恩右，轴线不变", "continuity_in": "承接转身动作，重新建立两人同框", "gaze": [{"from": "米迦尔", "to": "伊恩"}, {"from": "伊恩", "to": "米迦尔"}], "vfx": [], "declared_duration_frames": 0, "declared_shot_number": 9, "declared_camera_move": "static", "intent_type": "推进", "dialogue_pins": [], "beats": [{"t": 0.05, "subject": "米迦尔", "verb": "turn_body", "target": "伊恩", "face_to": "screen_right", "pace": "normal"}, {"t": 0.2, "subject": "米迦尔", "verb": "look_at", "target": "码头海面与远处船桅", "face_to": "screen_right"}, {"t": 0.3, "subject": "伊恩", "verb": "turn_head", "target": "米迦尔", "face_to": "screen_left"}, {"t": 0.45, "subject": "伊恩", "verb": "walk_to", "target": "摊位长桌", "face_to": "screen_left", "pace": "slow"}, {"t": 0.7, "subject": "米迦尔", "verb": "nod", "target": "伊恩", "face_to": "screen_right"}, {"t": 0.88, "subject": "伊恩", "verb": "nod", "target": "米迦尔", "face_to": "screen_left"}], "composition": {"rule": "thirds", "subject_position": "left_third"}, "rule_justifications": [{"rule": "SHOT_PATTERN", "action": "follow", "reason": "本镜为 MS 中景，采用 35mm 镜头并以 push_through 缓慢前推，符合该模式对景别、焦距与运动的要求，且未使用被禁的 orbit_cw。"}, {"rule": "INTENT_PACK", "action": "follow", "reason": "intent=推进 的 MS 镜头同时存在固定与 push_through 两条规则，取更具体的 push_through 执行，用缓慢前推推送主线信息。"}, {"rule": "AXIS_RULE", "action": "follow", "reason": "双人关系机位保持米迦尔左、伊恩右，机位不越轴，符合 neutral 轴侧要求。"}]}, {"shot_id": "shot_010", "order": 10, "intent": "推进主线", "shot_type": "MCU", "duration_frames": 72, "characters": ["伊恩"], "dialogue_ids": [], "actions": [], "dialogues": [], "prompt": "中近景，伊恩面向画外左侧开口说话，肩线略侧，背景是虚化的摊位与人群。", "camera": {}, "axis_note": "反打机位，伊恩视线朝画面左，与米迦尔视线方向相对", "continuity_in": "由双人中景切至伊恩中近景", "gaze": [{"from": "米迦尔", "to": "伊恩"}, {"from": "伊恩", "to": "米迦尔"}], "vfx": [], "declared_duration_frames": 0, "declared_shot_number": 10, "declared_camera_move": "static", "intent_type": "推进", "dialogue_pins": [], "beats": [], "composition": {}, "rule_justifications": []}, {"shot_id": "shot_011", "order": 11, "intent": "推进主线", "shot_type": "MCU", "duration_frames": 72, "characters": ["米迦尔"], "dialogue_ids": [], "actions": [], "dialogues": [], "prompt": "中近景，米迦尔面向画外右侧回应，下颌微抬，侧光勾出面部轮廓。", "camera": {}, "axis_note": "机位回到米迦尔一侧，视线朝画面右，与伊恩形成对视轴线", "continuity_in": "由伊恩中近景切至米迦尔中近景，正反打对位", "gaze": [{"from": "米迦尔", "to": "伊恩"}, {"from": "伊恩", "to": "米迦尔"}], "vfx": [], "declared_duration_frames": 0, "declared_shot_number": 11, "declared_camera_move": "static", "intent_type": "推进", "dialogue_pins": [], "beats": [], "composition": {}, "rule_justifications": []}, {"shot_id": "shot_012", "order": 12, "intent": "转折", "shot_type": "MCU", "duration_frames": 72, "characters": ["伊恩"], "dialogue_ids": [], "actions": [{"character_id": "伊恩", "action_type": "look_at", "start_frame": 1, "end_frame": 30, "params": {"yaw_deg": -22, "pitch_deg": -4}}, {"character_id": "伊恩", "action_type": "turn_head", "start_frame": 32, "end_frame": 48, "params": {"angle_deg": -14}}, {"character_id": "伊恩", "action_type": "nod", "start_frame": 52, "end_frame": 62, "params": {"cycles": 1}}], "dialogues": [], "prompt": "反打中近景（MCU），85mm 固定机位，平视。伊恩位于画面右三分处，面朝画面左，背景是码头海面与远处船桅，市场棚架与货筐在焦外虚化。他在镜头中段眼神由游移转为决然，末段轻轻点头，身后往来人群虚化流动。长焦压缩空间，浅景深，午后硬光在面部形成柔和侧光。", "camera": {"side": "front_right", "lens": 85}, "axis_note": "反打机位保持，伊恩视线朝画面左，眼神变化构成转折", "continuity_in": "与米迦尔中近景对切，景别不变、角度反打", "gaze": [{"from": "伊恩", "to": "码头海面与远处船桅"}], "vfx": [], "declared_duration_frames": 0, "declared_shot_number": 12, "declared_camera_move": "static", "intent_type": "转折", "dialogue_pins": [], "beats": [{"t": 0.0, "subject": "伊恩", "verb": "look_at", "target": "码头海面与远处船桅", "face_to": "screen_left", "pace": "slow"}, {"t": 0.45, "subject": "伊恩", "verb": "turn_head", "target": "码头海面与远处船桅", "face_to": "screen_left", "pace": "slow"}, {"t": 0.7, "subject": "伊恩", "verb": "nod", "target": "码头海面与远处船桅", "face_to": "screen_left", "pace": "slow"}], "composition": {"rule": "lead_room", "subject_position": "right_third"}, "rule_justifications": [{"rule": "SHOT_PATTERN", "action": "follow", "reason": "本镜为反打中近景，85mm 长焦压缩背景、固定机位保持与米迦尔镜头的对切节奏；不使用 ECU。"}, {"rule": "STAGING_PACK", "action": "follow", "reason": "MCU 平视机位，用平衡构图承载伊恩的视线变化。"}, {"rule": "AXIS_RULE", "action": "follow", "reason": "与米迦尔镜头保持同一轴线反打，伊恩视线朝画面左，不越轴。"}, {"rule": "INTENT_PACK", "action": "follow", "reason": "转折意图要求固定机位；本镜以 MCU 承载伊恩眼神由犹疑到决意的转折，比 MS 更贴近内心变化，故按更具体者优先采用 MCU。"}]}, {"shot_id": "shot_013", "order": 13, "intent": "转折", "shot_type": "MS", "duration_frames": 72, "characters": ["米迦尔", "伊恩"], "dialogue_ids": [], "actions": [{"character_id": "米迦尔", "action_type": "turn_body", "start_frame": 1, "end_frame": 24, "params": {"angle_deg": 30}}, {"character_id": "伊恩", "action_type": "turn_head", "start_frame": 26, "end_frame": 44, "params": {"angle_deg": 28}}, {"character_id": "米迦尔", "action_type": "look_at", "start_frame": 46, "end_frame": 58, "params": {"yaw_deg": -20, "pitch_deg": -4}}, {"character_id": "伊恩", "action_type": "nod", "start_frame": 60, "end_frame": 70, "params": {"cycles": 1}}], "dialogues": [{"character_id": "伊恩", "text": "等等我。", "start_frame": 24, "end_frame": 56}], "prompt": "码头市场午后，双人中景。米迦尔在画面左侧、伊恩在画面右侧，两人隔着摊位长桌相对；背景是市场棚架与货筐、往来人群，远处可见码头海面与船桅。镜头由伊恩的中近景放宽为双人中景，交代空间关系的变化。米迦尔先侧身转向码头方向，伊恩随后转头看向米迦尔，两人目光相接——这是转折的一刻：伊恩第一次决定听从米迦尔。固定机位，35mm，自然头肩留白，柔和午后顶光。", "camera": {"side": "front_left", "lens": 35}, "axis_note": "双人机位维持轴线同侧，两人左右关系不变", "continuity_in": "由伊恩中近景放宽至双人中景，交代空间变化", "gaze": [{"from": "米迦尔", "to": "伊恩"}, {"from": "伊恩", "to": "米迦尔"}], "vfx": [], "declared_duration_frames": 0, "declared_shot_number": 13, "declared_camera_move": "static", "intent_type": "转折", "dialogue_pins": [], "beats": [{"t": 0.0, "subject": "米迦尔", "verb": "turn_body", "target": "码头海面与远处船桅", "face_to": "screen_left", "pace": "normal"}, {"t": 0.35, "subject": "伊恩", "verb": "turn_head", "target": "米迦尔", "face_to": "screen_left", "pace": "slow"}, {"t": 0.6, "subject": "米迦尔", "verb": "look_at", "target": "伊恩", "face_to": "screen_right", "pace": "slow"}, {"t": 0.85, "subject": "伊恩", "verb": "nod", "target": "米迦尔", "pace": "slow"}], "composition": {"rule": "thirds", "subject_position": "left_third"}, "rule_justifications": [{"rule": "SHOT_PATTERN", "action": "follow", "reason": "计划指定 MS 双人中景，35mm 固定机位；仅以轻微 dolly_out 完成由伊恩中近景放宽至双人的空间交代，未使用被禁的 dolly_in。"}, {"rule": "AXIS_RULE", "action": "follow", "reason": "双人机位维持轴线同侧（front_left），米迦尔始终在画面左、伊恩在画面右，左右关系不变。"}, {"rule": "INTENT_PACK", "action": "follow", "reason": "intent=转折，采用 MS + 固定机位；机位不做越轴或大幅运动，仅用放宽景别承载'伊恩第一次听从'的转折点。"}]}, {"shot_id": "shot_014", "order": 14, "intent": "反应", "shot_type": "CU", "duration_frames": 48, "characters": ["米迦尔"], "dialogue_ids": [], "actions": [], "dialogues": [], "prompt": "特写（CU），米迦尔单人。午后码头市场的光线从画面右侧的棚架缝隙斜射进来，在他脸侧形成一道柔和的轮廓光，背景是虚化的市场棚架与货筐暖色轮廓。米迦尔位于画面左三分线上，面部朝画面右方，为右侧留出视线空间；他先是目光沉静地望向画面右方的码头海面与远处船桅，随后极缓地把头转正少许又定住，最后轻轻点了一下头，像是对自己下了决心。机位在轴线同侧、front_right 侧的近景高度，50mm 镜头，全镜几乎静止，只有极轻微的前推，把呼吸般的克制情绪压在这一张脸上。跳紧自上一镜的双人中景，作为一次停顿。", "camera": {"side": "front_right", "lens": 50}, "axis_note": "轴线同侧收紧至近景，米迦尔视线仍朝画面右", "continuity_in": "由双人中景跳紧至米迦尔近景，作为停顿", "gaze": [{"from": "米迦尔", "to": "伊恩"}, {"from": "伊恩", "to": "米迦尔"}], "vfx": [], "declared_duration_frames": 0, "declared_shot_number": 14, "declared_camera_move": "static", "intent_type": "停顿", "dialogue_pins": [], "beats": [{"t": 0.0, "subject": "米迦尔", "verb": "look_at", "target": "码头海面与远处船桅", "face_to": "screen_right", "pace": "slow"}, {"t": 0.35, "subject": "米迦尔", "verb": "turn_head", "target": "码头海面与远处船桅", "face_to": "screen_right", "pace": "slow"}, {"t": 0.7, "subject": "米迦尔", "verb": "nod", "target": "码头海面与远处船桅", "face_to": "screen_right", "pace": "slow"}], "composition": {"rule": "lead_room", "subject_position": "left_third"}, "rule_justifications": [{"rule": "AXIS_RULE", "action": "follow", "reason": "米迦尔保持在轴线同侧，视线仍朝画面右，与前一镜双人中景的银幕方向一致，跳紧后不产生越轴混乱。"}, {"rule": "INTENT_PACK", "action": "follow", "reason": "本镜为停顿/反应镜，采用固定机位加极轻微前推的 CU，符合 intent:停顿 的景别与运动要求。"}, {"rule": "comp_framing", "action": "follow", "reason": "特写只取米迦尔面部与肩线，主体占比与 CU 声明一致，避免误读为半身。"}]}, {"shot_id": "shot_015", "order": 15, "intent": "过渡", "shot_type": "MS", "duration_frames": 72, "characters": ["伊恩"], "dialogue_ids": [], "actions": [{"character_id": "伊恩", "action_type": "look_at", "start_frame": 1, "end_frame": 20, "params": {"yaw_deg": 18, "pitch_deg": -4}}, {"character_id": "伊恩", "action_type": "turn_head", "start_frame": 24, "end_frame": 40, "params": {"angle_deg": 10}}, {"character_id": "伊恩", "action_type": "body_tilt", "start_frame": 44, "end_frame": 60, "params": {"angle_deg": 5, "axis": "x", "toward": "screen_left"}}], "dialogues": [], "prompt": "中景（MS），35mm，午后第十四街区码头市场。伊恩单独站在画面右三分之一处，身体朝向画面左侧的码头海面与远处船桅，背景是市场棚架与货筐、摊位长桌以及往来人群的虚化轮廓。机位位于伊恩前左方（front_left），略低于视平线，保持伊恩在画面右侧，景别自上一镜米迦尔近景放宽至此，完成由近及远的过渡。镜头以缓慢的 push_through 向伊恩方向推进约 0.6 米，同时伊恩先抬眼望向远处的船桅，随后头部微微转向画左，最后身体极轻地前倾，透出等待与迟疑。海面反光柔和，天光偏暖，人物轮廓清晰，环境层次分明，cinematic 头顶留白。", "camera": {"side": "front_left", "lens": 35}, "axis_note": "机位回到伊恩一侧，景别放宽，伊恩保持画面右位置", "continuity_in": "由米迦尔近景切至伊恩中景，完成过渡", "gaze": [{"from": "伊恩", "to": "码头海面与远处船桅"}], "vfx": [], "declared_duration_frames": 0, "declared_shot_number": 15, "declared_camera_move": "static", "intent_type": "推进", "dialogue_pins": [], "beats": [{"t": 0.0, "subject": "伊恩", "verb": "look_at", "target": "码头海面与远处船桅", "face_to": "screen_left", "pace": "slow"}, {"t": 0.35, "subject": "伊恩", "verb": "turn_head", "target": "码头海面与远处船桅", "face_to": "screen_left", "pace": "slow"}, {"t": 0.6, "subject": "伊恩", "verb": "body_tilt", "target": "码头海面与远处船桅", "face_to": "screen_left", "pace": "slow"}], "composition": {"rule": "thirds", "subject_position": "right_third"}, "rule_justifications": [{"rule": "shot_size=shot_size:MS lens=lens:35mm movement=movement:push_through headroom_policy=cinematic", "action": "follow"}, {"rule": "intent=intent:推进 shot_size=shot_size:MS movement=push_through", "action": "follow"}, {"rule": "pair=any_two axis_side=neutral axis_topic=越轴", "action": "follow"}]}, {"shot_id": "shot_016", "order": 16, "intent": "段末收束", "shot_type": "MLS", "duration_frames": 72, "characters": ["米迦尔"], "dialogue_ids": [], "actions": [{"character_id": "米迦尔", "action_type": "turn_body", "start_frame": 28, "end_frame": 44, "params": {"angle_deg": 30}}, {"character_id": "米迦尔", "action_type": "look_at", "start_frame": 46, "end_frame": 60, "params": {"yaw_deg": 20, "pitch_deg": -5}}], "dialogues": [{"character_id": "米迦尔", "text": "我先上船。", "start_frame": 8, "end_frame": 48}], "prompt": "中远景（MLS），50mm，低机位。米迦尔位于画面左侧三分之一处，背对镜头或侧身，面向码头海面与远处船桅；摊位长桌与市场棚架、货筐在画面右侧构成环境层次，往来人群在远处稀疏散布。段落收束：米迦尔说完最后一句后，身体轻微转向船的方向，随后停住，镜头缓缓拉远（dolly_out 约1.2米），把人物重新放回码头环境中，留下松手般的余韵。光线为午后偏暖的侧逆光，海面反光柔和。", "camera": {"side": "back_left", "lens": 50}, "axis_note": "机位退远至轴线同侧，米迦尔仍处画面左侧", "continuity_in": "由伊恩中景切至米迦尔中远景，段落收束", "gaze": [{"from": "米迦尔", "to": "伊恩"}, {"from": "伊恩", "to": "米迦尔"}], "vfx": [], "declared_duration_frames": 0, "declared_shot_number": 16, "declared_camera_move": "static", "intent_type": "收束", "dialogue_pins": [], "beats": [{"t": 0.1, "subject": "米迦尔", "verb": "turn_head", "target": "码头海面与远处船桅", "face_to": "screen_left", "pace": "slow"}, {"t": 0.45, "subject": "米迦尔", "verb": "turn_body", "target": "码头海面与远处船桅", "face_to": "screen_left", "pace": "slow"}, {"t": 0.75, "subject": "米迦尔", "verb": "look_at", "target": "码头海面与远处船桅", "face_to": "screen_left"}], "composition": {"rule": "thirds", "subject_position": "left_third"}, "rule_justifications": [{"rule": "AXIS_RULE", "action": "follow", "reason": "机位退远至轴线同侧，米迦尔仍处画面左侧，不越轴。"}, {"rule": "INTENT_PACK", "action": "follow", "reason": "收束段落，采用固定机位为基础的缓慢拉远，符合收束意图。"}, {"rule": "SHOT_PATTERN", "action": "follow", "reason": "MLS 配 50mm，头room 按电影化留白处理。"}, {"rule": "STAGING_PACK", "action": "follow", "reason": "MLS 采用平衡构图，低机位拍摄。"}]}, {"shot_id": "shot_017", "order": 17, "intent": "建立环境", "shot_type": "LS", "duration_frames": 72, "characters": ["米迦尔"], "dialogue_ids": [], "actions": [{"character_id": "米迦尔", "action_type": "look_at", "start_frame": 6, "end_frame": 30, "params": {"yaw_deg": 35, "pitch_deg": -5}}, {"character_id": "米迦尔", "action_type": "turn_head", "start_frame": 36, "end_frame": 54, "params": {"angle_deg": 20}}], "dialogues": [], "prompt": "全景建立镜头：第十四街区码头市场，午后。摊位长桌横陈画面左侧，市场棚架与货筐层层叠向纵深，右侧远处是码头海面与船桅，往来人群在摊间穿行。米迦尔立于画面中景偏左，身形朝向画面右侧，望向码头与海面方向。50mm 焦距，固定机位，环境宽阔，人物被空间衬托得渺小，交代十四街区码头市场的整体空间关系。", "camera": {"side": "front_right", "lens": 50}, "axis_note": "环境镜头，重新交代空间，米迦尔朝向画面右侧", "continuity_in": "由中远景放宽至全景，开启新段落", "gaze": [{"from": "米迦尔", "to": "码头海面与远处船桅"}], "vfx": [], "declared_duration_frames": 0, "declared_shot_number": 17, "declared_camera_move": "static", "intent_type": "揭示", "dialogue_pins": [], "beats": [{"t": 0.1, "subject": "米迦尔", "verb": "look_at", "target": "码头海面与远处船桅", "face_to": "screen_right", "pace": "slow"}, {"t": 0.5, "subject": "米迦尔", "verb": "turn_head", "target": "摊位长桌", "face_to": "screen_right", "pace": "slow"}], "composition": {"rule": "thirds", "subject_position": "left_third"}, "rule_justifications": [{"rule": "AXIS_RULE", "action": "follow", "reason": "本镜为环境建立镜头，米迦尔保持朝向画面右侧，与前段落视线方向一致，不越轴。"}, {"rule": "INTENT_PACK", "action": "follow", "reason": "计划指定 intent=建立环境、shot_type=LS，以全景固定机位重新交代空间，符合意图包的景别与运动取向。"}]}, {"shot_id": "shot_018", "order": 18, "intent": "推进主线", "shot_type": "MS", "duration_frames": 96, "characters": ["米迦尔", "伊恩"], "dialogue_ids": [], "actions": [], "dialogues": [], "prompt": "中景，米迦尔与伊恩并肩站在码头边，两人一同望向海面方向。", "camera": {}, "axis_note": "双人机位，米迦尔左、伊恩右，两人朝向画面深处同一方向", "continuity_in": "由全景切至双人中景，站位延续", "gaze": [{"from": "米迦尔", "to": "伊恩"}, {"from": "伊恩", "to": "米迦尔"}], "vfx": [], "declared_duration_frames": 0, "declared_shot_number": 18, "declared_camera_move": "static", "intent_type": "推进", "dialogue_pins": [], "beats": [], "composition": {}, "rule_justifications": []}, {"shot_id": "shot_019", "order": 19, "intent": "情绪铺垫", "shot_type": "MCU", "duration_frames": 72, "characters": ["伊恩"], "dialogue_ids": [], "actions": [{"character_id": "伊恩", "action_type": "look_at", "start_frame": 1, "end_frame": 30, "params": {"yaw_deg": 8, "pitch_deg": -4}}, {"character_id": "伊恩", "action_type": "body_tilt", "start_frame": 30, "end_frame": 52, "params": {"angle_deg": 3, "axis": "x", "toward": "away"}}, {"character_id": "伊恩", "action_type": "turn_head", "start_frame": 52, "end_frame": 60, "params": {"angle_deg": 6}}], "dialogues": [], "prompt": "第十四街区码头市场，午后。中近景，85mm 定焦，平视。伊恩侧向机位站在摊位长桌旁，身体朝向画面深处，与米迦尔同向——视线越过长桌投向码头海面与远处船桅，往来人群在他身后虚化成流动的暖色块。他肩线微沉，下颌收紧，呼吸压得很浅：这是\"这一次我听你的\"之后的那口气，咽下去，没吐出来。镜头固定不动，只让海风掀动他的衣角与额发，把整场戏的运动全部留给下一镜。构图平衡，人物置于画面左三分之一，右侧留出他望出去的那片深景空间；背光边缘勾出轮廓，面部保持半明半暗。", "camera": {"side": "left", "lens": 85}, "axis_note": "伊恩侧向机位，视线朝画面深处，保持与米迦尔同向", "continuity_in": "由双人中景切至伊恩中近景", "gaze": [{"from": "伊恩", "to": "码头海面与远处船桅"}], "vfx": [], "declared_duration_frames": 0, "declared_shot_number": 19, "declared_camera_move": "static", "intent_type": "铺垫", "dialogue_pins": [], "beats": [{"t": 0.0, "subject": "伊恩", "verb": "look_at", "target": "码头海面与远处船桅", "face_to": "away", "pace": "slow"}, {"t": 0.35, "subject": "伊恩", "verb": "body_tilt", "target": "码头海面与远处船桅", "face_to": "away", "pace": "slow"}, {"t": 0.7, "subject": "伊恩", "verb": "turn_head", "target": "码头海面与远处船桅", "face_to": "screen_left", "pace": "slow"}], "composition": {"rule": "lead_room", "subject_position": "left_third"}, "rule_justifications": [{"rule": "SHOT_PATTERN", "action": "follow", "reason": "本镜为情绪铺垫，采用 MCU 中近景与 85mm 定焦、固定机位，符合景别与镜头规格约束。"}, {"rule": "STAGING_PACK", "action": "follow", "reason": "平视机位、平衡构图，人物置于左三分之一并朝画面深处留出空间，符合调度包要求。"}, {"rule": "AXIS_RULE", "action": "follow", "reason": "伊恩侧向机位、视线朝画面深处，与米迦尔保持同向，轴线关系为中性，未越轴。"}, {"rule": "INTENT_PACK", "action": "follow", "reason": "情绪铺垫镜头，取更具体的 MCU + 固定机位组合，避免与 MS 版本冲突。"}, {"rule": "cine_static_contrast", "action": "follow", "reason": "固定镜头作为运动参照系，把运动留给下一镜的转折，符合静态对比原则。"}]}, {"shot_id": "shot_020", "order": 20, "intent": "推进主线", "shot_type": "MCU", "duration_frames": 72, "characters": ["米迦尔"], "dialogue_ids": [], "actions": [], "dialogues": [], "prompt": "中近景，米迦尔侧脸望向海面，随后微微转头看向身旁的伊恩。", "camera": {}, "axis_note": "机位在米迦尔侧前方，角度与伊恩镜头相差超过30°", "continuity_in": "由伊恩中近景切至米迦尔中近景，视线方向一致", "gaze": [{"from": "米迦尔", "to": "伊恩"}, {"from": "伊恩", "to": "米迦尔"}], "vfx": [], "declared_duration_frames": 0, "declared_shot_number": 20, "declared_camera_move": "static", "intent_type": "推进", "dialogue_pins": [], "beats": [], "composition": {}, "rule_justifications": []}, {"shot_id": "shot_021", "order": 21, "intent": "冲突升级", "shot_type": "MS", "duration_frames": 72, "characters": ["米迦尔", "伊恩"], "dialogue_ids": [], "actions": [], "dialogues": [], "prompt": "中景，两人在码头边面对面站定，一左一右，海风从两人之间穿过。", "camera": {}, "axis_note": "双人机位回到轴线同侧，米迦尔左、伊恩右，形成对峙构图", "continuity_in": "由米迦尔中近景放宽至双人中景", "gaze": [{"from": "米迦尔", "to": "伊恩"}, {"from": "伊恩", "to": "米迦尔"}], "vfx": [], "declared_duration_frames": 0, "declared_shot_number": 21, "declared_camera_move": "static", "intent_type": "对抗", "dialogue_pins": [], "beats": [], "composition": {}, "rule_justifications": []}, {"shot_id": "shot_022", "order": 22, "intent": "冲突升级", "shot_type": "CU", "duration_frames": 72, "characters": ["伊恩"], "dialogue_ids": [], "actions": [], "dialogues": [], "prompt": "近景，伊恩的面部特写，语气加重，眉头收紧，背景海面高光虚化。", "camera": {}, "axis_note": "反打机位，伊恩视线朝画面左，与米迦尔对视", "continuity_in": "由双人中景跳紧至伊恩近景", "gaze": [{"from": "米迦尔", "to": "伊恩"}, {"from": "伊恩", "to": "米迦尔"}], "vfx": [], "declared_duration_frames": 0, "declared_shot_number": 22, "declared_camera_move": "static", "intent_type": "对抗", "dialogue_pins": [], "beats": [], "composition": {}, "rule_justifications": []}, {"shot_id": "shot_023", "order": 23, "intent": "留白", "shot_type": "CU", "duration_frames": 48, "characters": ["米迦尔"], "dialogue_ids": [], "actions": [], "dialogues": [], "prompt": "近景，米迦尔的面部特写，他沉默不语，眼神低垂，风掠过发梢。", "camera": {}, "axis_note": "机位回到米迦尔一侧，视线朝画面右，与伊恩近景对位", "continuity_in": "由伊恩近景切至米迦尔近景，正反打对切", "gaze": [{"from": "米迦尔", "to": "伊恩"}, {"from": "伊恩", "to": "米迦尔"}], "vfx": [], "declared_duration_frames": 0, "declared_shot_number": 23, "declared_camera_move": "static", "intent_type": "留白", "dialogue_pins": [], "beats": [], "composition": {}, "rule_justifications": []}, {"shot_id": "shot_024", "order": 24, "intent": "段末收束", "shot_type": "MLS", "duration_frames": 72, "characters": ["米迦尔", "伊恩"], "dialogue_ids": [], "actions": [], "dialogues": [], "prompt": "中远景，两人并肩站在码头边，海风吹过，身影被拉长，远处海面平静。", "camera": {}, "axis_note": "机位退远至轴线同侧，两人左右位置不变，完成段落收束", "continuity_in": "由米迦尔近景放宽至双人中远景，收束本段", "gaze": [{"from": "米迦尔", "to": "伊恩"}, {"from": "伊恩", "to": "米迦尔"}], "vfx": [], "declared_duration_frames": 0, "declared_shot_number": 24, "declared_camera_move": "static", "intent_type": "收束", "dialogue_pins": [], "beats": [], "composition": {}, "rule_justifications": []}, {"shot_id": "shot_025", "order": 1, "intent": "以单人全景交代第十四街区码头市场的空间与米迦尔的位置，作为本段开场转场", "shot_type": "LS", "duration_frames": 72, "characters": ["米迦尔"], "dialogue_ids": [], "actions": [], "dialogues": [], "prompt": "午后码头市场全景，米迦尔独自站在摊位之间，人流与遮阳布棚在身后展开，海面在远处泛光。", "camera": {}, "axis_note": "环境建立镜，机位在轴线一侧，米迦尔朝画面右方，确立其银幕方向。", "continuity_in": "承接上一段结尾，市场空间首次完整交代。", "gaze": [{"from": "米迦尔", "to": "伊恩"}, {"from": "伊恩", "to": "米迦尔"}], "vfx": [], "declared_duration_frames": 0, "declared_shot_number": 25, "declared_camera_move": "static", "intent_type": "铺垫", "dialogue_pins": [], "beats": [], "composition": {}, "rule_justifications": []}, {"shot_id": "shot_026", "order": 2, "intent": "双人中景展开米迦尔与伊恩的对话关系，推进主线", "shot_type": "MS", "duration_frames": 96, "characters": ["米迦尔", "伊恩"], "dialogue_ids": [], "actions": [], "dialogues": [], "prompt": "双人中景，米迦尔在左、伊恩在右隔着摊位相对，两人之间留有对话空间。", "camera": {}, "axis_note": "机位在轴线同侧，米迦尔左、伊恩右，确立本段正反打关系。", "continuity_in": "与镜号25同一空间，米迦尔位置不变，伊恩入画于其右侧。", "gaze": [{"from": "米迦尔", "to": "伊恩"}, {"from": "伊恩", "to": "米迦尔"}], "vfx": [], "declared_duration_frames": 0, "declared_shot_number": 26, "declared_camera_move": "static", "intent_type": "推进", "dialogue_pins": [], "beats": [], "composition": {}, "rule_justifications": []}, {"shot_id": "shot_027", "order": 3, "intent": "反打伊恩，突出其回应时的态度，推进主线", "shot_type": "MCU", "duration_frames": 72, "characters": ["伊恩"], "dialogue_ids": [], "actions": [], "dialogues": [], "prompt": "伊恩胸上中近景，侧身面向画面左方，背景是虚化的市场人流。", "camera": {}, "axis_note": "反打机位越过轴线同侧，伊恩仍朝画面左方，保持银幕方向连续。", "continuity_in": "接镜号26，伊恩保持原位与朝向。", "gaze": [{"from": "米迦尔", "to": "伊恩"}, {"from": "伊恩", "to": "米迦尔"}], "vfx": [], "declared_duration_frames": 0, "declared_shot_number": 27, "declared_camera_move": "static", "intent_type": "推进", "dialogue_pins": [], "beats": [], "composition": {}, "rule_justifications": []}, {"shot_id": "shot_028", "order": 4, "intent": "反打米迦尔，捕捉其对伊恩回应的即时反应", "shot_type": "MCU", "duration_frames": 72, "characters": ["米迦尔"], "dialogue_ids": [], "actions": [], "dialogues": [], "prompt": "米迦尔胸上中近景，面部朝向画面右方，神情克制。", "camera": {}, "axis_note": "与镜号27成对反打，机位角度变化大于30°，不越轴。", "continuity_in": "接镜号27，米迦尔保持原位与朝向。", "gaze": [{"from": "米迦尔", "to": "伊恩"}, {"from": "伊恩", "to": "米迦尔"}], "vfx": [], "declared_duration_frames": 0, "declared_shot_number": 28, "declared_camera_move": "static", "intent_type": "停顿", "dialogue_pins": [], "beats": [], "composition": {}, "rule_justifications": []}, {"shot_id": "shot_029", "order": 5, "intent": "双人中景承载本段情绪顶点，两人对立关系被推到最紧", "shot_type": "MS", "duration_frames": 72, "characters": ["米迦尔", "伊恩"], "dialogue_ids": [], "actions": [{"character_id": "米迦尔", "action_type": "turn_body", "start_frame": 4, "end_frame": 16, "params": {"angle_deg": 18}}, {"character_id": "伊恩", "action_type": "turn_body", "start_frame": 8, "end_frame": 20, "params": {"angle_deg": 15}}, {"character_id": "米迦尔", "action_type": "body_tilt", "start_frame": 22, "end_frame": 40, "params": {"angle_deg": 7, "axis": "x"}}, {"character_id": "伊恩", "action_type": "look_at", "start_frame": 32, "end_frame": 46, "params": {"yaw_deg": -12, "pitch_deg": 2}}, {"character_id": "米迦尔", "action_type": "nod", "start_frame": 54, "end_frame": 62, "params": {"cycles": 1}}, {"character_id": "伊恩", "action_type": "turn_head", "start_frame": 64, "end_frame": 72, "params": {"angle_deg": -10}}], "dialogues": [], "prompt": "双人中景，码头市场摊位长桌旁。米迦尔与伊恩分立长桌两侧，机位在轴线同侧后撤至中景，两人侧向对峙、距离被压到最近。米迦尔身体微前倾、下颌收紧，视线钉在伊恩脸上；伊恩肩线僵直、呼吸可见，回视不让。背景是市场棚架与货筐、往来人群虚影，远处码头海面与船桅透出午后硬光。镜头固定不动，让这段沉默与对峙自己发酵。", "camera": {"side": "front_right", "lens": 35}, "axis_note": "回到轴线同侧的双人机位，与镜号28的景别变化一档以上。", "continuity_in": "接镜号28，两人位置不变，仅机位后撤至双人景别。", "gaze": [{"from": "米迦尔", "to": "伊恩"}, {"from": "伊恩", "to": "米迦尔"}], "vfx": [], "declared_duration_frames": 0, "declared_shot_number": 29, "declared_camera_move": "static", "intent_type": "对抗", "dialogue_pins": [], "beats": [{"t": 0.05, "subject": "米迦尔", "verb": "turn_body", "target": "伊恩", "face_to": "screen_right", "pace": "slow"}, {"t": 0.1, "subject": "伊恩", "verb": "turn_body", "target": "米迦尔", "face_to": "screen_left", "pace": "slow"}, {"t": 0.3, "subject": "米迦尔", "verb": "body_tilt", "target": "伊恩", "face_to": "screen_right", "pace": "slow"}, {"t": 0.45, "subject": "伊恩", "verb": "look_at", "target": "米迦尔", "face_to": "screen_left", "pace": "normal"}, {"t": 0.75, "subject": "米迦尔", "verb": "nod", "target": "伊恩", "face_to": "screen_right", "pace": "slow"}, {"t": 0.9, "subject": "伊恩", "verb": "turn_head", "target": "米迦尔", "face_to": "screen_left", "pace": "slow"}], "composition": {"rule": "diagonal", "subject_position": "center"}, "rule_justifications": [{"rule": "SHOT_PATTERN", "action": "follow", "reason": "中景双人、35mm、机位固定，符合该镜头的景别与镜头语言约束。"}, {"rule": "AXIS_RULE", "action": "follow", "reason": "回到轴线同侧的双人机位，与镜号28保持同侧，未越轴。"}, {"rule": "INTENT_PACK", "action": "follow", "reason": "对抗意图下用中景固定机位承载情绪顶点，两人对立关系推到最紧。"}]}, {"shot_id": "shot_030", "order": 6, "intent": "用近景放大伊恩的情绪，将顶点压力集中在其面部", "shot_type": "CU", "duration_frames": 72, "characters": ["伊恩"], "dialogue_ids": [], "actions": [], "dialogues": [], "prompt": "近景特写，50mm，机位在轴线同侧的左前方，伊恩面部占据画面右侧三分之一，视线朝画面左侧望向码头海面与远处船桅。午后硬光从侧后方勾出轮廓，背景市场棚架与货筐虚化成暖调色块。他先是缓缓抬眼，随后极轻地转头，肩背微微前倾，最后几乎不可察觉地点了一下头——克制到极限的顶点压力全写在脸上。镜头缓慢变焦推近，全程机位稳定。", "camera": {"side": "front_left", "lens": 50}, "axis_note": "反打机位在轴线同侧，伊恩视线方向保持向左。", "continuity_in": "接镜号29，伊恩保持原位与朝向。", "gaze": [{"from": "伊恩", "to": "码头海面与远处船桅"}], "vfx": [], "declared_duration_frames": 0, "declared_shot_number": 30, "declared_camera_move": "static", "intent_type": "压迫", "dialogue_pins": [], "beats": [{"t": 0.0, "subject": "伊恩", "verb": "look_at", "target": "码头海面与远处船桅", "face_to": "screen_left", "pace": "slow"}, {"t": 0.25, "subject": "伊恩", "verb": "turn_head", "target": "码头海面与远处船桅", "face_to": "screen_left", "pace": "slow"}, {"t": 0.55, "subject": "伊恩", "verb": "body_tilt", "target": "码头海面与远处船桅", "face_to": "screen_left", "pace": "slow"}, {"t": 0.8, "subject": "伊恩", "verb": "nod", "target": "伊恩", "face_to": "camera", "pace": "slow"}], "composition": {"rule": "lead_room", "subject_position": "right_third"}, "rule_justifications": [{"rule": "AXIS_RULE", "action": "follow", "reason": "反打机位保持在轴线同侧，伊恩视线方向维持向左，越轴禁令未被触发。"}, {"rule": "INTENT_PACK", "action": "follow", "reason": "intent=揭示 要求 CU 且固定机位；本镜以近景放大伊恩面部并保持机位稳定，仅用轻微变焦强化压迫。"}, {"rule": "SHOT_PATTERN", "action": "break", "reason": "该模式要求 MS 且禁用 CU，但本镜的叙事目标是把顶点压力集中到伊恩面部，只有特写才能读出他克制到极限的表情细节；若退回中景，情绪顶点会被环境稀释。", "precedent": "case_extreme-close-up-shot-definition_005"}, {"rule": "comp_framing", "action": "follow", "reason": "主体占比按 CU 解算，面部充满画面，与声明的景别一致。"}]}, {"shot_id": "shot_031", "order": 7, "intent": "以米迦尔近景的静默留出情绪空白，让顶点余韵停留", "shot_type": "CU", "duration_frames": 48, "characters": ["米迦尔"], "dialogue_ids": [], "actions": [{"character_id": "米迦尔", "action_type": "look_at", "start_frame": 1, "end_frame": 20, "params": {"yaw_deg": -12, "pitch_deg": -3}}, {"character_id": "米迦尔", "action_type": "turn_head", "start_frame": 22, "end_frame": 40, "params": {"angle_deg": 14}}], "dialogues": [], "prompt": "米迦尔近景特写，平视机位，位于画面右三分，头顶留白约 5%。午后码头市场，身后虚化的市场棚架与货筐、往来人群。他静默不动，目光先落向画面左侧远处海面与船桅，随后极缓慢地把头转向画面右侧。固定镜头，无运动，48 帧，情绪空白，顶点余韵停留。50mm 镜头，浅景深，柔和自然光。", "camera": {"side": "front_right", "lens": 50}, "axis_note": "与镜号30成对反打，机位角度变化大于30°，不越轴。", "continuity_in": "接镜号30，米迦尔保持原位与朝向。", "gaze": [{"from": "米迦尔", "to": "码头海面与远处船桅"}], "vfx": [], "declared_duration_frames": 0, "declared_shot_number": 31, "declared_camera_move": "static", "intent_type": "留白", "dialogue_pins": [], "beats": [{"t": 0.0, "subject": "米迦尔", "verb": "look_at", "target": "码头海面与远处船桅", "face_to": "screen_left", "pace": "slow"}, {"t": 0.45, "subject": "米迦尔", "verb": "turn_head", "target": "市场棚架与货筐", "face_to": "screen_right", "pace": "slow"}], "composition": {"rule": "thirds", "subject_position": "right_third"}, "rule_justifications": [{"rule": "comp_headroom", "action": "follow", "reason": "特写头顶留白约 5%，符合 3%~12% 区间，避免憋闷或主体下坠"}, {"rule": "AXIS_RULE", "action": "follow", "reason": "与镜号 30 成对反打，机位角度变化大于 30° 且保持同一轴线侧，不越轴"}, {"rule": "INTENT_PACK", "action": "follow", "reason": "本镜意图为静默留白，采用固定机位、CU 景别，让顶点余韵停留"}, {"rule": "cine_static_contrast", "action": "follow", "reason": "整场以运动为主，此处用固定镜头作为静止参照，留出情绪空白"}]}, {"shot_id": "shot_032", "order": 8, "intent": "段末收束，用中远景把两人重新放回市场空间中，松开张力", "shot_type": "MLS", "duration_frames": 72, "characters": ["米迦尔", "伊恩"], "dialogue_ids": [], "actions": [], "dialogues": [], "prompt": "中远景，米迦尔与伊恩隔着摊位静立，市场人流在他们身后继续流动。", "camera": {}, "axis_note": "机位退回轴线同侧较远处，景别较镜号31放宽两档以上。", "continuity_in": "接镜号31，两人位置不变，机位后撤至膝上景别。", "gaze": [{"from": "米迦尔", "to": "伊恩"}, {"from": "伊恩", "to": "米迦尔"}], "vfx": [], "declared_duration_frames": 0, "declared_shot_number": 32, "declared_camera_move": "static", "intent_type": "收束", "dialogue_pins": [], "beats": [], "composition": {}, "rule_justifications": []}, {"shot_id": "shot_033", "order": 9, "intent": "以单人全景重新建立环境，交代下一节拍发生前的空间状态", "shot_type": "LS", "duration_frames": 72, "characters": ["米迦尔"], "dialogue_ids": [], "actions": [], "dialogues": [], "prompt": "全景固定镜头，第十四街区码头市场午后。米迦尔单人立于画面中景偏右，面朝画面右方（与开场银幕方向一致），身旁是摊位长桌与市场棚架货筐，身后延伸出码头海面与远处船桅，往来人群在更远处流动。50mm 镜头，机位与米迦尔视线同侧，环境开阔，人物在画面中占比小，留出大量空间与海面留白。光线为午后自然散射光，暖调，海面反光柔和。米迦尔静止站立，仅有轻微呼吸起伏与一次极短的目光扫视，随后保持不动，为下一节拍留出静止的参照系。", "camera": {"side": "left", "lens": 50}, "axis_note": "环境建立镜，米迦尔仍朝画面右方，银幕方向与开场一致。", "continuity_in": "接镜号32，空间连续，伊恩暂离画面范围。", "gaze": [{"from": "米迦尔", "to": "伊恩"}, {"from": "伊恩", "to": "米迦尔"}], "vfx": [], "declared_duration_frames": 0, "declared_shot_number": 33, "declared_camera_move": "static", "intent_type": "铺垫", "dialogue_pins": [], "beats": [{"t": 0.05, "subject": "米迦尔", "verb": "look_at", "target": "码头海面与远处船桅", "face_to": "screen_right", "pace": "slow"}, {"t": 0.35, "subject": "米迦尔", "verb": "turn_head", "target": "市场棚架与货筐", "face_to": "screen_right", "pace": "slow"}, {"t": 0.7, "subject": "米迦尔", "verb": "look_at", "target": "码头海面与远处船桅", "face_to": "screen_right", "pace": "slow"}], "composition": {"rule": "thirds", "subject_position": "right_third"}, "rule_justifications": [{"rule": "AXIS_RULE", "action": "follow", "reason": "环境建立镜保持固定机位，米迦尔仍朝画面右方，与开场及前一镜银幕方向一致，不越轴。"}, {"rule": "INTENT_PACK", "action": "follow", "reason": "本镜为铺垫性环境建立镜，用固定机位与全景交代空间状态，把运动留给后续转折。"}]}, {"shot_id": "shot_034", "order": 10, "intent": "双人中景重新建立两人对话关系，推进主线", "shot_type": "MS", "duration_frames": 96, "characters": ["米迦尔", "伊恩"], "dialogue_ids": [], "actions": [], "dialogues": [{"character_id": "米迦尔", "text": "我先上船。", "start_frame": 12, "end_frame": 52}, {"character_id": "伊恩", "text": "等等我。", "start_frame": 64, "end_frame": 84}], "prompt": "双人中景，35mm，固定机位同侧重建两人对话关系：米迦尔在画面左，伊恩在画面右，两人隔着摊位长桌相对；伊恩回到右侧原位，账本首次入画置于桌面。背景是市场棚架与货筐、远处码头海面与船桅，往来人群虚化。午后顶光柔和，cinematic headroom，两人视线在画面中部交汇。", "camera": {"side": "front", "lens": 35}, "axis_note": "机位在轴线同侧，米迦尔左、伊恩右，关系位置不变。", "continuity_in": "接镜号33，伊恩回到画面右侧原位，账本首次入画。", "gaze": [{"from": "米迦尔", "to": "伊恩"}, {"from": "伊恩", "to": "米迦尔"}], "vfx": [], "declared_duration_frames": 0, "declared_shot_number": 34, "declared_camera_move": "static", "intent_type": "推进", "dialogue_pins": [], "beats": [{"t": 0.0, "subject": "伊恩", "verb": "walk_to", "target": "摊位长桌", "face_to": "screen_left", "pace": "normal"}, {"t": 0.12, "subject": "伊恩", "verb": "place_prop", "target": "摊位长桌"}, {"t": 0.25, "subject": "米迦尔", "verb": "look_at", "target": "伊恩", "face_to": "screen_right"}, {"t": 0.4, "subject": "伊恩", "verb": "look_at", "target": "米迦尔", "face_to": "screen_left"}, {"t": 0.55, "subject": "米迦尔", "verb": "nod", "target": "伊恩"}, {"t": 0.75, "subject": "伊恩", "verb": "nod", "target": "米迦尔"}], "composition": {"rule": "thirds", "subject_position": "left_third"}, "rule_justifications": [{"rule": "INTENT_PACK intent=intent:推进 shot_size=shot_size:MS movement=push_through", "action": "follow", "reason": "本镜意图为推进主线对话，MS 双人同框配 push_through 缓推，强化两人关系的重新建立。"}, {"rule": "SHOT_PATTERN shot_size=shot_size:MS lens=lens:35mm movement=movement:push_through headroom_policy=cinematic 禁={movement:orbit_cw}", "action": "follow", "reason": "采用 35mm MS 加 push_through，cinematic 头顶留白，未使用被禁的 orbit_cw。"}, {"rule": "AXIS_RULE pair=any_two axis_side=neutral axis_topic=越轴 禁={movement:固定}", "action": "follow", "reason": "机位保持在轴线同侧（米迦尔左、伊恩右），未越轴，因此不采用被禁的固定机位，改用同侧缓推。"}]}, {"shot_id": "shot_035", "order": 11, "intent": "反打伊恩，突出其递出账本后的态度，推进主线", "shot_type": "MCU", "duration_frames": 72, "characters": ["伊恩"], "dialogue_ids": [], "actions": [], "dialogues": [], "prompt": "伊恩胸上中近景，手仍停在递出账本的高度，目光投向画面左方。", "camera": {}, "axis_note": "反打机位同侧，伊恩视线保持向左。", "continuity_in": "接镜号34，伊恩保持原位与朝向。", "gaze": [{"from": "米迦尔", "to": "伊恩"}, {"from": "伊恩", "to": "米迦尔"}], "vfx": [], "declared_duration_frames": 0, "declared_shot_number": 35, "declared_camera_move": "static", "intent_type": "推进", "dialogue_pins": [], "beats": [], "composition": {}, "rule_justifications": []}, {"shot_id": "shot_036", "order": 12, "intent": "反打米迦尔，交代其接过账本后的状态，推进主线", "shot_type": "MCU", "duration_frames": 72, "characters": ["米迦尔"], "dialogue_ids": [], "actions": [], "dialogues": [], "prompt": "MCU 反打米迦尔：与镜号35成对反打，机位换到轴线另一侧、角度变化大于30°。85mm 长焦、平视，米迦尔位于画面右三分，身后是虚化的码头市场——摊位长桌、市场棚架与货筐、往来人群的轮廓。账本已在他手中，他先垂眼看向账本，指尖收紧压住封面边缘；随后缓慢抬头，视线越过镜头望向码头海面与远处船桅，最后轻轻一点头。相机以极缓的 dolly_in 推近，幅度 0.6 米，落在第 60 帧收住，收尾留 12 帧静止余量。自然午后侧光，浅景深，静默克制，推进主线。无台词。", "camera": {"side": "front_right", "lens": 85}, "axis_note": "与镜号35成对反打，机位角度变化大于30°，不越轴。", "continuity_in": "接镜号35，米迦尔保持原位与朝向，账本已在其手中。", "gaze": [{"from": "米迦尔", "to": "摊位长桌"}, {"from": "米迦尔", "to": "码头海面与远处船桅"}], "vfx": [], "declared_duration_frames": 0, "declared_shot_number": 36, "declared_camera_move": "static", "intent_type": "推进", "dialogue_pins": [], "beats": [{"t": 0.0, "subject": "米迦尔", "verb": "look_at", "target": "摊位长桌", "face_to": "screen_left", "pace": "slow"}, {"t": 0.25, "subject": "米迦尔", "verb": "hand_to", "target": "摊位长桌", "react": "指尖收紧，压住账本边缘"}, {"t": 0.6, "subject": "米迦尔", "verb": "turn_head", "target": "码头海面与远处船桅", "face_to": "away", "pace": "slow"}, {"t": 0.85, "subject": "米迦尔", "verb": "nod", "target": "码头海面与远处船桅"}], "composition": {"rule": "thirds", "subject_position": "right_third"}, "rule_justifications": [{"rule": "SHOT_PATTERN", "action": "follow", "reason": "保持 MCU 与 85mm 长焦压缩，与镜号35成对反打。"}, {"rule": "STAGING_PACK", "action": "follow", "reason": "MCU 平衡构图、平视机位，人物置于右三分。"}, {"rule": "AXIS_RULE", "action": "follow", "reason": "与镜号35同一轴线另一侧，机位角度变化大于30°，不越轴。"}, {"rule": "INTENT_PACK", "action": "follow", "reason": "intent=推进 且 shot_size=MCU 时采用 dolly_in，缓慢推近强化接过账本后的心理重量。"}, {"rule": "INTENT_PACK", "action": "break", "reason": "同 intent=推进 的 MS 固定机位条目被更具体的 MCU+dolly_in 条目取代，按更具体者优先裁决。", "precedent": "case_medium-close-up-shot_011"}]}, {"shot_id": "shot_037", "order": 13, "intent": "双人中景承载争执升级，两人距离与身体朝向同时收紧", "shot_type": "MS", "duration_frames": 72, "characters": ["米迦尔", "伊恩"], "dialogue_ids": [], "actions": [{"character_id": "米迦尔", "action_type": "walk_to", "start_frame": 1, "end_frame": 24, "target_position": [0.9, 0, 0], "params": {"speed": "walk"}}, {"character_id": "伊恩", "action_type": "walk_to", "start_frame": 1, "end_frame": 24, "target_position": [-0.9, 0, 0], "params": {"speed": "walk"}}, {"character_id": "米迦尔", "action_type": "turn_body", "start_frame": 26, "end_frame": 34, "params": {"angle_deg": -180}}, {"character_id": "伊恩", "action_type": "turn_body", "start_frame": 26, "end_frame": 34, "params": {"angle_deg": 180}}, {"character_id": "米迦尔", "action_type": "look_at", "start_frame": 36, "end_frame": 58, "params": {"yaw_deg": 0, "pitch_deg": 0}}, {"character_id": "伊恩", "action_type": "look_at", "start_frame": 36, "end_frame": 58, "params": {"yaw_deg": 0, "pitch_deg": 0}}], "dialogues": [{"character_id": "米迦尔", "text": "我先上船。", "start_frame": 20, "end_frame": 58}], "prompt": "中景，两人同框：米迦尔与伊恩在画面中相向走过彼此，完成一次看得见的换位，随后各自转身相对而立，形成正反打前的空间关系；镜头缓慢推近。", "camera": {"side": "front", "lens": 50}, "axis_note": "回到轴线同侧双人机位，与镜号36景别变化一档以上。", "continuity_in": "接镜号36，两人位置不变，机位后撤至双人景别。", "gaze": [{"from": "米迦尔", "to": "伊恩"}, {"from": "伊恩", "to": "米迦尔"}], "vfx": [], "declared_duration_frames": 0, "declared_shot_number": 37, "declared_camera_move": "static", "intent_type": "对抗", "dialogue_pins": [], "beats": [{"t": 0.05, "subject": "米迦尔", "verb": "walk_to", "target": "伊恩", "pace": "normal"}, {"t": 0.05, "subject": "伊恩", "verb": "walk_to", "target": "米迦尔", "pace": "normal"}, {"t": 0.45, "subject": "米迦尔", "verb": "turn_body", "face_to": "screen_right"}, {"t": 0.45, "subject": "伊恩", "verb": "turn_body", "face_to": "screen_left"}, {"t": 0.8, "subject": "米迦尔", "verb": "look_at", "target": "伊恩"}], "composition": {"rule": "thirds", "subject_position": "center"}, "rule_justifications": [{"rule": "SHOT_PATTERN", "action": "follow", "reason": "中景双人、35mm、固定机位，符合该镜的景别与镜头约束。"}, {"rule": "AXIS_RULE", "action": "follow", "reason": "机位回到轴线同侧，保持米迦尔在画面右、伊恩在画面左的既有空间关系，未越轴。"}, {"rule": "INTENT_PACK", "action": "follow", "reason": "对抗意图下用中景固定机位承载两人距离与朝向的同时收紧，不靠运动分散注意力。"}]}, {"shot_id": "shot_038", "order": 14, "intent": "近景放大伊恩在争执中的情绪，冲突继续升级", "shot_type": "CU", "duration_frames": 72, "characters": ["伊恩"], "dialogue_ids": [], "actions": [], "dialogues": [], "prompt": "伊恩头部近景，情绪外露，视线紧锁画面左方。", "camera": {}, "axis_note": "反打机位在轴线同侧，伊恩视线保持向左。", "continuity_in": "接镜号37，伊恩保持原位与朝向。", "gaze": [{"from": "米迦尔", "to": "伊恩"}, {"from": "伊恩", "to": "米迦尔"}], "vfx": [], "declared_duration_frames": 0, "declared_shot_number": 38, "declared_camera_move": "static", "intent_type": "对抗", "dialogue_pins": [], "beats": [], "composition": {}, "rule_justifications": []}, {"shot_id": "shot_039", "order": 15, "intent": "以米迦尔近景的短促反应承接争执，形成情绪对撞", "shot_type": "CU", "duration_frames": 48, "characters": ["米迦尔"], "dialogue_ids": [], "actions": [], "dialogues": [], "prompt": "近景特写（CU），50mm 镜头，机位置于米迦尔前右侧、角度与上一镜反打相差大于30°，不越轴。米迦尔占据画面左三分位，面部与肩线清晰，浅景深使背后码头市场虚化。他保持原位与朝向，先极短促地把头转向画面右侧（朝向码头海面与远处船桅），眼神快速扫过，随后目光定住，末段缓慢点一下头，下颌收紧、嘴唇抿住，压住上一镜争执后的情绪。机位基本固定，仅带极轻微手持呼吸感。午后码头侧光勾出面部轮廓，市场棚架与货筐的暖色反光落在脸颊边缘，远处船桅与海面在焦外形成明亮色块。", "camera": {"side": "front_right", "lens": 50}, "axis_note": "与镜号38成对反打，机位角度变化大于30°，不越轴。", "continuity_in": "接镜号38，米迦尔保持原位与朝向。", "gaze": [{"from": "米迦尔", "to": "伊恩"}, {"from": "伊恩", "to": "米迦尔"}], "vfx": [], "declared_duration_frames": 0, "declared_shot_number": 39, "declared_camera_move": "static", "intent_type": "停顿", "dialogue_pins": [], "beats": [{"t": 0.1, "subject": "米迦尔", "verb": "turn_head", "target": "码头海面与远处船桅", "face_to": "screen_right", "pace": "brisk"}, {"t": 0.45, "subject": "米迦尔", "verb": "look_at", "target": "码头海面与远处船桅", "face_to": "screen_right", "pace": "normal"}, {"t": 0.8, "subject": "米迦尔", "verb": "nod", "target": "码头海面与远处船桅", "face_to": "screen_right", "pace": "slow"}], "composition": {"rule": "thirds", "subject_position": "left_third"}, "rule_justifications": [{"rule": "AXIS_RULE", "action": "follow", "reason": "与镜号38成对反打，机位置于前右侧，角度变化大于30°且不跨越两人之间的轴线，保持空间连续。"}, {"rule": "INTENT_PACK", "action": "follow", "reason": "本镜为米迦尔近景短促反应，景别 CU、机位固定（仅极轻微手持呼吸感），符合 intent:停顿 / intent:揭示 的固定机位近景要求。"}, {"rule": "SHOT_PATTERN", "action": "break", "reason": "该模式要求 MS 且禁用 CU，但本镜的叙事任务是以近景短促反应承接上一镜的争执，形成情绪对撞；退到中景会稀释反应强度，故有意破例采用 CU 固定机位。", "precedent": "case_medium-close-up-shot_028"}]}, {"shot_id": "shot_040", "order": 16, "intent": "段末收束，米迦尔合上账本，用中远景把冲突收回空间", "shot_type": "MS", "duration_frames": 72, "characters": ["米迦尔", "伊恩"], "dialogue_ids": [], "actions": [{"character_id": "米迦尔", "action_type": "walk_to", "start_frame": 1, "end_frame": 48, "target_position": [0.9, 0, 0], "params": {"speed": "walk"}}, {"character_id": "伊恩", "action_type": "walk_to", "start_frame": 1, "end_frame": 48, "target_position": [-0.9, 0, 0], "params": {"speed": "walk"}}, {"character_id": "米迦尔", "action_type": "turn_body", "start_frame": 48, "end_frame": 60, "params": {"angle_deg": 180}}, {"character_id": "伊恩", "action_type": "turn_body", "start_frame": 48, "end_frame": 60, "params": {"angle_deg": 180}}], "dialogues": [], "prompt": "两人在镜头内交换位置：米迦尔从画面左走到画面右，伊恩从画面右走到画面左，走位完成后各自转身相对而立，形成新的左右关系。", "camera": {"side": "front", "lens": 50}, "axis_note": "机位退回轴线同侧较远处，景别较镜号39放宽两档以上。", "continuity_in": "接镜号39，两人位置不变，账本已合上。", "gaze": [{"from": "米迦尔", "to": "伊恩"}, {"from": "伊恩", "to": "米迦尔"}], "vfx": [], "declared_duration_frames": 0, "declared_shot_number": 40, "declared_camera_move": "static", "intent_type": "收束", "dialogue_pins": [], "beats": [], "composition": {"rule": "thirds", "subject_position": "center"}, "rule_justifications": []}, {"shot_id": "shot_041", "order": 17, "intent": "以单人全景建立夜色码头的氛围，为夜谈段落定调", "shot_type": "LS", "duration_frames": 72, "characters": ["米迦尔"], "dialogue_ids": [], "actions": [], "dialogues": [], "prompt": "全景（LS），50mm，固定机位，机位在米迦尔前右方（front_right）。夜色码头石阶一带：画面深处是码头海面与远处船桅的暗色剪影，水面上零星灯影；中景可见摊位长桌与市场棚架、货筐的轮廓，收摊后的空落感。米迦尔单人入画，自画面左侧缓步走向摊位长桌方向，身体与视线始终朝画面右方，与前一镜银幕方向一致；行进至长桌附近时略作停顿，转头望向远处船桅方向。人物置于画面右三分处，左侧留出夜色码头的大片空间。低照度夜景，冷蓝基调，远处船灯与岸边零星暖光形成微弱对比，整体安静、克制，为夜谈段落定调。", "camera": {"side": "front_right", "lens": 50}, "axis_note": "环境建立镜，米迦尔仍朝画面右方，银幕方向与前段一致。", "continuity_in": "接镜号40，时间推进至夜晚，空间移至码头石阶一带。", "gaze": [{"from": "米迦尔", "to": "伊恩"}, {"from": "伊恩", "to": "米迦尔"}], "vfx": [], "declared_duration_frames": 0, "declared_shot_number": 41, "declared_camera_move": "static", "intent_type": "铺垫", "dialogue_pins": [], "beats": [{"t": 0.1, "subject": "米迦尔", "verb": "enter_from", "target": "码头海面与远处船桅", "face_to": "screen_right", "pace": "slow"}, {"t": 0.45, "subject": "米迦尔", "verb": "walk_to", "target": "摊位长桌", "face_to": "screen_right", "pace": "slow"}, {"t": 0.85, "subject": "米迦尔", "verb": "turn_head", "target": "码头海面与远处船桅", "face_to": "screen_right"}], "composition": {"rule": "thirds", "subject_position": "right_third"}, "rule_justifications": [{"rule": "AXIS_RULE", "action": "follow", "reason": "环境建立镜，固定机位，米迦尔自画面左侧入画后朝右行进，银幕方向与前段一致，不产生越轴。"}, {"rule": "INTENT_PACK", "action": "follow", "reason": "本镜意图为以单人全景建立夜色码头氛围、为夜谈段落定调，属于铺垫性质，故采用 LS 固定机位，为后续段落的运动镜头留出参照系。"}, {"rule": "cine_static_contrast", "action": "follow", "reason": "把固定镜头留给铺垫：本镜不设任何相机运动，让夜色的静止成为之后第一次推镜的参照。"}]}, {"shot_id": "shot_042", "order": 18, "intent": "双人中景展开夜谈对话，推进对话进程", "shot_type": "MS", "duration_frames": 96, "characters": ["米迦尔", "伊恩"], "dialogue_ids": [], "actions": [], "dialogues": [{"character_id": "米迦尔", "text": "我先上船。", "start_frame": 8, "end_frame": 48}, {"character_id": "伊恩", "text": "等等我。", "start_frame": 60, "end_frame": 84}], "prompt": "码头市场夜谈，双人中景。米迦尔在画面左侧、伊恩在画面右侧，两人并坐在摊位长桌旁，机位在轴线同侧，与前段关系位置一致。市场棚架与货筐在背景深处，码头海面与远处船桅在夜色中隐约可见，往来人群在远处虚化。光线为夜间市场灯与海面反光。相机 35mm 中景，固定机位，轻微推近以推进对话。", "camera": {"side": "front_left", "lens": 35}, "axis_note": "机位在轴线同侧，米迦尔左、伊恩右，关系位置与前段保持一致。", "continuity_in": "接镜号41，伊恩入画于米迦尔右侧，两人坐姿。", "gaze": [{"from": "米迦尔", "to": "伊恩"}, {"from": "伊恩", "to": "米迦尔"}], "vfx": [], "declared_duration_frames": 0, "declared_shot_number": 42, "declared_camera_move": "static", "intent_type": "推进", "dialogue_pins": [], "beats": [{"t": 0.0, "subject": "米迦尔", "verb": "sit", "target": "摊位长桌", "face_to": "screen_right"}, {"t": 0.0, "subject": "伊恩", "verb": "sit", "target": "摊位长桌", "face_to": "screen_left"}, {"t": 0.1, "subject": "米迦尔", "verb": "turn_head", "target": "伊恩", "face_to": "screen_right"}, {"t": 0.2, "subject": "伊恩", "verb": "nod", "target": "米迦尔", "face_to": "screen_left"}, {"t": 0.45, "subject": "伊恩", "verb": "turn_head", "target": "米迦尔", "face_to": "screen_left"}, {"t": 0.6, "subject": "米迦尔", "verb": "nod", "target": "伊恩", "face_to": "screen_right"}, {"t": 0.8, "subject": "伊恩", "verb": "body_tilt", "target": "米迦尔", "face_to": "screen_left"}], "composition": {"rule": "thirds", "subject_position": "left_third"}, "rule_justifications": [{"rule": "SHOT_PATTERN:shot_size=shot_size:MS lens=lens:35mm movement=movement:push_through headroom_policy=cinematic", "action": "follow"}, {"rule": "INTENT_PACK:intent:推进 shot_size=shot_size:MS movement=push_through", "action": "follow"}, {"rule": "INTENT_PACK:intent:推进 shot_size=shot_size:MS movement=固定", "action": "break", "reason": "本镜意图为推进夜谈对话，固定机位会削弱对话的递进压迫感；采用更具体的 push_through 变体，让观众随对话逐步贴近两人。", "precedent": "case_over-the-shoulder-shot_014"}]}, {"shot_id": "shot_043", "order": 19, "intent": "反打伊恩，交代其讲述往事时的状态，推进对话", "shot_type": "MCU", "duration_frames": 72, "characters": ["伊恩"], "dialogue_ids": [], "actions": [], "dialogues": [], "prompt": "反打中近景（MCU，85mm，平视）对准伊恩：他坐在码头市场摊位长桌旁，身体朝向画面左侧，视线越过镜头左侧望向码头海面与远处船桅，背景是市场棚架与货筐的虚化暖调。相机位于front_left，缓慢dolly_in约0.8米，从半身收至更近，伊恩在右三分位，左侧留出视线空间。表演节奏克制：先凝视远方，中段一次轻微点头，随后上身微微前倾，像在回忆并讲述往事。午后侧逆光勾出轮廓，画面安静、怀旧，无他人入镜。", "camera": {"side": "front_left", "lens": 85}, "axis_note": "反打机位同侧，伊恩视线保持向左。", "continuity_in": "接镜号42，伊恩保持坐姿与朝向。", "gaze": [{"from": "米迦尔", "to": "伊恩"}, {"from": "伊恩", "to": "米迦尔"}], "vfx": [], "declared_duration_frames": 0, "declared_shot_number": 43, "declared_camera_move": "static", "intent_type": "推进", "dialogue_pins": [], "beats": [{"t": 0.0, "subject": "伊恩", "verb": "look_at", "target": "码头海面与远处船桅", "face_to": "screen_left", "pace": "slow"}, {"t": 0.35, "subject": "伊恩", "verb": "nod", "target": "码头海面与远处船桅", "face_to": "screen_left", "pace": "slow"}, {"t": 0.7, "subject": "伊恩", "verb": "body_tilt", "target": "摊位长桌", "face_to": "screen_left", "pace": "slow"}], "composition": {"rule": "thirds", "subject_position": "right_third"}, "rule_justifications": [{"rule": "shot_size:MCU", "action": "follow", "reason": "反打伊恩，中近景保留面部表演与讲述状态。"}, {"rule": "lens:85mm", "action": "follow", "reason": "85mm 压缩空间，使背景市场棚架虚化，突出伊恩。"}, {"rule": "composition_rule:balance", "action": "follow", "reason": "伊恩置于右三分，左侧留出他视线方向的观看空间，形成平衡。"}, {"rule": "camera_angle:平视", "action": "follow", "reason": "平视保持对话的平等与克制，不俯不仰。"}, {"rule": "axis_side:neutral", "action": "follow", "reason": "反打机位与镜号42同侧，伊恩视线仍朝屏幕左，不越轴。"}, {"rule": "movement:dolly_in", "action": "follow", "reason": "缓慢推近，随往事讲述逐渐贴近伊恩的情绪。"}]}, {"shot_id": "shot_044", "order": 20, "intent": "反打米迦尔，捕捉其倾听时的反应，推进对话", "shot_type": "MCU", "duration_frames": 72, "characters": ["米迦尔"], "dialogue_ids": [], "actions": [{"character_id": "米迦尔", "action_type": "look_at", "start_frame": 6, "end_frame": 30, "params": {"yaw_deg": 22, "pitch_deg": -3}}, {"character_id": "米迦尔", "action_type": "nod", "start_frame": 30, "end_frame": 46, "params": {"cycles": 1}}, {"character_id": "米迦尔", "action_type": "turn_head", "start_frame": 52, "end_frame": 66, "params": {"angle_deg": 12}}], "dialogues": [], "prompt": "第十四街区码头市场，午后。反打米迦尔的中景近景：他坐在摊位长桌旁，身体朝向与镜号43保持连贯，机位绕到对侧、与43号机位夹角大于30°而不越轴。米迦尔安静地倾听，目光落在画面右侧（对话对方的方向），呼吸与肩线几乎不动，只在倾听中段有一次极轻的点头与一次喉部吞咽，随后眼神略微下移，像在压下什么话。背景是市场棚架与货筐的浅景深虚影，远处码头海面与船桅透进午后的侧光，往来人群在焦外流动。固定机位，85mm，平视，头部落于画面上三分线附近，构图以左右平衡为主，给米迦尔的视线方向留出呼吸的留白。", "camera": {"side": "front_right", "lens": 85}, "axis_note": "与镜号43成对反打，机位角度变化大于30°，不越轴。", "continuity_in": "接镜号43，米迦尔保持坐姿与朝向。", "gaze": [{"from": "米迦尔", "to": "screen_right"}], "vfx": [], "declared_duration_frames": 0, "declared_shot_number": 44, "declared_camera_move": "static", "intent_type": "停顿", "dialogue_pins": [], "beats": [{"t": 0.08, "subject": "米迦尔", "verb": "look_at", "target": "往来人群", "face_to": "screen_right", "pace": "slow", "react": "保持倾听，视线稳定落在对方方向"}, {"t": 0.42, "subject": "米迦尔", "verb": "nod", "target": "米迦尔", "face_to": "screen_right", "pace": "slow", "react": "极轻的一次点头，表示听进去了"}, {"t": 0.72, "subject": "米迦尔", "verb": "turn_head", "target": "码头海面与远处船桅", "face_to": "away", "pace": "slow", "react": "视线短暂下移偏开，压住情绪"}], "composition": {"rule": "thirds", "subject_position": "left_third"}, "rule_justifications": [{"rule": "SHOT_PATTERN", "action": "follow"}, {"rule": "STAGING_PACK", "action": "follow"}, {"rule": "AXIS_RULE", "action": "follow"}, {"rule": "INTENT_PACK", "action": "follow", "reason": "本镜意图为倾听反应，取 intent:停顿 的 CU 与 intent:留白 的 MCU 之间，按计划 MCU 执行，保留留白感"}, {"rule": "case_ultimate-guide-to-camera-shots_024", "action": "follow"}]}, {"shot_id": "shot_045", "order": 21, "intent": "双人中景留白，两人沉默共处，让夜谈的余韵停留", "shot_type": "MS", "duration_frames": 72, "characters": ["米迦尔", "伊恩"], "dialogue_ids": [], "actions": [], "dialogues": [], "prompt": "双人中景固定机位，码头市场夜谈的余韵。米迦尔与伊恩并肩站在摊位长桌旁，接镜号44位置不变，机位后撤至双人景别（MS），回到轴线同侧，平视高度，50mm。两人沉默共处，各自望向画面留白处——米迦尔看向画面右侧的码头海面与远处船桅，伊恩略低头看向摊位长桌上的货筐。市场棚架与货筐在两人身后形成纵深，远处往来人群虚化。画面刻意留白，让沉默停留；全镜固定不动，是下一镜运动的参照系。", "camera": {"side": "front_left", "lens": 50}, "axis_note": "回到轴线同侧双人机位，与镜号44景别变化一档以上。", "continuity_in": "接镜号44，两人位置不变，机位后撤至双人景别。", "gaze": [{"from": "米迦尔", "to": "码头海面与远处船桅"}, {"from": "伊恩", "to": "摊位长桌"}], "vfx": [], "declared_duration_frames": 0, "declared_shot_number": 45, "declared_camera_move": "static", "intent_type": "留白", "dialogue_pins": [], "beats": [{"t": 0.0, "subject": "米迦尔", "verb": "look_at", "target": "码头海面与远处船桅", "face_to": "screen_right", "pace": "slow"}, {"t": 0.25, "subject": "伊恩", "verb": "look_at", "target": "摊位长桌", "face_to": "away", "pace": "slow"}, {"t": 0.6, "subject": "伊恩", "verb": "turn_head", "target": "米迦尔", "face_to": "screen_left", "pace": "slow"}, {"t": 0.85, "subject": "米迦尔", "verb": "turn_head", "target": "伊恩", "face_to": "screen_left", "pace": "slow"}], "composition": {"rule": "lead_room", "subject_position": "right_third"}, "rule_justifications": [{"rule": "AXIS_RULE", "action": "follow", "reason": "回到轴线同侧双人机位，与镜号44同侧，越轴禁令下保持中性轴线侧，观众空间关系不翻转。"}, {"rule": "INTENT_PACK", "action": "follow", "reason": "本镜意图为留白，MS景别、固定机位，让夜谈余韵在沉默中停留。"}, {"rule": "STAGING_PACK", "action": "follow", "reason": "MS双人构图采用lead_room，平视机位，两人之间的沉默留白成为画面主体。"}, {"rule": "cine_static_contrast", "action": "follow", "reason": "本镜保持固定，作为下一镜运动的参照系，把运动留给转折。"}]}, {"shot_id": "shot_046", "order": 22, "intent": "以伊恩近景的抬头动作延续留白，视线离开对话对象", "shot_type": "CU", "duration_frames": 72, "characters": ["伊恩"], "dialogue_ids": [], "actions": [], "dialogues": [], "prompt": "近景特写，伊恩保持坐姿，仅头部缓缓抬起，视线从对话对象转向画面左上方远处的码头海面与船桅。50mm 固定机位，反打角度在轴线同侧，浅景深虚化摊位长桌与往来人群，午后硬光在侧脸留下轮廓，画面右上留出空域承载他未说出口的停顿。", "camera": {"side": "front_left", "lens": 50}, "axis_note": "反打机位在轴线同侧，伊恩由向左转为向上，视线变化有依据。", "continuity_in": "接镜号45，伊恩保持坐姿，仅头部抬起。", "gaze": [{"from": "米迦尔", "to": "伊恩"}, {"from": "伊恩", "to": "米迦尔"}], "vfx": [], "declared_duration_frames": 0, "declared_shot_number": 46, "declared_camera_move": "static", "intent_type": "回望", "dialogue_pins": [], "beats": [{"t": 0.0, "subject": "伊恩", "verb": "turn_head", "target": "码头海面与远处船桅", "face_to": "screen_left", "pace": "slow"}, {"t": 0.5, "subject": "伊恩", "verb": "look_at", "target": "码头海面与远处船桅", "face_to": "away", "pace": "slow"}, {"t": 0.8, "subject": "伊恩", "verb": "look_at", "target": "码头海面与远处船桅", "face_to": "away", "pace": "slow"}], "composition": {"rule": "thirds", "subject_position": "right_third"}, "rule_justifications": [{"rule": "AXIS_RULE", "action": "follow", "reason": "反打机位保持轴线同侧，伊恩由向左转为向上仰视，视线变化有空间依据，不构成越轴。"}, {"rule": "INTENT_PACK", "action": "follow", "reason": "本镜为 CU 固定机位，以近景的抬头留白延续停顿与揭示意图。"}, {"rule": "comp_framing", "action": "follow", "reason": "近景景别下主体占比贴合特写，头部与肩部充满画面，不越级拍到半身。"}, {"rule": "cine_move_motivation", "action": "follow", "reason": "镜头固定不动，把运动全部交给伊恩的视线与呼吸，避免无动机运镜。"}]}, {"shot_id": "shot_047", "order": 23, "intent": "以米迦尔近景的微表情收住夜谈情绪，形成反应落点", "shot_type": "CU", "duration_frames": 48, "characters": ["米迦尔"], "dialogue_ids": [], "actions": [{"character_id": "米迦尔", "action_type": "look_at", "start_frame": 1, "end_frame": 14, "params": {"yaw_deg": 22, "pitch_deg": -4}}, {"character_id": "米迦尔", "action_type": "turn_head", "start_frame": 15, "end_frame": 26, "params": {"angle_deg": 20}}, {"character_id": "米迦尔", "action_type": "nod", "start_frame": 27, "end_frame": 34, "params": {"cycles": 1}}, {"character_id": "米迦尔", "action_type": "look_at", "start_frame": 35, "end_frame": 46, "params": {"yaw_deg": 18, "pitch_deg": -2}}], "dialogues": [], "prompt": "特写近景，50mm 固定机位微推。米迦尔坐在码头市场摊位长桌旁，保持镜号46的坐姿与朝向；机位置于其右前方（与上一镜成对反打，角度变化大于30°，不越轴）。他先望向画面右侧远处码头海面与船桅，眼神缓慢收回转向画面左侧，极轻地点了一下头，随后再度把目光投向海面。背景是虚化的市场棚架与货筐、远处船桅与夜色海面，往来人群只作模糊剪影。面部微表情克制：睫毛颤动、喉结轻动、唇角几乎不可见地收紧。光线为夜间码头散射冷光，侧逆光勾出轮廓。镜头以极小幅度的 dolly_in 缓慢逼近，收束夜谈情绪，形成反应落点。", "camera": {"side": "front_right", "lens": 50}, "axis_note": "与镜号46成对反打，机位角度变化大于30°，不越轴。", "continuity_in": "接镜号46，米迦尔保持坐姿与朝向。", "gaze": [{"from": "米迦尔", "to": "伊恩"}, {"from": "伊恩", "to": "米迦尔"}], "vfx": [], "declared_duration_frames": 0, "declared_shot_number": 47, "declared_camera_move": "static", "intent_type": "停顿", "dialogue_pins": [], "beats": [{"t": 0.0, "subject": "米迦尔", "verb": "look_at", "target": "码头海面与远处船桅", "face_to": "screen_right", "pace": "slow"}, {"t": 0.35, "subject": "米迦尔", "verb": "turn_head", "target": "米迦尔", "face_to": "screen_left", "pace": "slow"}, {"t": 0.55, "subject": "米迦尔", "verb": "nod", "target": "米迦尔", "face_to": "screen_left", "pace": "slow"}, {"t": 0.8, "subject": "米迦尔", "verb": "look_at", "target": "码头海面与远处船桅", "face_to": "screen_right", "pace": "slow"}], "composition": {"rule": "lead_room", "subject_position": "left_third"}, "rule_justifications": [{"rule": "AXIS_RULE", "action": "follow", "reason": "本镜与镜号46成对反打，机位置于米迦尔右前方，角度变化大于30°且不越轴，保持两人视线关系稳定。"}, {"rule": "INTENT_PACK", "action": "follow", "reason": "夜谈收束需要以固定机位的近景微表情作为反应落点，不靠运动抢戏。"}, {"rule": "comp_framing", "action": "follow", "reason": "声明 CU 即取景至肩线以上，面部占比与景别一致，避免情绪强度与景别错位。"}]}, {"shot_id": "shot_048", "order": 24, "intent": "段末收束，用中远景把两人与夜色码头一同收进画面", "shot_type": "MLS", "duration_frames": 72, "characters": ["米迦尔", "伊恩"], "dialogue_ids": [], "actions": [], "dialogues": [], "prompt": "夜色中远景，米迦尔与伊恩并肩坐在石阶上，远处灯塔的光扫过海面。", "camera": {}, "axis_note": "机位退回轴线同侧较远处，景别较镜号47放宽两档以上。", "continuity_in": "接镜号47，两人位置不变，机位后撤至膝上景别。", "gaze": [{"from": "米迦尔", "to": "伊恩"}, {"from": "伊恩", "to": "米迦尔"}], "vfx": [], "declared_duration_frames": 0, "declared_shot_number": 48, "declared_camera_move": "static", "intent_type": "收束", "dialogue_pins": [], "beats": [], "composition": {}, "rule_justifications": []}, {"shot_id": "shot_049", "order": 1, "intent": "建立环境", "shot_type": "LS", "duration_frames": 72, "characters": ["米迦尔"], "dialogue_ids": [], "actions": [{"character_id": "米迦尔", "action_type": "look_at", "start_frame": 1, "end_frame": 24, "params": {"yaw_deg": -35, "pitch_deg": -5}}, {"character_id": "米迦尔", "action_type": "walk_to", "start_frame": 30, "end_frame": 58, "target_position": [6.1, -6.6, 4.51], "params": {"speed": "walk", "from": [6.71, -6.31, 4.51], "to": [6.1, -6.6, 4.51], "bob": 0.03}}], "dialogues": [], "prompt": "大远景固定机位，第十四街区码头市场午后。米迦尔位于画面右区，面朝画面左，身形在摊位长桌与市场棚架货筐之间，背景是码头海面与远处船桅，往来人群在纵深中穿行。50mm 定焦，固定不动机位，关系轴 A 侧不越轴。米迦尔静立片刻，随后缓慢朝画面左前方迈出一步，目光投向码头海面方向，为下一镜的登船动作留出铺垫。自然光，浅淡海雾，画面留白偏左，人物靠右三分。", "camera": {"side": "front_left", "lens": 50}, "axis_note": "关系轴A侧，米迦尔面朝画面左，机位不越轴。", "continuity_in": "承接上一段结尾，米迦尔位于画面右区，面朝画面左。", "gaze": [{"from": "米迦尔", "to": "码头海面与远处船桅"}], "vfx": [], "declared_duration_frames": 0, "declared_shot_number": 49, "declared_camera_move": "static", "intent_type": "铺垫", "dialogue_pins": [], "beats": [{"t": 0.0, "subject": "米迦尔", "verb": "look_at", "target": "码头海面与远处船桅", "face_to": "screen_left", "pace": "slow"}, {"t": 0.45, "subject": "米迦尔", "verb": "walk_to", "target": "码头海面与远处船桅", "face_to": "screen_left", "pace": "slow"}], "composition": {"rule": "lead_room", "subject_position": "right_third"}, "rule_justifications": [{"rule": "AXIS_RULE", "action": "follow", "reason": "米迦尔保持在关系轴 A 侧、面朝画面左，机位不越轴，与前后镜的银幕方向一致。"}, {"rule": "INTENT_PACK", "action": "follow", "reason": "本镜意图为建立环境，采用 LS 大景别 + 固定机位，符合铺垫类镜头的惯例。"}]}, {"shot_id": "shot_050", "order": 2, "intent": "推进主线", "shot_type": "MS", "duration_frames": 96, "characters": ["米迦尔", "伊恩"], "dialogue_ids": ["d_050"], "actions": [{"character_id": "米迦尔", "action_type": "turn_head", "start_frame": 8, "end_frame": 26, "params": {"angle_deg": -18}}, {"character_id": "伊恩", "action_type": "turn_head", "start_frame": 30, "end_frame": 50, "params": {"angle_deg": 16}}, {"character_id": "米迦尔", "action_type": "nod", "start_frame": 56, "end_frame": 68, "params": {"cycles": 1}}], "dialogues": [{"character_id": "米迦尔", "text": "我先上船。", "start_frame": 12, "end_frame": 52}, {"character_id": "伊恩", "text": "等等我。", "start_frame": 64, "end_frame": 84}], "prompt": "双人中景，35mm，午后码头市场。米迦尔在画面右侧、伊恩在画面左侧，面对面站立，两人之间是摊位长桌的一角，背景是市场棚架与货筐、码头海面与远处船桅，往来人群在景深处虚化穿行。相机位于关系轴 A 侧、front_left 方位，以极缓的 push_through 向前推进，保持两人银幕方向不变。米迦尔先转头看向伊恩并开口，伊恩随后抬眼回应，最后米迦尔轻轻点头。自然午后侧光，人物半身入画，头顶留白克制。无对白外的额外音效。", "camera": {"side": "front_left", "lens": 35}, "axis_note": "关系轴A侧，双人同框，保持米迦尔右、伊恩左的银幕方向。", "continuity_in": "由全景切入双人中景，米迦尔仍在画面右、伊恩在画面左，面对面。", "gaze": [{"from": "米迦尔", "to": "伊恩"}, {"from": "伊恩", "to": "米迦尔"}], "vfx": [], "declared_duration_frames": 0, "declared_shot_number": 50, "declared_camera_move": "static", "intent_type": "推进", "dialogue_pins": [], "beats": [{"t": 0.08, "subject": "米迦尔", "verb": "turn_head", "target": "伊恩", "face_to": "screen_left", "pace": "normal", "react": "先开口，语气干脆"}, {"t": 0.12, "subject": "米迦尔", "verb": "look_at", "target": "伊恩", "face_to": "screen_left"}, {"t": 0.33, "subject": "伊恩", "verb": "turn_head", "target": "米迦尔", "face_to": "screen_right", "pace": "slow", "react": "被留下，急着跟上"}, {"t": 0.58, "subject": "米迦尔", "verb": "nod", "target": "伊恩", "face_to": "screen_left", "pace": "slow"}, {"t": 0.7, "subject": "伊恩", "verb": "look_at", "target": "米迦尔", "face_to": "screen_right"}], "composition": {"rule": "thirds", "subject_position": "center"}, "rule_justifications": [{"rule": "INTENT_PACK", "action": "follow", "reason": "本镜 intent=推进，采用 MS 景别 + push_through 缓慢前推，符合推进类意图的更具体条款。"}, {"rule": "SHOT_PATTERN", "action": "follow", "reason": "MS + 35mm + push_through + cinematic headroom，与该条硬约束一致，避免使用被禁的 orbit_cw。"}, {"rule": "AXIS_RULE", "action": "follow", "reason": "保持关系轴 A 侧，米迦尔在画面右、伊恩在画面左，双人同框不越轴，且不使用固定机位。"}]}, {"shot_id": "shot_051", "order": 3, "intent": "推进主线", "shot_type": "MCU", "duration_frames": 72, "characters": ["伊恩"], "dialogue_ids": ["d_051"], "actions": [], "dialogues": [], "prompt": "中近景，伊恩半身入画，面朝画面右，包裹贴在胸前，背景是虚化的船身与海面。", "camera": {}, "axis_note": "关系轴B侧单人镜，伊恩视线朝画面右，与米迦尔位置对应。", "continuity_in": "机位移至伊恩一侧，景别收紧一档，伊恩面朝画面右。", "gaze": [{"from": "米迦尔", "to": "伊恩"}, {"from": "伊恩", "to": "米迦尔"}], "vfx": [], "declared_duration_frames": 0, "declared_shot_number": 51, "declared_camera_move": "static", "intent_type": "推进", "dialogue_pins": [], "beats": [], "composition": {}, "rule_justifications": []}, {"shot_id": "shot_052", "order": 4, "intent": "推进主线", "shot_type": "MCU", "duration_frames": 72, "characters": ["米迦尔"], "dialogue_ids": ["d_052"], "actions": [], "dialogues": [{"character_id": "米迦尔", "text": "我先上船。", "start_frame": 14, "end_frame": 54}], "prompt": "午后码头市场，米迦尔单人中近景，85mm 长焦，机位在关系轴 A 侧、与上一镜形成超过 30° 的对切，平视。米迦尔位于画面右三分，视线朝画面左望向码头海面与远处船桅，留出前视空间。背景可见摊位长桌、市场棚架与货筐以及往来人群的虚化轮廓，海面反光柔和。相机以极缓速度 dolly_in 推近，米迦尔先缓缓转头看向海面，随后目光停留，末段轻点头，神情克制而坚决。", "camera": {"side": "front_right", "lens": 85}, "axis_note": "关系轴A侧单人镜，米迦尔视线朝画面左。", "continuity_in": "机位切至米迦尔一侧，与上一镜形成对切，景别保持MCU但机位角度变化超过30°。", "gaze": [{"from": "米迦尔", "to": "码头海面与远处船桅"}], "vfx": [], "declared_duration_frames": 0, "declared_shot_number": 52, "declared_camera_move": "static", "intent_type": "推进", "dialogue_pins": [], "beats": [{"t": 0.0, "subject": "米迦尔", "verb": "turn_head", "target": "码头海面与远处船桅", "face_to": "screen_left", "pace": "slow"}, {"t": 0.35, "subject": "米迦尔", "verb": "look_at", "target": "码头海面与远处船桅", "face_to": "screen_left", "pace": "normal"}, {"t": 0.75, "subject": "米迦尔", "verb": "nod", "face_to": "screen_left", "pace": "slow"}], "composition": {"rule": "lead_room", "subject_position": "right_third"}, "rule_justifications": [{"rule": "SHOT_PATTERN", "action": "follow", "reason": "本镜为 MCU 单人镜，采用 85mm 长焦压缩空间，头肩留白按 cinematic 政策处理，不使用 ECU。"}, {"rule": "STAGING_PACK", "action": "follow", "reason": "构图以平衡为准，机位保持平视，避免 framing 式封闭构图。"}, {"rule": "AXIS_RULE", "action": "follow", "reason": "米迦尔与伊恩的关系轴维持 A 侧，米迦尔视线朝画面左，机位角度较上一镜变化超过 30° 形成对切，保持轴线不越。"}, {"rule": "INTENT_PACK", "action": "follow", "reason": "推进意图下采用 MCU 配 dolly_in，缓慢推近强化米迦尔决定登船的主动感。"}]}, {"shot_id": "shot_053", "order": 5, "intent": "情绪顶点：两人握手", "shot_type": "MS", "duration_frames": 72, "characters": ["米迦尔", "伊恩"], "dialogue_ids": ["d_053"], "actions": [], "dialogues": [], "prompt": "中景双人同框，码头市场午后。米迦尔与伊恩并肩立于摊位长桌与市场棚架之间，身后是货筐、往来人群与远处码头海面的船桅。两人站位与上一镜一致，画面中心是两人相握的手。机位保持在他们连线同侧（关系轴A侧），固定机位、35mm 镜头，平视，头顶留白克制。米迦尔先抬眼看向伊恩，随后抬起右手伸向画面中央；伊恩迎上，两人手掌在画面正中相握，短暂停顿后各自微微颔首。背景人群虚化流动，海面反光柔和，情绪落在这一次握手上——无需言语。", "camera": {"side": "front_left", "lens": 35}, "axis_note": "关系轴A侧，握手动作跨轴不成立，机位保持在两人连线同侧。", "continuity_in": "由单人镜回到双人同框，两人站位不变，握手动作位于画面中心。", "gaze": [{"from": "米迦尔", "to": "伊恩"}, {"from": "伊恩", "to": "米迦尔"}], "vfx": [], "declared_duration_frames": 0, "declared_shot_number": 53, "declared_camera_move": "static", "intent_type": "转折", "dialogue_pins": [], "beats": [{"t": 0.0, "subject": "米迦尔", "verb": "look_at", "target": "伊恩", "face_to": "screen_right"}, {"t": 0.15, "subject": "伊恩", "verb": "turn_head", "target": "米迦尔", "face_to": "screen_left"}, {"t": 0.35, "subject": "米迦尔", "verb": "hand_to", "target": "伊恩", "face_to": "screen_right"}, {"t": 0.55, "subject": "伊恩", "verb": "hand_to", "target": "米迦尔", "face_to": "screen_left"}, {"t": 0.8, "subject": "米迦尔", "verb": "nod", "target": "伊恩"}, {"t": 0.9, "subject": "伊恩", "verb": "nod", "target": "米迦尔"}], "composition": {"rule": "center", "subject_position": "center"}, "rule_justifications": [{"rule": "SHOT_PATTERN", "action": "follow", "reason": "本镜为情绪顶点的双人同框，按 MS + 35mm + 固定机位的惯例执行，握手位于画面中心。"}, {"rule": "AXIS_RULE", "action": "follow", "reason": "握手动作跨轴不成立，机位保持在两人连线同侧（关系轴A侧），不越轴。"}, {"rule": "INTENT_PACK", "action": "follow", "reason": "本镜为情绪收束/转折点，采用 MS 固定机位承载握手这一顶点动作。"}]}, {"shot_id": "shot_054", "order": 6, "intent": "告别：伊恩转身走向船", "shot_type": "MS", "duration_frames": 72, "characters": ["伊恩"], "dialogue_ids": ["d_054"], "actions": [{"character_id": "伊恩", "action_type": "turn_body", "start_frame": 6, "end_frame": 26, "params": {"angle_deg": 150}}, {"character_id": "伊恩", "action_type": "walk_to", "start_frame": 27, "end_frame": 60, "target_position": [6.1, -7.9, 4.5], "params": {"speed": "walk", "from": [6.71, -6.31, 4.51], "to": [6.1, -7.9, 4.5], "bob": 0.02}}], "dialogues": [], "prompt": "中景，35mm 固定机位，机位置于伊恩侧后方（back_right）。午后码头市场：长桌、棚架与货筐在画面前景两侧形成框架，远处海面与船桅在画面左后方透出，往来人群在景深处虚化。伊恩立于画面右三分之一，先朝画面右方的米迦尔方向最后看了一眼，随即缓慢转身，背向镜头、面朝画面左后方的船；起脚向船走去，脚步沉缓，肩线随转身自然拉出。构图留出左侧行进空间（lead_room），转身后轴线随人物转向自然延伸，未越轴。光线为午后侧逆光，人物轮廓带暖边，情绪克制、告别意味浓。", "camera": {"side": "back_right", "lens": 35}, "axis_note": "转身后伊恩朝向画面左后，轴线随人物转向自然延伸，未越轴。", "continuity_in": "机位移至伊恩侧后方，伊恩由面朝画面右转为背向画面左后。", "gaze": [{"from": "米迦尔", "to": "伊恩"}, {"from": "伊恩", "to": "米迦尔"}], "vfx": [], "declared_duration_frames": 0, "declared_shot_number": 54, "declared_camera_move": "static", "intent_type": "收束", "dialogue_pins": [], "beats": [{"t": 0.0, "subject": "伊恩", "verb": "look_at", "target": "码头海面与远处船桅", "face_to": "screen_right", "pace": "slow"}, {"t": 0.15, "subject": "伊恩", "verb": "turn_body", "target": "码头海面与远处船桅", "face_to": "screen_left", "pace": "normal"}, {"t": 0.45, "subject": "伊恩", "verb": "walk_to", "target": "码头海面与远处船桅", "face_to": "screen_left", "pace": "slow"}], "composition": {"rule": "lead_room", "subject_position": "right_third"}, "rule_justifications": [{"rule": "SHOT_PATTERN", "action": "follow"}, {"rule": "AXIS_RULE", "action": "follow"}, {"rule": "INTENT_PACK", "action": "follow"}]}, {"shot_id": "shot_055", "order": 7, "intent": "告别：米迦尔目送", "shot_type": "CU", "duration_frames": 48, "characters": ["米迦尔"], "dialogue_ids": ["d_055"], "actions": [], "dialogues": [], "prompt": "特写：米迦尔的脸占据画面，平视角度。他站在码头市场摊位长桌旁，视线朝画面左侧——与上一镜伊恩离去的方向一致，目光越过画框左缘追随远去的背影。镜头固定不动，风从海面吹来，他额前的碎发与衣领轻微起伏，背景里往来人群与货筐虚化成一片模糊的光斑，远处船桅在浅景深里只余淡影。他的表情克制，下颌绷紧，只在最后几帧眼皮极轻地一颤。头顶留白约画面高度的 5%，画面左侧留出他视线所向的余量，右侧被虚化的市场棚架填满。", "camera": {"side": "front_left", "lens": 50}, "axis_note": "关系轴A侧，米迦尔视线朝画面左，与伊恩离场方向一致。", "continuity_in": "景别由中景跳至特写，米迦尔视线方向与上一镜伊恩离去的方向一致。", "gaze": [{"from": "米迦尔", "to": "码头海面与远处船桅"}], "vfx": [], "declared_duration_frames": 0, "declared_shot_number": 55, "declared_camera_move": "static", "intent_type": "留白", "dialogue_pins": [], "beats": [{"t": 0.0, "subject": "米迦尔", "verb": "look_at", "target": "码头海面与远处船桅", "face_to": "screen_left", "pace": "slow"}, {"t": 0.55, "subject": "米迦尔", "verb": "turn_head", "target": "码头海面与远处船桅", "face_to": "screen_left", "pace": "slow"}], "composition": {"rule": "lead_room", "subject_position": "right_third"}, "rule_justifications": [{"rule": "comp_headroom", "action": "follow", "reason": "特写头顶留白控制在约 5%，落在 3%~12% 区间内，既不憋闷也不空旷，保住面部表演的压迫感。"}, {"rule": "cine_static_contrast", "action": "follow", "reason": "本镜保持固定，作为告别段落的静止参照系；此前码头段落的运动镜头之后，这里的静止让「目送」被读成情绪的落点。"}, {"rule": "case_what-is-an-eyeline-match_004", "action": "follow", "reason": "沿用视线匹配：米迦尔视线朝画面左，与上一镜伊恩离场方向一致，观众凭视线方向把两个空间缝在一起。"}, {"rule": "AXIS_RULE", "action": "follow", "reason": "关系轴 A 侧不越轴，机位停在米迦尔视线一侧，与伊恩离场方向同侧，方向感连续。"}]}, {"shot_id": "shot_056", "order": 8, "intent": "段末收束：米迦尔留在原地", "shot_type": "MLS", "duration_frames": 72, "characters": ["米迦尔"], "dialogue_ids": [], "actions": [], "dialogues": [], "prompt": "中远景（MLS），50mm，低机位，关系轴A侧。米迦尔留在画面右区，面朝画面左，望向码头海面与远处船桅方向——伊恩离去的方向。摄影机固定在原侧，缓缓拉远（dolly_out），景别在运动中放宽一档，把米迦尔重新放回午后码头市场的环境里：摊位长桌、市场棚架与货筐、往来人群从他身后掠过。他不动，只有极轻微的重心偏移与一次缓慢的呼吸式身体倾斜，肩线保持朝画面左。段落收束：不追、不喊，人就留在原地。光线为午后自然光，画面平衡，主体落在右三分。", "camera": {"side": "front_left", "lens": 50}, "axis_note": "关系轴A侧，机位后退不改变银幕方向。", "continuity_in": "景别放宽一档，米迦尔保持画面右区，面朝画面左。", "gaze": [{"from": "米迦尔", "to": "伊恩"}, {"from": "伊恩", "to": "米迦尔"}], "vfx": [], "declared_duration_frames": 0, "declared_shot_number": 56, "declared_camera_move": "static", "intent_type": "收束", "dialogue_pins": [], "beats": [{"t": 0.0, "subject": "米迦尔", "verb": "look_at", "target": "码头海面与远处船桅", "face_to": "screen_left", "pace": "slow", "react": "目送伊恩离去的方向，视线不收回"}, {"t": 0.35, "subject": "米迦尔", "verb": "body_tilt", "target": "码头海面与远处船桅", "face_to": "screen_left", "pace": "slow", "react": "极轻微的重心前倾后回正，像要迈步又停住"}, {"t": 0.7, "subject": "米迦尔", "verb": "turn_head", "target": "码头海面与远处船桅", "face_to": "screen_left", "pace": "slow", "react": "头微低又抬起，确认船的方向"}], "composition": {"rule": "thirds", "subject_position": "right_third"}, "rule_justifications": [{"rule": "AXIS_RULE", "action": "follow", "reason": "机位保持在关系轴A侧并沿光轴后退，银幕方向不变，米迦尔始终面朝画面左，不越轴。"}, {"rule": "INTENT_PACK", "action": "follow", "reason": "收束意图：固定机位配合缓慢拉远，把主体留在原地并重新放回环境，属于收束段的常规处理。"}, {"rule": "SHOT_PATTERN", "action": "follow", "reason": "MLS 配 50mm、电影化头部空间，符合本镜的景别与镜头规格。"}, {"rule": "STAGING_PACK", "action": "follow", "reason": "低机位、画面平衡构图，主体落在右三分，留出画面左侧的离去方向空间。"}]}, {"shot_id": "shot_057", "order": 9, "intent": "收束：米迦尔转身离开", "shot_type": "LS", "duration_frames": 72, "characters": ["米迦尔"], "dialogue_ids": [], "actions": [{"character_id": "米迦尔", "action_type": "turn_body", "start_frame": 1, "end_frame": 12, "params": {"angle_deg": 150}}, {"character_id": "米迦尔", "action_type": "walk_to", "start_frame": 13, "end_frame": 60, "target_position": [8.2, -7.6, 4.4], "params": {"speed": "walk", "from": [7.1, -6.5, 4.5], "to": [8.2, -7.6, 4.4], "bob": 0.03}}], "dialogues": [], "prompt": "全景，码头市场午后。米迦尔站在摊位长桌与市场棚架之间的空地上，先面朝画面左侧停顿一拍，随后转身向画面右后方走去，穿过往来人群，朝码头海面与远处船桅的方向离开。相机在米迦尔侧后方以 50mm 拍摄，随他离场缓慢后拉，人物在画面中逐渐变小，最终停驻在画面左侧三分之一，右侧留出空荡的码头纵深，构成收束与留白。", "camera": {"side": "back_right", "lens": 50}, "axis_note": "米迦尔离场方向为画面右后，与伊恩离场的画面左后形成对称，未越轴。", "continuity_in": "景别再放宽至全景，米迦尔由面朝画面左转为向画面右后移动。", "gaze": [{"from": "米迦尔", "to": "码头海面与远处船桅"}], "vfx": [], "declared_duration_frames": 0, "declared_shot_number": 57, "declared_camera_move": "static", "intent_type": "收束", "dialogue_pins": [], "beats": [{"t": 0.0, "subject": "米迦尔", "verb": "turn_body", "target": "码头海面与远处船桅", "face_to": "screen_right", "pace": "normal"}, {"t": 0.15, "subject": "米迦尔", "verb": "walk_to", "target": "码头海面与远处船桅", "face_to": "screen_right", "pace": "normal"}, {"t": 0.75, "subject": "米迦尔", "verb": "exit_frame", "target": "码头海面与远处船桅", "face_to": "away", "pace": "normal"}], "composition": {"rule": "lead_room", "subject_position": "left_third"}, "rule_justifications": [{"rule": "AXIS_RULE", "action": "follow", "reason": "米迦尔离场方向为画面右后，与伊恩离场的画面左后形成对称，机位保持在同一侧，未越轴。"}, {"rule": "INTENT_PACK", "action": "follow", "reason": "收束意图下采用 LS 全景配合 dolly_out 后拉，让人物在空间中缩小、留出码头纵深，完成告别段落的收束。"}]}, {"shot_id": "shot_058", "order": 10, "intent": "收束：两人的影子还在", "shot_type": "MS", "duration_frames": 96, "characters": ["米迦尔", "伊恩"], "dialogue_ids": ["d_058"], "actions": [], "dialogues": [], "prompt": "中景，码头市场摊位长桌旁的地面。画面中无人，只有米迦尔与伊恩刚刚离开后留在地面上的两道影子，斜长地铺在木板上，一深一浅，边缘被午后的硬光切得干净。背景是市场棚架与货筐的立柱根部、长桌的桌腿，远处码头海面与船桅在景深外虚化。风把棚布吹得轻晃，影子随之微微颤动。固定机位，平视，50mm，浅景深。整体安静、空落，像是把刚才的对话留在原地。", "camera": {"side": "front_left", "lens": 50}, "axis_note": "空镜，无人物朝向，轴线延续上一镜的机位侧。", "continuity_in": "由全景切回中景，画面中无人，仅保留两人留下的影子。", "gaze": [{"from": "米迦尔", "to": "伊恩"}, {"from": "伊恩", "to": "米迦尔"}], "vfx": [], "declared_duration_frames": 0, "declared_shot_number": 58, "declared_camera_move": "static", "intent_type": "留白", "dialogue_pins": [], "beats": [{"t": 0.0, "subject": "米迦尔", "verb": "turn_head", "target": "码头海面与远处船桅", "face_to": "away", "pace": "slow"}, {"t": 0.5, "subject": "伊恩", "verb": "turn_head", "target": "码头海面与远处船桅", "face_to": "away", "pace": "slow"}], "composition": {"rule": "lead_room", "subject_position": "left_third"}, "rule_justifications": [{"rule": "AXIS_RULE", "action": "follow", "reason": "本镜为无人物空镜，仅保留两人影子的相对位置，机位延续上一镜的轴线侧，不产生越轴。"}, {"rule": "INTENT_PACK", "action": "follow", "reason": "收束意图以 MS 固定机位呈现，符合 intent=收束/留白 与 shot_size=MS、movement=固定 的打包要求。"}, {"rule": "STAGING_PACK", "action": "follow", "reason": "MS 景别配合 lead_room 构图，平视机位，影子置于左三分，右侧留出空落的棚架与海面，供视线延伸。"}, {"rule": "cine_static_contrast", "action": "follow", "reason": "以固定镜头收尾，为前段运动留出静止参照，把「事情已经结束」的读法交给观众。"}]}, {"shot_id": "shot_059", "order": 11, "intent": "收束：伊恩在船头回望", "shot_type": "MCU", "duration_frames": 72, "characters": ["伊恩"], "dialogue_ids": ["d_059"], "actions": [], "dialogues": [], "prompt": "中近景，伊恩站在船头，侧身回望画面右，船身与海面在身后延展。", "camera": {}, "axis_note": "关系轴B侧，伊恩回望画面右，与米迦尔所在方位一致。", "continuity_in": "机位切至船头伊恩一侧，伊恩面朝画面右，回望岸上方向。", "gaze": [{"from": "米迦尔", "to": "伊恩"}, {"from": "伊恩", "to": "米迦尔"}], "vfx": [], "declared_duration_frames": 0, "declared_shot_number": 59, "declared_camera_move": "static", "intent_type": "回望", "dialogue_pins": [], "beats": [], "composition": {}, "rule_justifications": []}, {"shot_id": "shot_060", "order": 12, "intent": "收束：米迦尔转身离开", "shot_type": "MCU", "duration_frames": 72, "characters": ["米迦尔"], "dialogue_ids": ["d_060"], "actions": [{"character_id": "米迦尔", "action_type": "turn_body", "start_frame": 1, "end_frame": 18, "params": {"angle_deg": 150, "degrees": 150}}, {"character_id": "米迦尔", "action_type": "walk_to", "start_frame": 19, "end_frame": 60, "target_position": [6.2, -5.4, 4.5], "params": {"speed": "walk", "from": [6.71, -6.31, 4.51], "to": [6.2, -5.4, 4.5], "bob": 0.03}}, {"character_id": "米迦尔", "action_type": "exit_frame", "start_frame": 61, "end_frame": 72, "target_position": [5.9, -4.9, 4.5], "params": {"speed": "walk", "from": [6.2, -5.4, 4.5], "to": [5.9, -4.9, 4.5], "bob": 0.03}}], "dialogues": [], "prompt": "中景特写（MCU，85mm）。机位落在米迦尔背后、关系轴A侧，平视高度。米迦尔由面朝画面左起始，前1/4段完成转身，背向镜头朝画面深处（码头海面与远处船桅方向）走去，越走越远，最后收在摊位长桌与市场棚架之间的通道上。固定机位，不做推拉，让背影在景深里自然缩小；构图用三分法，主体偏右三分，左侧留出市场棚架与往来人群的纵深，海面高光在背景上部。全程无台词，只有脚步与市场环境声，收束在空落的通道与远处船桅上。", "camera": {"side": "back", "lens": 85}, "axis_note": "关系轴A侧，米迦尔背影朝画面深处，未越轴。", "continuity_in": "机位切至米迦尔背后，米迦尔由面朝画面左转为背向镜头。", "gaze": [{"from": "米迦尔", "to": "伊恩"}, {"from": "伊恩", "to": "米迦尔"}], "vfx": [], "declared_duration_frames": 0, "declared_shot_number": 60, "declared_camera_move": "static", "intent_type": "收束", "dialogue_pins": [], "beats": [{"t": 0, "subject": "米迦尔", "verb": "turn_body", "target": "码头海面与远处船桅", "face_to": "away", "pace": "slow"}, {"t": 0.3, "subject": "米迦尔", "verb": "walk_to", "target": "码头海面与远处船桅", "face_to": "away", "pace": "normal"}, {"t": 0.85, "subject": "米迦尔", "verb": "exit_frame", "target": "码头海面与远处船桅", "face_to": "away", "pace": "normal"}], "composition": {"rule": "thirds", "subject_position": "right_third"}, "rule_justifications": [{"rule": "SHOT_PATTERN", "action": "follow", "reason": "本镜按计划为MCU，用85mm固定机位，未使用ECU，头肩留白按cinematic处理。"}, {"rule": "STAGING_PACK", "action": "follow", "reason": "MCU配合平衡构图与平视机位，未采用framing式框景构图。"}, {"rule": "AXIS_RULE", "action": "follow", "reason": "机位保持在关系轴A侧（米迦尔背后），米迦尔背向画面深处离去，未越轴。"}, {"rule": "INTENT_PACK", "action": "break", "reason": "本镜意图为“收束”，规则要求MS。但计划明确指定MCU：收束的落点不在空间规模，而在米迦尔背影的肩线与后颈——用更近的景别承载告别的情绪重量，空间关系已由前序镜头交代，不需再以MS重复。", "precedent": "case_medium-close-up-shot_011"}]}, {"shot_id": "shot_061", "order": 13, "intent": "收束：市场重新热闹", "shot_type": "MS", "duration_frames": 72, "characters": ["米迦尔", "伊恩"], "dialogue_ids": ["d_061"], "actions": [{"character_id": "米迦尔", "action_type": "walk_to", "start_frame": 1, "end_frame": 44, "target_position": [8.2, -5.6, 4.5], "params": {"speed": "walk", "from": [6.71, -6.31, 4.51], "to": [8.2, -5.6, 4.5], "bob": 0.03}}, {"character_id": "米迦尔", "action_type": "turn_head", "start_frame": 46, "end_frame": 56, "params": {"angle_deg": 18}}, {"character_id": "米迦尔", "action_type": "look_at", "start_frame": 58, "end_frame": 68, "params": {"yaw_deg": 22, "pitch_deg": -4}}], "dialogues": [{"character_id": "米迦尔", "text": "我先上船。", "start_frame": 8, "end_frame": 48}], "prompt": "中景，码头市场重新热闹起来。米迦尔在画面右侧，沿关系轴A侧朝画面右缓步移动，穿过摊位长桌与往来人群之间；市场棚架与货筐在前景形成层层遮挡，远处码头海面与远处船桅占据后景，伊恩仅以远处船影代指，不实体出现。35mm固定机位，机位保持在轴A侧不越轴，米迦尔始终在画面右三分之一，行进方向留出右侧空间。午后侧逆光，棚架阴影与海面反光交替掠过，人群在背景中自然流动。", "camera": {"side": "front_left", "lens": 35}, "axis_note": "关系轴A侧，米迦尔朝画面右移动，机位不越轴。", "continuity_in": "景别放宽一档，双人同框但伊恩仅以远处船影代指，米迦尔在画面右。", "gaze": [{"from": "米迦尔", "to": "码头海面与远处船桅"}], "vfx": [], "declared_duration_frames": 0, "declared_shot_number": 61, "declared_camera_move": "static", "intent_type": "收束", "dialogue_pins": [], "beats": [{"t": 0.0, "subject": "米迦尔", "verb": "walk_to", "target": "摊位长桌", "face_to": "screen_right", "pace": "normal"}, {"t": 0.35, "subject": "米迦尔", "verb": "turn_head", "target": "码头海面与远处船桅", "face_to": "screen_right"}, {"t": 0.7, "subject": "米迦尔", "verb": "look_at", "target": "码头海面与远处船桅", "face_to": "screen_right"}], "composition": {"rule": "thirds", "subject_position": "right_third"}, "rule_justifications": [{"rule": "SHOT_PATTERN", "action": "follow"}, {"rule": "AXIS_RULE", "action": "follow"}, {"rule": "INTENT_PACK", "action": "follow"}]}, {"shot_id": "shot_062", "order": 14, "intent": "收束：米迦尔走远", "shot_type": "CU", "duration_frames": 48, "characters": ["米迦尔"], "dialogue_ids": ["d_062"], "actions": [{"character_id": "米迦尔", "action_type": "walk_to", "start_frame": 1, "end_frame": 36, "target_position": [8.4, -5.4, 4.5], "params": {"speed": "walk", "from": [6.71, -6.31, 4.51], "to": [8.4, -5.4, 4.5], "bob": 0.02}}, {"character_id": "米迦尔", "action_type": "turn_head", "start_frame": 30, "end_frame": 40, "params": {"angle_deg": 8}}], "dialogues": [], "prompt": "特写镜头，固定机位位于关系轴A侧、米迦尔前方偏右，50mm镜头。米迦尔面部朝画面右，视线与离场方向一致，位于画面左三分之一、右侧留出前行的空间。他在午后码头市场的人群间缓慢向右走远，步伐不急，临近结尾时头部微微转向海面与远处船桅的方向。相机随之极缓拉远，光线为午后顶侧自然光，背景摊位长桌与货筐虚化，情绪收束、克制。", "camera": {"side": "front_right", "lens": 50}, "axis_note": "关系轴A侧，视线朝画面右，机位保持同侧。", "continuity_in": "景别跳至特写，米迦尔面部朝画面右，视线方向与离场方向一致。", "gaze": [{"from": "米迦尔", "to": "伊恩"}, {"from": "伊恩", "to": "米迦尔"}], "vfx": [], "declared_duration_frames": 0, "declared_shot_number": 62, "declared_camera_move": "static", "intent_type": "收束", "dialogue_pins": [], "beats": [{"t": 0.0, "subject": "米迦尔", "verb": "walk_to", "target": "码头海面与远处船桅", "face_to": "screen_right", "pace": "slow"}, {"t": 0.62, "subject": "米迦尔", "verb": "turn_head", "target": "码头海面与远处船桅", "face_to": "screen_right"}], "composition": {"rule": "lead_room", "subject_position": "left_third"}, "rule_justifications": [{"rule": "AXIS_RULE", "action": "follow", "reason": "关系轴保持A侧，米迦尔视线朝画面右，机位不越轴，离场方向与视线方向一致。"}, {"rule": "INTENT_PACK:intent:收束", "action": "follow", "reason": "收束镜以固定机位让米迦尔走出画面，情绪落点停在离场动作上。"}, {"rule": "comp_framing", "action": "follow", "reason": "特写景别下米迦尔面部占画面主体，占比与CU声明一致。"}, {"rule": "SHOT_PATTERN", "action": "break", "reason": "该模式要求MS+50mm+zoom_in且禁用CU，但本镜叙事需要以特写收束米迦尔的离场，景别更紧才能读出他不再回头的决绝，故破例采用CU与缓慢拉远。", "precedent": "case_rules-of-shot-composition-in-film_044"}]}, {"shot_id": "shot_063", "order": 15, "intent": "收束：伊恩望向远方", "shot_type": "MLS", "duration_frames": 48, "characters": ["伊恩"], "dialogue_ids": ["d_063"], "actions": [{"character_id": "伊恩", "action_type": "look_at", "start_frame": 1, "end_frame": 20, "params": {"yaw_deg": -35, "pitch_deg": -4}}, {"character_id": "伊恩", "action_type": "turn_head", "start_frame": 20, "end_frame": 30, "params": {"angle_deg": -12}}, {"character_id": "伊恩", "action_type": "body_tilt", "start_frame": 30, "end_frame": 40, "params": {"angle_deg": 3, "axis": "y"}}], "dialogues": [], "prompt": "MLS 中远景，50mm 平视，机位在伊恩背后偏右（关系轴B侧），伊恩背向镜头站在码头市场边缘，身形落在画面右三分，视线朝画面左望向码头海面与远处船桅，左侧留出大片海面空间。摊位长桌、市场棚架与货筐在背景深处虚化，往来人群远景穿行。伊恩头部缓慢微转向左，肩背随之极轻地前倾，镜头以极缓速度后拉，把人物一点点交还给码头与海面，情绪收束、克制、不动的余韵。", "camera": {"side": "back", "lens": 50}, "axis_note": "关系轴B侧，伊恩视线朝画面左，与岸上方向对应，未越轴。", "continuity_in": "景别放宽两档，伊恩背向镜头，视线朝画面左。", "gaze": [{"from": "伊恩", "to": "码头海面与远处船桅"}], "vfx": [], "declared_duration_frames": 0, "declared_shot_number": 63, "declared_camera_move": "static", "intent_type": "回望", "dialogue_pins": [], "beats": [{"t": 0.0, "subject": "伊恩", "verb": "look_at", "target": "码头海面与远处船桅", "face_to": "screen_left", "pace": "slow"}, {"t": 0.35, "subject": "伊恩", "verb": "turn_head", "target": "码头海面与远处船桅", "face_to": "screen_left", "pace": "slow"}, {"t": 0.75, "subject": "伊恩", "verb": "body_tilt", "target": "码头海面与远处船桅", "face_to": "screen_left", "pace": "slow"}], "composition": {"rule": "lead_room", "subject_position": "right_third"}, "rule_justifications": [{"rule": "AXIS_RULE", "action": "follow", "reason": "伊恩视线朝画面左，与岸上方向一致，机位保持关系轴B侧，未越轴。"}, {"rule": "SHOT_PATTERN", "action": "follow", "reason": "MLS 中远景配 50mm 标准镜头，头顶留白克制，符合收束镜头的克制观察感。"}, {"rule": "STAGING_PACK", "action": "follow", "reason": "采用平视机位与平衡构图，避免低机位仰拍带来的仪式感，保持告别的平静。"}, {"rule": "INTENT_PACK", "action": "break", "reason": "经验建议回望用 CU 固定，但本镜是段落收束，需要保留伊恩与码头海面的空间关系，故放宽到 MLS 并做缓慢后拉，让远去的距离感成为叙事语言。", "precedent": "case_blocking-and-staging-scenes_025"}]}, {"shot_id": "shot_064", "order": 16, "intent": "收束：空镜头淡出", "shot_type": "LS", "duration_frames": 72, "characters": ["米迦尔", "伊恩"], "dialogue_ids": ["d_064"], "actions": [], "dialogues": [{"character_id": "米迦尔", "speaker_raw": "米迦尔", "speaker_status": "resolved", "text": "我先上船。", "start_frame": 1, "end_frame": 39}, {"character_id": "伊恩", "speaker_raw": "伊恩", "speaker_status": "resolved", "text": "等等我。", "start_frame": 0, "end_frame": 0}, {"character_id": "米迦尔", "speaker_raw": "米迦尔", "speaker_status": "resolved", "text": "别拖了。", "start_frame": 0, "end_frame": 0}, {"character_id": "伊恩", "speaker_raw": "伊恩", "speaker_status": "resolved", "text": "这一次我听你的。", "start_frame": 0, "end_frame": 0}, {"character_id": "米迦尔", "speaker_raw": "米迦尔", "speaker_status": "resolved", "text": "走吧。", "start_frame": 0, "end_frame": 0}, {"character_id": "伊恩", "speaker_raw": "伊恩", "speaker_status": "resolved", "text": "照顾好自己。", "start_frame": 0, "end_frame": 0}, {"character_id": "米迦尔", "speaker_raw": "米迦尔", "speaker_status": "resolved", "text": "你也是。", "start_frame": 0, "end_frame": 0}, {"character_id": "伊恩", "speaker_raw": "伊恩", "speaker_status": "resolved", "text": "再见。", "start_frame": 0, "end_frame": 0}, {"character_id": "米迦尔", "speaker_raw": "米迦尔", "speaker_status": "resolved", "text": "再见。", "start_frame": 0, "end_frame": 0}, {"character_id": "伊恩", "speaker_raw": "伊恩", "speaker_status": "resolved", "text": "船要开了。", "start_frame": 0, "end_frame": 0}], "prompt": "全景空镜，第十四街区码头市场的午后。镜头位于码头同侧、平视略低，50mm。画面右侧三分之一留出大片海面与远处船桅作为呼吸空间，左侧是市场棚架与货筐的剪影、摊位长桌的边缘。米迦尔与伊恩已走远，仅以极小的背影从画面右后方缓缓移出画框，不承担叙事重心；往来人群稀疏，只剩码头木质栈桥、系缆桩与海面反光。镜头以极缓速度后拉约 1.2 米并轻微拉长焦距（zoom_out 约 20mm），让空间逐渐变空、变远，人物彻底消失后画面只剩码头与海面。光线为午后偏暖的侧逆光，海面有细碎高光，空气中有轻微水汽。全镜头基调静止克制，作为收束与淡出的空镜，运动幅度压到最小；结尾留出余量，画面渐空、渐静，为淡出做准备。", "camera": {"side": "front_right", "lens": 50}, "axis_note": "空镜收尾，无人物朝向，机位延续同侧，轴线不破。", "continuity_in": "由中远景放宽至全景，人物已远离，仅余码头与海面的空景。", "gaze": [{"from": "米迦尔", "to": "伊恩"}, {"from": "伊恩", "to": "米迦尔"}], "vfx": [], "declared_duration_frames": 0, "declared_shot_number": 64, "declared_camera_move": "static", "intent_type": "留白", "dialogue_pins": [{"shot_number": 64, "speaker_raw": "米迦尔", "speaker_status": "resolved", "declared_s": null, "model_text": "", "applied_s": null}, {"shot_number": 64, "speaker_raw": "伊恩", "speaker_status": "resolved", "declared_s": null, "model_text": "", "applied_s": null}, {"shot_number": 64, "speaker_raw": "米迦尔", "speaker_status": "resolved", "declared_s": null, "model_text": "", "applied_s": null}, {"shot_number": 64, "speaker_raw": "伊恩", "speaker_status": "resolved", "declared_s": null, "model_text": "", "applied_s": null}, {"shot_number": 64, "speaker_raw": "米迦尔", "speaker_status": "resolved", "declared_s": null, "model_text": "", "applied_s": null}, {"shot_number": 64, "speaker_raw": "伊恩", "speaker_status": "resolved", "declared_s": null, "model_text": "", "applied_s": null}, {"shot_number": 64, "speaker_raw": "米迦尔", "speaker_status": "resolved", "declared_s": null, "model_text": "", "applied_s": null}, {"shot_number": 64, "speaker_raw": "伊恩", "speaker_status": "resolved", "declared_s": null, "model_text": "", "applied_s": null}, {"shot_number": 64, "speaker_raw": "米迦尔", "speaker_status": "resolved", "declared_s": null, "model_text": "", "applied_s": null}, {"shot_number": 64, "speaker_raw": "伊恩", "speaker_status": "resolved", "declared_s": null, "model_text": "", "applied_s": null}], "beats": [{"t": 0.0, "subject": "米迦尔", "verb": "exit_frame", "target": "码头海面与远处船桅", "face_to": "away", "pace": "slow"}, {"t": 0.1, "subject": "伊恩", "verb": "exit_frame", "target": "码头海面与远处船桅", "face_to": "away", "pace": "slow"}], "composition": {"rule": "lead_room", "subject_position": "right_third"}, "rule_justifications": [{"rule": "AXIS_RULE", "action": "follow", "reason": "空镜收尾无人物朝向，机位延续同侧，轴线不破。"}, {"rule": "INTENT_PACK", "action": "follow", "reason": "收束留白：固定基调的远景空镜，仅以极缓后拉与微变焦让画面呼吸，不做叙事性运动。"}, {"rule": "STAGING_PACK", "action": "follow", "reason": "LS 全景采用 lead_room，码头与海面留在画面右侧的呼吸空间，人物已远去。"}, {"rule": "comp_headroom", "action": "follow", "reason": "空镜中远处船桅与天际线保留约 8% 的头顶留白，避免画面下坠。"}, {"rule": "cine_static_contrast", "action": "follow", "reason": "本镜作为全片最后的静止参照系，运动幅度压到最小，把「结束」留给静止。"}]}], "environment": {"anchors": [{"name": "摊位长桌", "depth": "mid", "relation": "位于米迦尔与伊恩之间，两人隔桌相对"}, {"name": "市场棚架与货筐", "depth": "bg", "relation": "在两人身后纵深排列，构成市场背景"}, {"name": "码头海面与远处船桅", "depth": "bg", "relation": "位于市场一侧远端，提供空间纵深与光线来源"}, {"name": "往来人群", "depth": "fg", "relation": "在画面前景两侧掠过，形成遮挡与市集密度"}], "light": {"time_of_day": "day", "mood": "neutral", "key_direction": "side"}}}, "retrieval_calls": 68, "knowledge_trace": "docs\\evidence\\20261007-v15-long\\knowledge_trace.json"}Blender 5.2.0 LTS (hash fbe6228777e7 built 2026-07-14 01:35:40)

