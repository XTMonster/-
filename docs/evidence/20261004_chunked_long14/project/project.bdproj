    "beats": [
      {
        "id": "beat_1",
        "summary": "市场静场，米迦尔与伊恩隔着摊位说话，米迦尔侧身看向摊位，伊恩回应后两人对立，伊恩沉默，米迦尔转身。",
        "participants": [
          "米迦尔",
          "伊恩"
        ],
        "emotion": "沉默",
        "function": "建立"
      },
      {
        "id": "beat_2",
        "summary": "米迦尔请战，伊恩拒绝，米迦尔坚持，伊恩让步，两人达成一致，米迦尔点头，伊恩转身，米迦尔留在原地。",
        "participants": [
          "米迦尔",
          "伊恩"
        ],
        "emotion": "坚持",
        "function": "铺垫"
      },
      {
        "id": "beat_3",
        "summary": "两人走到码头停下，伊恩望向海面，米迦尔开口，两人对峙，伊恩反驳，米迦尔沉默，海风吹过。",
        "participants": [
          "米迦尔",
          "伊恩"
        ],
        "emotion": "对峙",
        "function": "转折"
      },
      {
        "id": "beat_4",
        "summary": "米迦尔走进巷口，两人一前一后，伊恩停下脚步，米迦尔回头，两人对视，伊恩低声说话，米迦尔垂眼，两人并肩而立。",
        "participants": [
          "米迦尔",
          "伊恩"
        ],
        "emotion": "对视",
        "function": "转折"
      },
      {
        "id": "beat_5",
        "summary": "两人进仓库清点货物，伊恩递过账本，米迦尔翻看，两人争执，伊恩提高音量，米迦尔合上账本，仓库门外透光。",
        "participants": [
          "米迦尔",
          "伊恩"
        ],
        "emotion": "争执",
        "function": "转折"
      },
      {
        "id": "beat_6",
        "summary": "夜色码头，两人坐在石阶上，伊恩说起往事，米迦尔听着，两人沉默，伊恩抬头看星，米迦尔微笑，远处灯塔亮着。",
        "participants": [
          "米迦尔",
          "伊恩"
        ],
        "emotion": "沉默",
        "function": "铺垫"
      },
      {
        "id": "beat_7",
        "summary": "清晨码头，两人站在船边，伊恩递出包裹，米迦尔接过，两人握手，伊恩转身走向船，米迦尔目送，船离岸。",
        "participants": [
          "米迦尔",
          "伊恩"
        ],
        "emotion": "告别",
        "function": "收束"
      },
      {
        "id": "beat_8",
        "summary": "码头恢复平静，两人的影子还在，伊恩在船头回望，米迦尔转身离开，市场重新热闹，米迦尔走远，伊恩望向远方，空镜淡出。",
        "participants": [
          "米迦尔",
          "伊恩"
        ],
        "emotion": "平静",
        "function": "收束"
      }
